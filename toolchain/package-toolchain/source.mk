# PTC_COMPONENT is GCC or BINUTILS. Run after loading default source metadata.

ifneq ($(strip $(PTC_$(PTC_COMPONENT)_SOURCE_URL)),)
  PKG_SOURCE_URL := $(PTC_$(PTC_COMPONENT)_SOURCE_URL)
  PKG_SOURCE_PROTO := $(PTC_$(PTC_COMPONENT)_SOURCE_PROTO)
  PKG_SOURCE_VERSION := $(PTC_$(PTC_COMPONENT)_SOURCE_VERSION)
  PKG_SOURCE_DATE := $(PTC_$(PTC_COMPONENT)_SOURCE_DATE)
  PKG_HASH := $(PTC_$(PTC_COMPONENT)_HASH)
  PKG_MIRROR_HASH := $(PTC_$(PTC_COMPONENT)_MIRROR_HASH)
  ifneq ($(strip $(PKG_SOURCE_PROTO)),)
    # Keep source/build directories package-like. Cache archives per declared
    # ref; encode slash-containing branches without creating subdirectories.
    PKG_SOURCE_SUBDIR := $(PKG_NAME)-$(PKG_VERSION)
    _ptc_source_ref := $(subst /,_2F,$(subst _,_5F,$(PKG_SOURCE_VERSION)))
    # The protocol component avoids reusing archives generated by the previous
    # patch, which had a different extracted top-level directory.
    _ptc_source_id := $(shell printf '%s' '$(subst ','\'',$(PKG_SOURCE_URL))' | $(MKHASH) md5)
    PKG_SOURCE := $(PKG_SOURCE_SUBDIR)-$(PKG_SOURCE_PROTO)-$(_ptc_source_ref)-$(_ptc_source_id).tar.zst
  endif
endif
ifneq ($(strip $(PTC_$(PTC_COMPONENT)_SOURCE_SUBDIR)),)
  PKG_SOURCE_SUBDIR := $(PTC_$(PTC_COMPONENT)_SOURCE_SUBDIR)
endif
ifneq ($(strip $(PTC_$(PTC_COMPONENT)_SOURCE)),)
  PKG_SOURCE := $(PTC_$(PTC_COMPONENT)_SOURCE)
endif
# An unknown release needs its own verified source descriptor.
ifeq ($(strip $(PKG_HASH)$(PKG_SOURCE_VERSION)),)
  $(error No source hash for package toolchain $(PKG_NAME) $(PKG_VERSION); specify a custom source and hash)
endif
# No vendor or Linux-target patches are implicitly added to a bare-metal GCC.
PATCH_DIR := $(PTC_$(PTC_COMPONENT)_PATCH_DIR)

HOST_BUILD_DIR := $(BUILD_DIR_TOOLCHAIN)/$(if $(PKG_SOURCE_SUBDIR),$(PKG_SOURCE_SUBDIR),$(PKG_NAME)-$(PKG_VERSION))
