+;; Experimental EN7523 operations, hardware characterized on hart 0.
+;; Local names, not an official vendor ISA specification.
+;; SPDX-License-Identifier: GPL-3.0-or-later
+
+(define_code_iterator EN_COUNT [clz ctz])
+(define_code_attr en_count [(clz "clz") (ctz "ctz")])
+(define_insn "en7523_<en_count>si2"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (EN_COUNT:SI (match_operand:SI 1 "register_operand" "r")))]
+  "TARGET_XEN7523OPS"
+  "en7523.<en_count>\t%0,%1"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_code_iterator EN_MINMAX [smin smax])
+(define_code_attr en_minmax [(smin "min.s") (smax "max.s")])
+(define_insn "en7523_<code>si3"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (EN_MINMAX:SI (match_operand:SI 1 "register_operand" "r")
+                     (match_operand:SI 2 "register_operand" "r")))]
+  "TARGET_XEN7523OPS"
+  "en7523.<en_minmax>\t%0,%1,%2"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_addshsi3"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (plus:SI (ashift:SI (match_operand:SI 1 "register_operand" "r")
+                           (match_operand 2 "const_int_operand" "n"))
+                 (match_operand:SI 3 "register_operand" "r")))]
+  "TARGET_XEN7523OPS && IN_RANGE (INTVAL (operands[2]), 1, 2)"
+  { return INTVAL (operands[2]) == 1
+      ? "en7523.addsh1\t%0,%3,%1" : "en7523.addsh2\t%0,%3,%1"; }
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_extusi"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (zero_extract:SI (match_operand:SI 1 "register_operand" "r")
+                         (match_operand 2 "const_int_operand" "n")
+                         (match_operand 3 "const_int_operand" "n")))]
+  "TARGET_XEN7523OPS && IN_RANGE (INTVAL (operands[2]), 1, 31)
+   && IN_RANGE (INTVAL (operands[3]), 0, 31)
+   && INTVAL (operands[2]) + INTVAL (operands[3]) <= 32"
+  "en7523.extu\t%0,%1,%3,%2"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_extssi"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (sign_extract:SI (match_operand:SI 1 "register_operand" "r")
+                         (match_operand 2 "const_int_operand" "n")
+                         (match_operand 3 "const_int_operand" "n")))]
+  "TARGET_XEN7523OPS && IN_RANGE (INTVAL (operands[2]), 1, 31)
+   && IN_RANGE (INTVAL (operands[3]), 0, 31)
+   && INTVAL (operands[2]) + INTVAL (operands[3]) <= 32"
+  "en7523.exts\t%0,%1,%3,%2"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_inssi"
+  [(set (zero_extract:SI (match_operand:SI 0 "register_operand" "+r")
+                        (match_operand 1 "const_int_operand" "n")
+                        (match_operand 2 "const_int_operand" "n"))
+        (match_operand:SI 3 "register_operand" "r"))]
+  "TARGET_XEN7523OPS && IN_RANGE (INTVAL (operands[1]), 1, 31)
+   && IN_RANGE (INTVAL (operands[2]), 0, 31)
+   && INTVAL (operands[1]) + INTVAL (operands[2]) <= 32"
+  "en7523.ins\t%0,%3,%2,%1"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_bclrisi"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (and:SI (match_operand:SI 1 "register_operand" "r")
+                (match_operand:SI 2 "not_single_bit_mask_operand" "DnS")))]
+  "TARGET_XEN7523OPS"
+  "en7523.bclri\t%0,%1,%T2"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_bsetisi"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (ior:SI (match_operand:SI 1 "register_operand" "r")
+                (match_operand:SI 2 "single_bit_mask_operand" "n")))]
+  "TARGET_XEN7523OPS"
+  "en7523.bseti\t%0,%1,%S2"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_binvisi"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (xor:SI (match_operand:SI 1 "register_operand" "r")
+                (match_operand:SI 2 "single_bit_mask_operand" "n")))]
+  "TARGET_XEN7523OPS"
+  "en7523.binvi\t%0,%1,%S2"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_btstisi"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (and:SI (match_operand:SI 1 "register_operand" "r")
+                (match_operand:SI 2 "single_bit_mask_operand" "n")))]
+  "TARGET_XEN7523OPS"
+  "en7523.btsti\t%0,%1,%S2"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_bsetsi"
+  [(set (match_operand:SI 0 "register_operand" "=r")
+        (ior:SI (ashift:SI (const_int 1)
+                          (match_operand:QI 2 "register_operand" "r"))
+                (match_operand:SI 1 "register_operand" "r")))]
+  "TARGET_XEN7523OPS"
+  "en7523.bset\t%0,%1,%2"
+  [(set_attr "type" "bitmanip") (set_attr "mode" "SI")])
+
+(define_insn "en7523_cbranchsi"
+  [(set (pc)
+        (if_then_else
+          (match_operator 1 "en7523_branch_operator"
+            [(match_operand:SI 2 "register_operand" "r")
+             (match_operand:SI 3 "const_int_operand" "n")])
+          (label_ref (match_operand 0 "" "")) (pc)))]
+  "TARGET_XEN7523OPS
+   && ((GET_CODE (operands[1]) == LTU || GET_CODE (operands[1]) == GEU)
+       ? IN_RANGE (INTVAL (operands[3]), 0, 31)
+       : IN_RANGE (INTVAL (operands[3]), -16, 15))"
+{
+  if (get_attr_length (insn) == 12)
+    return "en7523.b%N1i\t%2,%3,1f; jump\t%l0,ra; 1:";
+  if (get_attr_length (insn) == 8)
+    return "en7523.b%N1i\t%2,%3,1f; j\t%l0; 1:";
+  return "en7523.b%C1i\t%2,%3,%l0";
+}
+  [(set_attr "type" "branch") (set_attr "mode" "none")])
