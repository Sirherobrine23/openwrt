From 797b3a06a5975612be680f97049aff527618049e Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sun, 25 Oct 2026 23:41:29 -0300
Subject: [PATCH] PCI: mediatek: add AN7552 and AN7563 host and PHY
 initialization

The SDK's host_7552 controller uses the MediaTek v2 configuration TLP
registers, but each port is an independent host exposing device zero.
Keep the PCI domain as the physical resource index without using it as
the root port's device number.

Resolve the PHY and PBUS supplier during port parsing so deferred probes
are propagated. Program the PBUS base/mask, RC mode, the inbound window
and the SDK's MMIO coherence workaround before scanning the host. Size
the outbound window with log2(bytes), matching the SDK post-scan fixup;
fls(bytes) would incorrectly double a power-of-two window.

Reuse the SCU clock's reset sequence and initialize the shared PHY before
clock preparation releases PERST. Apply the six analog register writes
from host_7552/pcie-ecnt-phy.c, including its RX jitter tolerance update,
without running EN7523's crystal-dependent PLL or power-saving setup.
Keep the existing EN7523 host path and PHY sequence unchanged.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/pci/controller/Kconfig         |   1 +
 drivers/pci/controller/pcie-mediatek.c | 123 +++++++++++++++++++++++++++++++++
 drivers/phy/airoha/Kconfig             |   4 +-
 drivers/phy/airoha/phy-airoha-pcie.c   |  52 +++++++++++---
 4 files changed, 170 insertions(+), 10 deletions(-)

diff --git a/drivers/pci/controller/Kconfig b/drivers/pci/controller/Kconfig
--- a/drivers/pci/controller/Kconfig
+++ b/drivers/pci/controller/Kconfig
@@ -197,6 +197,7 @@ config PCIE_MEDIATEK
 	depends on OF
 	depends on PCI_MSI
 	select IRQ_MSI_LIB
+	select MFD_SYSCON
 	help
 	  Say Y here if you want to enable PCIe controller support on
 	  MediaTek SoCs.
diff --git a/drivers/pci/controller/pcie-mediatek.c b/drivers/pci/controller/pcie-mediatek.c
--- a/drivers/pci/controller/pcie-mediatek.c
+++ b/drivers/pci/controller/pcie-mediatek.c
@@ -103,6 +103,9 @@
 #define AHB2PCIE_SIZE(x)	((x) & GENMASK(4, 0))
 #define PCIE_AXI_WINDOW0	0x448
 #define WIN_ENABLE		BIT(7)
+#define PCIE_MMIO_CTRL		0x564
+#define AN7552_MMIO_COHERENCE_FIX	BIT(0)
+#define AN7552_HOST_MODE		0x00804201
 /*
  * Define PCIe to AHB window size as 2^33 to support max 8GB address space
  * translate, support least 4GB DRAM size access from EP DMA(physical DRAM
@@ -160,6 +163,7 @@ struct mtk_pcie_port;
  * @MTK_PCIE_PHY_BEFORE_SYS_CK: Initialize the port PHY before sys_ck
  * @MTK_PCIE_RETRAIN: Retrain link to bridge after startup because some
  *                    Gen2-capable devices start as Gen1.
+ * @MTK_PCIE_INDEPENDENT_PORT: Each host has one root port at device zero
  */
 enum mtk_pcie_quirks {
 	MTK_PCIE_FIX_CLASS_ID = BIT(0),
@@ -168,6 +172,7 @@ enum mtk_pcie_quirks {
 	MTK_PCIE_SKIP_RSTB = BIT(3),
 	MTK_PCIE_RETRAIN = BIT(4),
 	MTK_PCIE_PHY_BEFORE_SYS_CK = BIT(5),
+	MTK_PCIE_INDEPENDENT_PORT = BIT(6),
 };
 
 /**
@@ -176,6 +181,7 @@ enum mtk_pcie_quirks {
  * @ops: pointer to configuration access functions
  * @startup: pointer to controller setting functions
  * @setup_irq: pointer to initialize IRQ functions
+ * @parse_port: optional per-port resource parsing callback
  * @quirks: PCIe device quirks.
  */
 struct mtk_pcie_soc {
@@ -183,6 +189,7 @@ struct mtk_pcie_soc {
 	struct pci_ops *ops;
 	int (*startup)(struct mtk_pcie_port *port);
 	int (*setup_irq)(struct mtk_pcie_port *port, struct device_node *node);
+	int (*parse_port)(struct mtk_pcie_port *port);
 	enum mtk_pcie_quirks quirks;
 };
 
@@ -202,6 +209,8 @@ struct mtk_pcie_soc {
  * @obff_ck: pointer to OBFF functional block operating clock
  * @pipe_ck: pointer to LTSSM and PHY/MAC layer operating clock
  * @phy: pointer to PHY control block
+ * @pbus: PBUS address decoder regmap
+ * @pbus_regs: offsets of the PBUS base and mask registers
  * @slot: port slot
  * @irq: GIC irq
  * @irq_domain: legacy INTx IRQ domain
@@ -222,6 +231,8 @@ struct mtk_pcie_port {
 	struct clk *obff_ck;
 	struct clk *pipe_ck;
 	struct phy *phy;
+	struct regmap *pbus;
+	u32 pbus_regs[2];
 	u32 slot;
 	int irq;
 	struct irq_domain *irq_domain;
@@ -367,6 +378,15 @@ static struct mtk_pcie_port *mtk_pcie_find_port(struct pci_bus *bus,
 	struct mtk_pcie_port *port;
 	struct pci_dev *dev = NULL;
 
+	/* Independent hosts use device zero regardless of their PCI domain. */
+	if (pcie->soc->quirks & MTK_PCIE_INDEPENDENT_PORT) {
+		if (pci_is_root_bus(bus) && PCI_SLOT(devfn))
+			return NULL;
+
+		return list_first_entry_or_null(&pcie->ports,
+					       struct mtk_pcie_port, list);
+	}
+
 	/*
 	 * Walk the bus hierarchy to get the devfn value
 	 * of the port in the root bus.
@@ -773,6 +793,93 @@ static int mtk_pcie_startup_port_v2(struct mtk_pcie_port *port)
 	return 0;
 }
 
+static int mtk_pcie_parse_port_an7552(struct mtk_pcie_port *port)
+{
+	struct device *dev = port->pcie->dev;
+
+	if (port->slot > 1 || !port->phy)
+		return dev_err_probe(dev, -EINVAL,
+				     "AN7552 requires domain 0/1 and a PCIe PHY\n");
+
+	/* Resolve suppliers here, so -EPROBE_DEFER reaches the probe caller. */
+	port->pbus = syscon_regmap_lookup_by_phandle_args(dev->of_node,
+						       "mediatek,pbus-csr", 2,
+						       port->pbus_regs);
+	if (IS_ERR(port->pbus))
+		return dev_err_probe(dev, PTR_ERR(port->pbus),
+				     "failed to get PBUS address decoder\n");
+
+	if ((port->pbus_regs[0] | port->pbus_regs[1]) & 3 ||
+	    port->pbus_regs[0] == port->pbus_regs[1])
+		return -EINVAL;
+
+	return 0;
+}
+
+static int mtk_pcie_startup_port_an7552(struct mtk_pcie_port *port)
+{
+	struct mtk_pcie *pcie = port->pcie;
+	struct pci_host_bridge *host = pci_host_bridge_from_priv(pcie);
+	struct resource_entry *entry;
+	struct resource *mem = NULL;
+	u64 size;
+	u32 val;
+	int err;
+
+	/* The hardware has one outbound, identity-mapped memory window. */
+	resource_list_for_each_entry(entry, &host->windows) {
+		if (resource_type(entry->res) == IORESOURCE_BUS)
+			continue;
+		if (resource_type(entry->res) != IORESOURCE_MEM || mem || entry->offset)
+			return dev_err_probe(pcie->dev, -EINVAL,
+					     "unsupported AN7552 PCIe ranges\n");
+		mem = entry->res;
+	}
+	if (!mem)
+		return -EINVAL;
+
+	size = resource_size(mem);
+	if (size < 128 || size > BIT_ULL(31) || !is_power_of_2(size) ||
+	    (mem->start & (size - 1)) || mem->end > U32_MAX)
+		return dev_err_probe(pcie->dev, -EINVAL,
+				     "invalid AN7552 PCIe memory window\n");
+
+	err = regmap_write(port->pbus, port->pbus_regs[0], mem->start);
+	if (err)
+		return err;
+	err = regmap_write(port->pbus, port->pbus_regs[1], ~(u32)(size - 1));
+	if (err)
+		return err;
+
+	/* Clock preparation supplies the shared SCU reset/PERST sequence. */
+	writel(AN7552_HOST_MODE, port->base + PCIE_SYS_CFG_V2);
+	writel(PCIE_CLASS_CODE | PCIE_REVISION_ID,
+	       port->base + PCIE_CONF_REV_CLASS);
+
+	err = readl_poll_timeout(port->base + PCIE_LINK_STATUS_V2, val,
+				val & PCIE_PORT_LINKUP_V2, 20,
+				100 * USEC_PER_MSEC);
+	if (err)
+		return err;
+
+	val = readl(port->base + PCIE_INT_MASK) & ~INTX_MASK;
+	writel(val, port->base + PCIE_INT_MASK);
+	if (IS_ENABLED(CONFIG_PCI_MSI))
+		mtk_pcie_enable_msi(port);
+
+	/* The size field is log2(bytes), as in the SDK's post-scan fixup. */
+	writel(lower_32_bits(mem->start) | AHB2PCIE_SIZE(ilog2(size)),
+	       port->base + PCIE_AHB_TRANS_BASE0_L);
+	writel(0, port->base + PCIE_AHB_TRANS_BASE0_H);
+	writel(WIN_ENABLE, port->base + PCIE_AXI_WINDOW0);
+
+	/* SDK workaround for AN7563 with Kite endpoints. */
+	val = readl(port->base + PCIE_MMIO_CTRL);
+	writel(val | AN7552_MMIO_COHERENCE_FIX, port->base + PCIE_MMIO_CTRL);
+
+	return 0;
+}
+
 static int mtk_pcie_startup_port_en7528(struct mtk_pcie_port *port)
 {
 	struct mtk_pcie *pcie = port->pcie;
@@ -1209,6 +1316,12 @@ static int mtk_pcie_parse_port(struct mtk_pcie *pcie,
 	port->slot = slot;
 	port->pcie = pcie;
 
+	if (pcie->soc->parse_port) {
+		err = pcie->soc->parse_port(port);
+		if (err)
+			return err;
+	}
+
 	if (pcie->soc->setup_irq) {
 		err = pcie->soc->setup_irq(port, node);
 		if (err)
@@ -1477,6 +1590,15 @@ static const struct mtk_pcie_soc mtk_pcie_soc_mt7629 = {
 	.quirks = MTK_PCIE_FIX_CLASS_ID | MTK_PCIE_FIX_DEVICE_ID,
 };
 
+static const struct mtk_pcie_soc mtk_pcie_soc_an7552 = {
+	.ops = &mtk_pcie_ops_v2,
+	.startup = mtk_pcie_startup_port_an7552,
+	.setup_irq = mtk_pcie_setup_irq,
+	.parse_port = mtk_pcie_parse_port_an7552,
+	.quirks = MTK_PCIE_INDEPENDENT_PORT | MTK_PCIE_RETRAIN |
+		  MTK_PCIE_PHY_BEFORE_SYS_CK,
+};
+
 static const struct mtk_pcie_soc mtk_pcie_soc_en7528 = {
 	.ops = &mtk_pcie_ops_v2,
 	.startup = mtk_pcie_startup_port_en7528,
@@ -1499,6 +1621,7 @@ DECLARE_PCI_FIXUP_EARLY(PCI_VENDOR_ID_MEDIATEK,
 			mtk_pcie_en7523_bar_quirk);
 
 static const struct of_device_id mtk_pcie_ids[] = {
+	{ .compatible = "airoha,an7552-pcie", .data = &mtk_pcie_soc_an7552 },
 	{ .compatible = "airoha,an7583-pcie", .data = &mtk_pcie_soc_an7583 },
 	{ .compatible = "econet,en7528-pcie", .data = &mtk_pcie_soc_en7528 },
 	{ .compatible = "mediatek,mt2701-pcie", .data = &mtk_pcie_soc_v1 },
diff --git a/drivers/phy/airoha/Kconfig b/drivers/phy/airoha/Kconfig
--- a/drivers/phy/airoha/Kconfig
+++ b/drivers/phy/airoha/Kconfig
@@ -9,8 +9,8 @@ config PHY_AIROHA_PCIE
 	select GENERIC_PHY
 	help
 	  Say Y here to add support for Airoha PCIe PHY driver.
-	  This driver create the basic PHY instance and provides initialize
-	  callback for PCIe GEN3 port.
+	  This driver initializes the PCIe PHY on EN7523, AN7552/AN7563 and
+	  EN7581 SoCs, including their SoC-specific analog settings.
 
 config PHY_AIROHA_AN7583_PCIE
 	tristate "Airoha AN7583 PCIe-PHY Driver"
diff --git a/drivers/phy/airoha/phy-airoha-pcie.c b/drivers/phy/airoha/phy-airoha-pcie.c
--- a/drivers/phy/airoha/phy-airoha-pcie.c
+++ b/drivers/phy/airoha/phy-airoha-pcie.c
@@ -34,6 +34,7 @@ enum airoha_pcie_port_gen {
  * struct airoha_pcie_phy - PCIe phy driver main structure
  * @dev: pointer to device
  * @phy: pointer to generic phy
+ * @chip_scu: chip system controller used by the EN7523 PHY
  * @pcie0_base: en7523 PCIe0 lane IO mapped register base address
  * @pcie1_base: en7523 PCIe1 lane IO mapped register base address
  * @csr_2l: Analogic lane IO mapped register base address
@@ -1337,6 +1338,24 @@ static int airoha_pcie_phy_en7523_init(struct phy *phy)
 	return 0;
 }
 
+static int airoha_en7523_map_lanes(struct airoha_pcie_phy *pcie_phy,
+				    struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+
+	pcie_phy->pcie0_base = devm_platform_ioremap_resource_byname(pdev, "pcie0");
+	if (IS_ERR(pcie_phy->pcie0_base))
+		return dev_err_probe(dev, PTR_ERR(pcie_phy->pcie0_base),
+				     "Failed to map pcie0 base\n");
+
+	pcie_phy->pcie1_base = devm_platform_ioremap_resource_byname(pdev, "pcie1");
+	if (IS_ERR(pcie_phy->pcie1_base))
+		return dev_err_probe(dev, PTR_ERR(pcie_phy->pcie1_base),
+				     "Failed to map pcie1 base\n");
+
+	return 0;
+}
+
 static int airoha_en7523_probe(struct airoha_pcie_phy *pcie_phy, struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1351,19 +1370,35 @@ static int airoha_en7523_probe(struct airoha_pcie_phy *pcie_phy, struct platform
 	if (!pcie_phy->chip_scu)
 		return dev_err_probe(dev, -ENOMEM, "Failed to map scu base\n");
 
-	pcie_phy->pcie0_base = devm_platform_ioremap_resource_byname(pdev, "pcie0");
-	if (IS_ERR(pcie_phy->pcie0_base))
-		return dev_err_probe(dev, PTR_ERR(pcie_phy->pcie0_base),
-				     "Failed to map pcie0 base\n");
+	return airoha_en7523_map_lanes(pcie_phy, pdev);
+}
 
-	pcie_phy->pcie1_base = devm_platform_ioremap_resource_byname(pdev, "pcie1");
-	if (IS_ERR(pcie_phy->pcie1_base))
-		return dev_err_probe(dev, PTR_ERR(pcie_phy->pcie1_base),
-				     "Failed to map pcie1 base\n");
+static int airoha_pcie_phy_an7552_init(struct phy *phy)
+{
+	struct airoha_pcie_phy *pcie_phy = phy_get_drvdata(phy);
+	void __iomem *lanes[] = { pcie_phy->pcie0_base, pcie_phy->pcie1_base };
+	int i;
+
+	/* AN7552/AN7563 SDK sequence, including the RX jitter tolerance fix. */
+	for (i = 0; i < ARRAY_SIZE(lanes); i++) {
+		writel(0x0c010000, lanes[i] + 0x418);
+		writel(0x60080007, lanes[i] + 0x404);
+		writel(0x04100803, lanes[i] + 0x318);
+	}
 
 	return 0;
 }
 
+static const struct phy_ops airoha_pcie_phy_an7552_ops = {
+	.init = airoha_pcie_phy_an7552_init,
+	.owner = THIS_MODULE,
+};
+
+static const struct airoha_pcie_probe_data airoha_an7552_data = {
+	.ops = &airoha_pcie_phy_an7552_ops,
+	.probe = airoha_en7523_map_lanes,
+};
+
 static const struct phy_ops airoha_pcie_phy_en7523_ops = {
 	.init = airoha_pcie_phy_en7523_init,
 	.owner = THIS_MODULE,
@@ -1412,6 +1447,7 @@ static int airoha_pcie_phy_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id airoha_pcie_phy_of_match[] = {
+	{ .compatible = "airoha,an7552-pcie-phy", .data = &airoha_an7552_data },
 	{ .compatible = "airoha,en7581-pcie-phy", .data = &airoha_an7581_data },
 	{ .compatible = "airoha,en7523-pcie-phy", .data = &airoha_en7523_data },
 	{ /* sentinel */ }

