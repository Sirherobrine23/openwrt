 include/linux/soc/airoha/airoha_offload.h  |  14 +-
 net/netfilter/nf_flow_table_path.c         |   5 +
 11 files changed, 457 insertions(+), 284 deletions(-)

diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -61,17 +61,6 @@ config NET_AIROHA_SOC_WED
 
 	  If unsure, say N.
 
-config NET_AIROHA_WHNAT
-	bool "EcoNet PPE WHNAT"
-	depends on NET_AIROHA
-	depends on SOC_ECONET_EN751221 || SOC_ECONET_EN751627 || SOC_ECONET_EN7528 || COMPILE_TEST
-	select CFG80211_HEADERS
-	help
-	  Let PPE forward NAT flows from and to WiFi netdevs
-	  whose radios have no WED support.
-
-	  If unsure, say N.
-
 config AIROHA_XPON
 	tristate "Airoha xPON MAC driver"
 	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
diff --git a/drivers/net/ethernet/airoha/Makefile b/drivers/net/ethernet/airoha/Makefile
--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -4,10 +4,9 @@
 #
 
 obj-$(CONFIG_NET_AIROHA) += airoha-eth.o
-airoha-eth-y := airoha_eth.o airoha_ppe.o airoha_xpon_service.o
+airoha-eth-y := airoha_eth.o airoha_ppe.o airoha_xpon_service.o airoha_whnat.o
 airoha-eth-$(CONFIG_NET_AIROHA_PPE_DEBUGFS) += airoha_ppe_debugfs.o
