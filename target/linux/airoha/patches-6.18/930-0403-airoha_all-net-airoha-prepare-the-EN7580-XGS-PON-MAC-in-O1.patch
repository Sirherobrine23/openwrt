+	KUNIT_EXPECT_EQ(test, msg.seq_no, 0x05);
+	KUNIT_EXPECT_MEMEQ(test, msg.reboot.sn, t_zero, XGSPON_PLOAM_SN_LEN);
+	KUNIT_EXPECT_EQ(test, msg.reboot.depth, XGSPON_PLOAM_REBOOT_DEPTH_MAX);
