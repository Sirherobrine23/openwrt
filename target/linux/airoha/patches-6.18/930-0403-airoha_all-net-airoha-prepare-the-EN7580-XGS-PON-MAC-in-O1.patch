diff --git a/net/xpon/mode_test.c b/net/xpon/mode_test.c
new file mode 100644
--- /dev/null
+++ b/net/xpon/mode_test.c
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <kunit/test.h>
+#include <linux/device.h>
+#include <linux/etherdevice.h>
+#include <net/xpon.h>
+
+struct xpon_mode_test_ctx {
+	struct device *parent;
+	struct net_device *netdev;
+	struct xpon_device *xpon;
+	int calls;
+	int error;
+	enum xpon_mode requested;
+};
+
+static int xpon_test_set_mode(struct xpon_device *xpon, enum xpon_mode mode)
+{
+	struct xpon_mode_test_ctx *ctx = xpon_device_priv(xpon);
+
+	ctx->calls++;
+	ctx->requested = mode;
+	return ctx->error;
+}
+
+static const struct xpon_device_ops xpon_test_ops = {
+	.set_mode = xpon_test_set_mode,
+};
+
+static int xpon_mode_test_init(struct kunit *test)
+{
+	struct xpon_device_desc desc = {};
+	struct xpon_mode_test_ctx *ctx;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	test->priv = ctx;
+	ctx->parent = root_device_register("xpon-kunit");
+	if (IS_ERR(ctx->parent))
+		return PTR_ERR(ctx->parent);
+	ctx->netdev = alloc_etherdev(0);
+	if (!ctx->netdev) {
+		ret = -ENOMEM;
+		goto unregister_parent;
+	}
+	strscpy(ctx->netdev->name, "xpon-test");
+	desc.netdev = ctx->netdev;
+	desc.modes = XPON_MODE_GPON | XPON_MODE_XGSPON |
+		     XPON_MODE_50GPON | XPON_MODE_50GEPON;
+	desc.mode = XPON_MODE_GPON;
+	desc.ops = &xpon_test_ops;
+	desc.priv = ctx;
+	ctx->xpon = xpon_device_register(ctx->parent, &desc);
+	if (IS_ERR(ctx->xpon)) {
+		ret = PTR_ERR(ctx->xpon);
+		free_netdev(ctx->netdev);
+		goto unregister_parent;
+	}
+	return 0;
+
+unregister_parent:
+	root_device_unregister(ctx->parent);
+	return ret;
+}
+
+static void xpon_mode_test_exit(struct kunit *test)
+{
+	struct xpon_mode_test_ctx *ctx = test->priv;
+
+	xpon_device_unregister(ctx->xpon);
+	free_netdev(ctx->netdev);
+	root_device_unregister(ctx->parent);
+}
+
+static void xpon_mode_high_bits(struct kunit *test)
+{
+	struct xpon_mode_test_ctx *ctx = test->priv;
+	const enum xpon_mode modes[] = {
+		XPON_MODE_XGSPON, XPON_MODE_50GPON, XPON_MODE_50GEPON,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(modes); i++) {
+		KUNIT_ASSERT_EQ(test, xpon_device_set_mode(ctx->xpon, modes[i]), 0);
+		KUNIT_EXPECT_EQ(test, xpon_device_mode(ctx->xpon), modes[i]);
+		KUNIT_EXPECT_EQ(test, ctx->requested, modes[i]);
+	}
+	KUNIT_EXPECT_EQ(test, ctx->calls, (int)ARRAY_SIZE(modes));
+	KUNIT_EXPECT_TRUE(test, !!(xpon_device_modes(ctx->xpon) &
+				  XPON_MODE_50GEPON));
+}
+
+static void xpon_mode_invalid_requests(struct kunit *test)
+{
+	struct xpon_mode_test_ctx *ctx = test->priv;
+	const u32 modes[] = {
+		0, 1, XPON_MODE_GPON | XPON_MODE_XGSPON,
+		XPON_MODE_50GEPON << 1, U32_MAX,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(modes); i++)
+		KUNIT_EXPECT_EQ(test, xpon_device_set_mode(ctx->xpon, modes[i]),
+				-EINVAL);
+	KUNIT_EXPECT_EQ(test, ctx->calls, 0);
+	KUNIT_EXPECT_EQ(test, xpon_device_mode(ctx->xpon), XPON_MODE_GPON);
+}
+
+static void xpon_mode_unsupported(struct kunit *test)
+{
+	struct xpon_mode_test_ctx *ctx = test->priv;
+
+	KUNIT_EXPECT_EQ(test, xpon_device_set_mode(ctx->xpon, XPON_MODE_EPON),
+			-EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, ctx->calls, 0);
+}
+
+static void xpon_mode_backend_failure(struct kunit *test)
+{
+	struct xpon_mode_test_ctx *ctx = test->priv;
+
+	ctx->error = -EIO;
+	KUNIT_EXPECT_EQ(test, xpon_device_set_mode(ctx->xpon, XPON_MODE_XGSPON),
+			-EIO);
+	KUNIT_EXPECT_EQ(test, xpon_device_mode(ctx->xpon), XPON_MODE_GPON);
+	ctx->error = 0;
+	KUNIT_EXPECT_EQ(test, xpon_device_set_mode(ctx->xpon, XPON_MODE_XGSPON), 0);
+	KUNIT_EXPECT_EQ(test, xpon_device_mode(ctx->xpon), XPON_MODE_XGSPON);
+}
+
+static void xpon_mode_running(struct kunit *test)
+{
+	struct xpon_mode_test_ctx *ctx = test->priv;
+
+	set_bit(__LINK_STATE_START, &ctx->netdev->state);
+	KUNIT_EXPECT_EQ(test, xpon_device_set_mode(ctx->xpon, XPON_MODE_XGSPON),
+			-EBUSY);
+	clear_bit(__LINK_STATE_START, &ctx->netdev->state);
+	KUNIT_EXPECT_EQ(test, ctx->calls, 0);
+}
+
+static void xpon_mode_invalid_registration(struct kunit *test)
+{
+	struct xpon_mode_test_ctx *ctx = test->priv;
+	struct xpon_device_desc desc = {
+		.netdev = ctx->netdev,
+		.modes = XPON_MODE_GPON | XPON_MODE_XGSPON,
+	};
+	struct xpon_device *xpon;
+	const u32 modes[] = { 0, 1, XPON_MODE_GPON | XPON_MODE_XGSPON };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(modes); i++) {
+		desc.mode = modes[i];
+		xpon = xpon_device_register(ctx->parent, &desc);
+		if (!IS_ERR(xpon))
+			xpon_device_unregister(xpon);
+		KUNIT_EXPECT_EQ(test, PTR_ERR_OR_ZERO(xpon), -EINVAL);
+	}
+	desc.mode = XPON_MODE_GPON;
+	desc.modes |= BIT(31);
+	xpon = xpon_device_register(ctx->parent, &desc);
+	if (!IS_ERR(xpon))
+		xpon_device_unregister(xpon);
+	KUNIT_EXPECT_EQ(test, PTR_ERR_OR_ZERO(xpon), -EINVAL);
+}
+
+static struct device_attribute *xpon_test_attr(struct device *dev,
+					       const char *name)
+{
+	const struct attribute_group **group;
+	struct attribute **attr;
+
+	for (group = dev->groups; group && *group; group++)
+		for (attr = (*group)->attrs; attr && *attr; attr++)
+			if (!strcmp((*attr)->name, name))
+				return container_of(*attr, struct device_attribute, attr);
+	return NULL;
+}
+
+static void xpon_mode_sysfs(struct kunit *test)
+{
+	struct xpon_mode_test_ctx *ctx = test->priv;
+	struct device *dev = xpon_device_dev(ctx->xpon);
+	struct device_attribute *attr;
+	char *buf;
+	ssize_t ret;
+
+	buf = kunit_kzalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	attr = xpon_test_attr(dev, "mode_available");
+	KUNIT_ASSERT_NOT_NULL(test, attr);
+	ret = attr->show(dev, attr, buf);
+	KUNIT_ASSERT_GT(test, ret, 0);
+	KUNIT_EXPECT_STREQ(test, buf, "gpon xgspon 50gpon 50gepon\n");
+	attr = xpon_test_attr(dev, "mode_current");
+	KUNIT_ASSERT_NOT_NULL(test, attr);
+	KUNIT_ASSERT_EQ(test, attr->store(dev, attr, "50gepon\n", 8), (ssize_t)8);
+	KUNIT_EXPECT_EQ(test, xpon_device_mode(ctx->xpon), XPON_MODE_50GEPON);
+	ret = attr->show(dev, attr, buf);
+	KUNIT_ASSERT_GT(test, ret, 0);
+	KUNIT_EXPECT_STREQ(test, buf, "50gepon\n");
+}
+
+static struct kunit_case xpon_mode_cases[] = {
+	KUNIT_CASE(xpon_mode_high_bits),
+	KUNIT_CASE(xpon_mode_invalid_requests),
+	KUNIT_CASE(xpon_mode_unsupported),
+	KUNIT_CASE(xpon_mode_backend_failure),
+	KUNIT_CASE(xpon_mode_running),
+	KUNIT_CASE(xpon_mode_invalid_registration),
+	KUNIT_CASE(xpon_mode_sysfs),
+	{}
+};
+
+static struct kunit_suite xpon_mode_suite = {
+	.name = "xpon_mode",
+	.init = xpon_mode_test_init,
+	.exit = xpon_mode_test_exit,
+	.test_cases = xpon_mode_cases,
+};
+
+kunit_test_suite(xpon_mode_suite);
+
+MODULE_DESCRIPTION("xPON mode and capability tests");
+MODULE_LICENSE("GPL");
diff --git a/net/xpon/ploam_msg.c b/net/xpon/ploam_msg.c
new file mode 100644
--- /dev/null
+++ b/net/xpon/ploam_msg.c
@@ -0,0 +1,360 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (C) 2026 John Crispin <john@phrozen.org> */
+
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+#include <net/xpon/ploam_msg.h>
+
+/**
+ * gpon_ploam_build() - lay out a GPON body without its BIP-8
+ * @buf: destination for the twelve standard body octets
+ * @len: available space
+ * @msg: header and content to send
+ *
+ * The caller owns FIFO ordering, BIP-8 and protocol policy.
+ *
+ * Return: GPON_PLOAM_BODY_LEN, or -ENOSPC without modifying @buf.
+ */
+int gpon_ploam_build(void *buf, size_t len, const struct gpon_ploam_msg *msg)
+{
+	u8 *body = buf;
+
+	if (len < GPON_PLOAM_BODY_LEN)
+		return -ENOSPC;
+
+	body[0] = msg->onu_id;
+	body[1] = msg->msg_id;
+	memcpy(body + 2, msg->content, GPON_PLOAM_CONTENT_LEN);
+
+	return GPON_PLOAM_BODY_LEN;
+}
+EXPORT_SYMBOL_GPL(gpon_ploam_build);
+
+/**
+ * gpon_ploam_parse() - read a GPON body without its BIP-8
+ * @buf: standard body bytes, after the MAC checked BIP-8
+ * @len: available bytes
+ * @msg: decoded header and content
+ *
+ * Return: 0, or -ENOSPC without modifying @msg.
+ */
+int gpon_ploam_parse(const void *buf, size_t len, struct gpon_ploam_msg *msg)
+{
+	const u8 *body = buf;
+
+	if (len < GPON_PLOAM_BODY_LEN)
+		return -ENOSPC;
+
+	msg->onu_id = body[0];
+	msg->msg_id = body[1];
+	memcpy(msg->content, body + 2, GPON_PLOAM_CONTENT_LEN);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gpon_ploam_parse);
+
+/* Offsets within the standard body. The ONU-ID is big endian and the content
+ * follows the four byte header. G.9807.1 Table C.11.1.
+ */
+#define XGSPON_PLOAM_OFF_ONU_ID	0
+#define XGSPON_PLOAM_OFF_MSG_ID	2
+#define XGSPON_PLOAM_OFF_SEQ_NO	3
+#define XGSPON_PLOAM_OFF_CONTENT	4
+
+/* Serial_Number_ONU content, G.9807.1 Table C.11.24. */
+#define XGSPON_PLOAM_SN_OFF_SN		0
+#define XGSPON_PLOAM_SN_OFF_DELAY		8
+#define XGSPON_PLOAM_SN_OFF_CAPABILITY	32
+#define XGSPON_PLOAM_SN_CAPABILITY		(XGSPON_PLOAM_SN_RATE_10G | \
+					 XGSPON_PLOAM_SN_RATE_NO_2G5)
+
+/* Registration content, G.9807.1 Table C.11.25. */
+#define XGSPON_PLOAM_REG_OFF_ID		0
+
+/* Key_Report content, G.9807.1 Table C.11.26. */
+#define XGSPON_PLOAM_KR_OFF_TYPE		0
+#define XGSPON_PLOAM_KR_OFF_INDEX		1
+#define XGSPON_PLOAM_KR_OFF_NUM		2
+#define XGSPON_PLOAM_KR_OFF_FRAGMENT	4
+
+/* Acknowledgment content, G.9807.1 Table C.11.27. */
+#define XGSPON_PLOAM_ACK_OFF_CODE		0
+
+/* Downstream content offsets, checked against the message tables of
+ * G.9807.1 clause C.11.3.3: Key_Control is Table C.11.12 and Reboot_ONU is
+ * Table C.11.23A.
+ */
+/* Burst_Profile, G.9807.1 Table C.11.4. */
+#define XGSPON_PLOAM_BP_OFF_FLAGS		0
+#define XGSPON_PLOAM_BP_OFF_FEC		1
+#define XGSPON_PLOAM_BP_OFF_DELIM_LEN	2
+#define XGSPON_PLOAM_BP_OFF_DELIM		3
+#define XGSPON_PLOAM_BP_OFF_PRE_LEN	11
+#define XGSPON_PLOAM_BP_OFF_PRE_REPEAT	12
+#define XGSPON_PLOAM_BP_OFF_PRE		13
+#define XGSPON_PLOAM_BP_OFF_PON_TAG	21
+
+/* Assign_ONU-ID, G.9807.1 Table C.11.6. */
+#define XGSPON_PLOAM_AOI_OFF_ID		0
+#define XGSPON_PLOAM_AOI_OFF_SN		2
+#define XGSPON_PLOAM_AOI_OFF_RATE		10
+
+/* Ranging_Time, G.9807.1 Table C.11.7. */
+#define XGSPON_PLOAM_RT_OFF_FLAGS		0
+#define XGSPON_PLOAM_RT_OFF_EQD		1
+
+/* Disable_Serial_Number, G.9807.1 Table C.11.9. */
+#define XGSPON_PLOAM_DSN_OFF_MODE		0
+#define XGSPON_PLOAM_DSN_OFF_SN		1
+
+/* Assign_Alloc-ID, G.9807.1 Table C.11.11. */
+#define XGSPON_PLOAM_AAI_OFF_ID		0
+#define XGSPON_PLOAM_AAI_OFF_TYPE		2
+
+/* Key_Control, G.9807.1 Table C.11.12. */
+#define XGSPON_PLOAM_KC_OFF_TYPE		1
+#define XGSPON_PLOAM_KC_OFF_INDEX		2
+#define XGSPON_PLOAM_KC_OFF_LENGTH		3
+
+/* Reboot_ONU, G.9807.1 Table C.11.23A. */
+#define XGSPON_PLOAM_RB_OFF_SN		0
+#define XGSPON_PLOAM_RB_OFF_DEPTH		8
+#define XGSPON_PLOAM_RB_OFF_IMAGE		9
+#define XGSPON_PLOAM_RB_OFF_STATE		10
+#define XGSPON_PLOAM_RB_OFF_FLAGS		11
+
+/**
+ * xgspon_ploam_up_build() - lay out one upstream PLOAM message
+ * @buf:	where to write the standard body, at least XGSPON_PLOAM_BODY_LEN
+ * @len:	the space available
+ * @msg:	what to send
+ *
+ * Writes the ONU-ID, the message identifier, the sequence number and the
+ * content. The caller owns everything around the body: any vendor prefix or
+ * trailer, the message integrity check and the order the bytes reach the
+ * hardware.
+ *
+ * The whole 36 byte content is cleared before the fields are written, so
+ * every octet a message does not use goes out as 0x00. The key report's type,
+ * index and fragment number are masked to their field widths.
+ *
+ * Serial_Number_ONU reports an ONU that supports the 9.95328 Gbit/s upstream
+ * rate only: XGSPON_PLOAM_SN_RATE_10G and XGSPON_PLOAM_SN_RATE_NO_2G5 are set. It
+ * always goes out with ONU-ID XGSPON_PLOAM_ONU_ID_UNASSIGNED and sequence number
+ * 0, as Table C.11.24 fixes both. @msg->onu_id and @msg->seq_no are not used
+ * for it.
+ *
+ * The layouts are ITU-T G.9807.1 Table C.11.24 for Serial_Number_ONU,
+ * Table C.11.25 for Registration, Table C.11.26 for Key_Report and
+ * Table C.11.27 for Acknowledgment.
+ *
+ * Return: the number of bytes written, -EINVAL for a message identifier the
+ * codec does not build or an ONU-ID above XGSPON_PLOAM_ONU_ID_MASK, -ENOSPC for
+ * a buffer that is too small, or -ERANGE for a key fragment longer than
+ * XGSPON_PLOAM_KEY_FRAGMENT_LEN.
+ */
+int xgspon_ploam_up_build(void *buf, size_t len, const struct xgspon_ploam_up *msg)
+{
+	u8 *body = buf;
+	u8 *content = body + XGSPON_PLOAM_OFF_CONTENT;
+	u16 onu_id = msg->onu_id;
+	u8 seq_no = msg->seq_no;
+
+	if (len < XGSPON_PLOAM_BODY_LEN)
+		return -ENOSPC;
+
+	if (msg->onu_id > XGSPON_PLOAM_ONU_ID_MASK)
+		return -EINVAL;
+
+	switch (msg->msg_id) {
+	case XGSPON_PLOAM_UP_SERIAL_NUMBER:
+		onu_id = XGSPON_PLOAM_ONU_ID_UNASSIGNED;
+		seq_no = 0;
+		break;
+	case XGSPON_PLOAM_UP_REGISTRATION:
+	case XGSPON_PLOAM_UP_ACKNOWLEDGE:
+		break;
+	case XGSPON_PLOAM_UP_KEY_REPORT:
+		if (msg->key_report.len > XGSPON_PLOAM_KEY_FRAGMENT_LEN)
+			return -ERANGE;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	put_unaligned_be16(onu_id, &body[XGSPON_PLOAM_OFF_ONU_ID]);
+	body[XGSPON_PLOAM_OFF_MSG_ID] = msg->msg_id;
+	body[XGSPON_PLOAM_OFF_SEQ_NO] = seq_no;
+	memset(content, 0, XGSPON_PLOAM_CONTENT_LEN);
+
+	switch (msg->msg_id) {
+	case XGSPON_PLOAM_UP_SERIAL_NUMBER:
+		memcpy(&content[XGSPON_PLOAM_SN_OFF_SN], msg->sn.sn,
+		       XGSPON_PLOAM_SN_LEN);
+		put_unaligned_be32(msg->sn.random_delay,
+				   &content[XGSPON_PLOAM_SN_OFF_DELAY]);
+		content[XGSPON_PLOAM_SN_OFF_CAPABILITY] = XGSPON_PLOAM_SN_CAPABILITY;
+		break;
+
+	case XGSPON_PLOAM_UP_REGISTRATION:
+		memcpy(&content[XGSPON_PLOAM_REG_OFF_ID], msg->registration.reg_id,
+		       XGSPON_PLOAM_REG_ID_LEN);
+		break;
+
+	case XGSPON_PLOAM_UP_KEY_REPORT:
+		content[XGSPON_PLOAM_KR_OFF_TYPE] = msg->key_report.type & 1;
+		content[XGSPON_PLOAM_KR_OFF_INDEX] = msg->key_report.index & 3;
+		content[XGSPON_PLOAM_KR_OFF_NUM] = msg->key_report.num & 7;
+		memcpy(&content[XGSPON_PLOAM_KR_OFF_FRAGMENT], msg->key_report.key,
+		       msg->key_report.len);
+		break;
+
+	case XGSPON_PLOAM_UP_ACKNOWLEDGE:
+		content[XGSPON_PLOAM_ACK_OFF_CODE] = msg->ack.code;
+		break;
+	}
+
+	return XGSPON_PLOAM_BODY_LEN;
+}
+EXPORT_SYMBOL_GPL(xgspon_ploam_up_build);
+
+/**
+ * xgspon_ploam_down_parse() - read one downstream PLOAM message
+ * @buf:	the standard body, at least XGSPON_PLOAM_BODY_LEN bytes
+ * @len:	how much is there
+ * @msg:	filled in on success
+ *
+ * Reads the header and, for the messages it knows, the content into the
+ * matching member. It decides nothing: whether the message is addressed to
+ * this ONU, whether the current state allows it and whether to acknowledge
+ * it are all the caller's.
+ *
+ * The layouts are ITU-T G.9807.1 Table C.11.4 for Burst_Profile, Table C.11.6
+ * for Assign_ONU-ID, Table C.11.7 for Ranging_Time, Table C.11.8 for
+ * Deactivate_ONU-ID, Table C.11.9 for Disable_Serial_Number, Table C.11.10 for
+ * Request_Registration, Table C.11.11 for Assign_Alloc-ID, Table C.11.12 for
+ * Key_Control and Table C.11.23A for Reboot_ONU.
+ *
+ * The codec checks one range only: the delimiter and preamble lengths of
+ * Burst_Profile. Every other field with a range in the Recommendation, such
+ * as the Reboot_ONU depth or the key index, is the caller's to check.
+ *
+ * Return: 0, -ENOSPC for a short buffer, -EINVAL for a Burst_Profile whose
+ * delimiter or preamble length is outside Table C.11.4, or -EOPNOTSUPP for a
+ * message the codec does not decode, which a caller may count and ignore.
+ * After -EINVAL and -EOPNOTSUPP, @msg->onu_id, @msg->msg_id and
+ * @msg->seq_no are valid, so that the caller can acknowledge the message.
+ * After -ENOSPC, @msg is not written.
+ */
+int xgspon_ploam_down_parse(const void *buf, size_t len,
+			    struct xgspon_ploam_down *msg)
+{
+	const u8 *body = buf;
+	const u8 *content = body + XGSPON_PLOAM_OFF_CONTENT;
+
+	if (len < XGSPON_PLOAM_BODY_LEN)
+		return -ENOSPC;
+
+	memset(msg, 0, sizeof(*msg));
+	msg->onu_id = get_unaligned_be16(&body[XGSPON_PLOAM_OFF_ONU_ID]) &
+		      XGSPON_PLOAM_ONU_ID_MASK;
+	msg->msg_id = body[XGSPON_PLOAM_OFF_MSG_ID];
+	msg->seq_no = body[XGSPON_PLOAM_OFF_SEQ_NO];
+
+	switch (msg->msg_id) {
+	case XGSPON_PLOAM_DOWN_BURST_PROFILE: {
+		struct xgspon_ploam_burst_profile *profile = &msg->burst_profile;
+		u8 flags = content[XGSPON_PLOAM_BP_OFF_FLAGS];
+		u8 repeat_mask;
+
+		profile->index = flags & 3;
+		profile->line_rate = (flags >> 2) & 1;
+		if (profile->line_rate == XGSPON_PLOAM_LINE_RATE_XGSPON)
+			repeat_mask = XGSPON_PLOAM_PREAMBLE_MASK_XGSPON;
+		else
+			repeat_mask = XGSPON_PLOAM_PREAMBLE_MASK_XGPON;
+		profile->version = flags >> 4;
+		profile->fec = content[XGSPON_PLOAM_BP_OFF_FEC] & 1;
+		profile->delimiter_len =
+			content[XGSPON_PLOAM_BP_OFF_DELIM_LEN] & 0xf;
+		memcpy(profile->delimiter, &content[XGSPON_PLOAM_BP_OFF_DELIM],
+		       XGSPON_PLOAM_BURST_PATTERN_LEN);
+		profile->preamble_len = content[XGSPON_PLOAM_BP_OFF_PRE_LEN] & 0xf;
+		profile->preamble_repeat =
+			content[XGSPON_PLOAM_BP_OFF_PRE_REPEAT] & repeat_mask;
+		memcpy(profile->preamble, &content[XGSPON_PLOAM_BP_OFF_PRE],
+		       XGSPON_PLOAM_BURST_PATTERN_LEN);
+		memcpy(profile->pon_tag, &content[XGSPON_PLOAM_BP_OFF_PON_TAG],
+		       XGSPON_PLOAM_PON_TAG_LEN);
+		if (profile->delimiter_len > XGSPON_PLOAM_BURST_DELIMITER_LEN_MAX)
+			return -EINVAL;
+		if (profile->preamble_len < XGSPON_PLOAM_BURST_PREAMBLE_LEN_MIN ||
+		    profile->preamble_len > XGSPON_PLOAM_BURST_PREAMBLE_LEN_MAX)
+			return -EINVAL;
+		return 0;
+	}
+
+	case XGSPON_PLOAM_DOWN_ASSIGN_ONU_ID:
+		msg->assign_onu_id.onu_id =
+			get_unaligned_be16(&content[XGSPON_PLOAM_AOI_OFF_ID]) &
+			XGSPON_PLOAM_ONU_ID_MASK;
+		memcpy(msg->assign_onu_id.sn, &content[XGSPON_PLOAM_AOI_OFF_SN],
+		       XGSPON_PLOAM_SN_LEN);
+		msg->assign_onu_id.line_rate =
+			content[XGSPON_PLOAM_AOI_OFF_RATE] & 1;
+		return 0;
+
+	case XGSPON_PLOAM_DOWN_RANGING_TIME: {
+		u8 flags = content[XGSPON_PLOAM_RT_OFF_FLAGS];
+
+		msg->ranging_time.absolute =
+			(flags & 1) == XGSPON_PLOAM_EQD_ABSOLUTE;
+		msg->ranging_time.positive =
+			((flags >> 1) & 1) == XGSPON_PLOAM_EQD_POSITIVE;
+		msg->ranging_time.eqd =
+			get_unaligned_be32(&content[XGSPON_PLOAM_RT_OFF_EQD]);
+		return 0;
+	}
+
+	case XGSPON_PLOAM_DOWN_DEACTIVATE:
+		return 0;
+
+	case XGSPON_PLOAM_DOWN_DISABLE_SN:
+		msg->disable_sn.mode = content[XGSPON_PLOAM_DSN_OFF_MODE];
+		memcpy(msg->disable_sn.sn, &content[XGSPON_PLOAM_DSN_OFF_SN],
+		       XGSPON_PLOAM_SN_LEN);
+		return 0;
+
+	case XGSPON_PLOAM_DOWN_REQUEST_REG:
+		return 0;
+
+	case XGSPON_PLOAM_DOWN_ASSIGN_ALLOC_ID:
+		msg->assign_alloc_id.alloc_id =
+			get_unaligned_be16(&content[XGSPON_PLOAM_AAI_OFF_ID]) &
+			0x3fff;
+		msg->assign_alloc_id.type = content[XGSPON_PLOAM_AAI_OFF_TYPE];
+		return 0;
+
+	case XGSPON_PLOAM_DOWN_KEY_CONTROL:
+		msg->key_control.control = content[XGSPON_PLOAM_KC_OFF_TYPE] & 1;
+		msg->key_control.key_index =
+			content[XGSPON_PLOAM_KC_OFF_INDEX] & 3;
+		msg->key_control.key_length = content[XGSPON_PLOAM_KC_OFF_LENGTH];
+		return 0;
+
+	case XGSPON_PLOAM_DOWN_REBOOT_ONU:
+		memcpy(msg->reboot.sn, &content[XGSPON_PLOAM_RB_OFF_SN],
+		       XGSPON_PLOAM_SN_LEN);
+		msg->reboot.depth = content[XGSPON_PLOAM_RB_OFF_DEPTH];
+		msg->reboot.image = content[XGSPON_PLOAM_RB_OFF_IMAGE];
+		msg->reboot.state = content[XGSPON_PLOAM_RB_OFF_STATE];
+		msg->reboot.flags = content[XGSPON_PLOAM_RB_OFF_FLAGS];
+		return 0;
+
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+EXPORT_SYMBOL_GPL(xgspon_ploam_down_parse);
diff --git a/net/xpon/ploam_test.c b/net/xpon/ploam_test.c
new file mode 100644
--- /dev/null
+++ b/net/xpon/ploam_test.c
@@ -0,0 +1,1049 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (C) 2026 John Crispin <john@phrozen.org> */
+/* Tests for the PLOAM message codec.
+ *
+ * The codec is a pure function of an ITU-T wire format, so it is the one part
+ * of the subsystem whose correctness can be established without a PON. Every
+ * offset below is the offset the standard gives, so a regression here is a
+ * regression on the wire.
+ */
+
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <net/xpon/ploam_msg.h>
+
+static void gpon_ploam_wire_test(struct kunit *test)
+{
+	static const u8 wire[GPON_PLOAM_BODY_LEN] = {
+		0xff, 0x03, 0x42, 0x4d, 0x54, 0x4b,
+		0x47, 0x01, 0x23, 0x45, 0x67, 0x00,
+	};
+	struct gpon_ploam_msg msg;
+	u8 storage[GPON_PLOAM_BODY_LEN + 2];
+
+	KUNIT_ASSERT_EQ(test, gpon_ploam_parse(wire, sizeof(wire), &msg), 0);
+	KUNIT_EXPECT_EQ(test, msg.onu_id, GPON_PLOAM_ONU_BCAST);
+	KUNIT_EXPECT_EQ(test, msg.msg_id, GPON_PLOAM_DOWN_ASSIGN_ONU_ID);
+	KUNIT_EXPECT_EQ(test, msg.content[0], 0x42);
+	KUNIT_EXPECT_MEMEQ(test, msg.content + 1, "MTKG\x01\x23\x45\x67", 8);
+
+	memset(storage, 0xa5, sizeof(storage));
+	KUNIT_ASSERT_EQ(test,
+			gpon_ploam_build(storage + 1, GPON_PLOAM_BODY_LEN, &msg),
+			GPON_PLOAM_BODY_LEN);
+	KUNIT_EXPECT_MEMEQ(test, storage + 1, wire, sizeof(wire));
+	KUNIT_EXPECT_EQ(test, storage[0], 0xa5);
+	KUNIT_EXPECT_EQ(test, storage[sizeof(storage) - 1], 0xa5);
+	KUNIT_ASSERT_EQ(test,
+			gpon_ploam_parse(storage + 1, GPON_PLOAM_BODY_LEN, &msg), 0);
+	KUNIT_EXPECT_EQ(test, msg.content[0], 0x42);
+}
+
+static void gpon_ploam_short_buffer_test(struct kunit *test)
+{
+	struct gpon_ploam_msg msg, original;
+	u8 body[GPON_PLOAM_BODY_LEN], original_body[GPON_PLOAM_BODY_LEN];
+
+	memset(&msg, 0xa5, sizeof(msg));
+	original = msg;
+	memset(body, 0x5a, sizeof(body));
+	memcpy(original_body, body, sizeof(body));
+
+	KUNIT_EXPECT_EQ(test, gpon_ploam_build(body, sizeof(body) - 1, &msg),
+			-ENOSPC);
+	KUNIT_EXPECT_MEMEQ(test, body, original_body, sizeof(body));
+	KUNIT_EXPECT_EQ(test, gpon_ploam_parse(body, sizeof(body) - 1, &msg),
+			-ENOSPC);
+	KUNIT_EXPECT_MEMEQ(test, &msg, &original, sizeof(msg));
+}
+
+static void xgspon_ploam_unaligned_test(struct kunit *test)
+{
+	struct xgspon_ploam_up up = {
+		.onu_id = 0x102,
+		.msg_id = XGSPON_PLOAM_UP_ACKNOWLEDGE,
+		.seq_no = 0x77,
+		.ack.code = XGSPON_PLOAM_ACK_OK,
+	};
+	struct xgspon_ploam_down down;
+	u8 body[XGSPON_PLOAM_BODY_LEN + 2];
+
+	memset(body, 0xa5, sizeof(body));
+	KUNIT_ASSERT_EQ(test,
+			xgspon_ploam_up_build(body + 1, XGSPON_PLOAM_BODY_LEN, &up),
+			XGSPON_PLOAM_BODY_LEN);
+	KUNIT_EXPECT_EQ(test, body[1], 0x01);
+	KUNIT_EXPECT_EQ(test, body[2], 0x02);
+	KUNIT_EXPECT_EQ(test, body[0], 0xa5);
+	KUNIT_EXPECT_EQ(test, body[sizeof(body) - 1], 0xa5);
+
+	body[3] = XGSPON_PLOAM_DOWN_RANGING_TIME;
+	body[5] = 1;
+	body[6] = 0x11;
+	body[7] = 0x22;
+	body[8] = 0x33;
+	body[9] = 0x44;
+	KUNIT_ASSERT_EQ(test,
+			xgspon_ploam_down_parse(body + 1, XGSPON_PLOAM_BODY_LEN,
+						&down), 0);
+	KUNIT_EXPECT_EQ(test, down.onu_id, 0x102);
+	KUNIT_EXPECT_EQ(test, down.seq_no, 0x77);
+	KUNIT_EXPECT_EQ(test, down.ranging_time.eqd, 0x11223344);
+}
+
+static void xgspon_ploam_refusal_preserves_buffer_test(struct kunit *test)
+{
+	struct xgspon_ploam_up up = {
+		.msg_id = XGSPON_PLOAM_UP_KEY_REPORT,
+		.key_report.len = XGSPON_PLOAM_KEY_FRAGMENT_LEN + 1,
+	};
+	struct xgspon_ploam_down down, original;
+	u8 body[XGSPON_PLOAM_BODY_LEN], original_body[XGSPON_PLOAM_BODY_LEN];
+
+	memset(body, 0x5a, sizeof(body));
+	memcpy(original_body, body, sizeof(body));
+	memset(&down, 0xa5, sizeof(down));
+	memcpy(&original, &down, sizeof(down));
+	KUNIT_EXPECT_EQ(test, xgspon_ploam_up_build(body, sizeof(body), &up),
+			-ERANGE);
+	KUNIT_EXPECT_MEMEQ(test, body, original_body, sizeof(body));
+	KUNIT_EXPECT_EQ(test,
+			xgspon_ploam_down_parse(body, sizeof(body) - 1, &down),
+			-ENOSPC);
+	KUNIT_EXPECT_MEMEQ(test, &down, &original, sizeof(down));
+}
+
+/* The buffer a MAC hands the codec. The Airoha MAC prefixes four bytes, so
+ * the numbers in the comments are offsets into that 44 byte buffer and the
+ * codec writes from byte 4 on.
+ */
+#define T_PREFIX	4
+#define T_BUF		(T_PREFIX + XGSPON_PLOAM_BODY_LEN)
+#define T_OCTET(n)	(T_PREFIX + (n) - 1)
+#define T_DIRT		0xee
+#define T_FRAGMENT	(T_BUF - XGSPON_PLOAM_KEY_FRAGMENT_LEN)
+#define T_KEY_PARTIAL_LEN	5
+
+static const u8 t_zero[XGSPON_PLOAM_CONTENT_LEN];
+
+static void ploam_sn_build_test(struct kunit *test)
+{
+	static const u8 sn[XGSPON_PLOAM_SN_LEN] = {
+		0x4d, 0x54, 0x4b, 0x47, 0x00, 0x00, 0x00, 0x01,
+	};
+	struct xgspon_ploam_up up = {
+		.onu_id = XGSPON_PLOAM_ONU_ID_UNASSIGNED,
+		.msg_id = XGSPON_PLOAM_UP_SERIAL_NUMBER,
+	};
+	u8 body[T_BUF];
+
+	memset(body, T_DIRT, sizeof(body));
+	memcpy(up.sn.sn, sn, sizeof(sn));
+	up.sn.random_delay = 0xaabbccdd;
+
+	KUNIT_EXPECT_EQ(test,
+			xgspon_ploam_up_build(body + T_PREFIX, XGSPON_PLOAM_BODY_LEN,
+					      &up),
+			XGSPON_PLOAM_BODY_LEN);
+
+	KUNIT_EXPECT_EQ(test, body[4], 0x03);	/* ONU-ID high */
+	KUNIT_EXPECT_EQ(test, body[5], 0xff);	/* ONU-ID low */
+	KUNIT_EXPECT_EQ(test, body[6], XGSPON_PLOAM_UP_SERIAL_NUMBER);
+	KUNIT_EXPECT_EQ(test, body[7], 0);		/* sequence number */
+	KUNIT_EXPECT_MEMEQ(test, &body[8], sn, sizeof(sn));
+	KUNIT_EXPECT_EQ(test, body[16], 0xaa);	/* random delay, big endian */
+	KUNIT_EXPECT_EQ(test, body[17], 0xbb);
+	KUNIT_EXPECT_EQ(test, body[18], 0xcc);
+	KUNIT_EXPECT_EQ(test, body[19], 0xdd);
+	KUNIT_EXPECT_EQ(test, body[T_OCTET(37)], 0x03);	/* capability */
+	KUNIT_EXPECT_MEMEQ(test, &body[T_OCTET(17)], t_zero, 36 - 17 + 1);
+	KUNIT_EXPECT_MEMEQ(test, &body[T_OCTET(38)], t_zero, 40 - 38 + 1);
+	KUNIT_EXPECT_EQ(test, body[0], T_DIRT);
+	KUNIT_EXPECT_EQ(test, body[T_PREFIX - 1], T_DIRT);
+}
+
+static void ploam_sn_capability_c_11_24_test(struct kunit *test)
+{
+	struct xgspon_ploam_up up = {
+		.onu_id = XGSPON_PLOAM_ONU_ID_UNASSIGNED,
+		.msg_id = XGSPON_PLOAM_UP_SERIAL_NUMBER,
+	};
+	u8 body[T_BUF] = {};
+
+	KUNIT_EXPECT_EQ(test, XGSPON_PLOAM_SN_RATE_10G, 0x02);
+	KUNIT_EXPECT_EQ(test, XGSPON_PLOAM_SN_RATE_NO_2G5, 0x01);
+	KUNIT_ASSERT_EQ(test,
+			xgspon_ploam_up_build(body + T_PREFIX, XGSPON_PLOAM_BODY_LEN,
+					      &up),
+			XGSPON_PLOAM_BODY_LEN);
+	KUNIT_EXPECT_EQ(test, body[T_OCTET(37)],
+			XGSPON_PLOAM_SN_RATE_10G | XGSPON_PLOAM_SN_RATE_NO_2G5);
+}
+
+static void ploam_registration_build_test(struct kunit *test)
+{
+	struct xgspon_ploam_up up = {
+		.onu_id = 0x101,
+		.msg_id = XGSPON_PLOAM_UP_REGISTRATION,
+		.seq_no = 7,
+	};
+	u8 body[T_BUF] = {};
+
+	memset(up.registration.reg_id, 0x5a, XGSPON_PLOAM_REG_ID_LEN);
+
+	KUNIT_EXPECT_EQ(test,
+			xgspon_ploam_up_build(body + T_PREFIX, XGSPON_PLOAM_BODY_LEN,
+					      &up),
+			XGSPON_PLOAM_BODY_LEN);
+
+	KUNIT_EXPECT_EQ(test, body[4], 0x01);
+	KUNIT_EXPECT_EQ(test, body[5], 0x01);
+	KUNIT_EXPECT_EQ(test, body[6], XGSPON_PLOAM_UP_REGISTRATION);
+	KUNIT_EXPECT_EQ(test, body[7], 7);
+	/* The registration id fills the content to its last byte. */
+	KUNIT_EXPECT_EQ(test, body[8], 0x5a);
+	KUNIT_EXPECT_EQ(test, body[43], 0x5a);
+}
+
+static void ploam_key_report_build_test(struct kunit *test)
+{
+	struct xgspon_ploam_up up = {
+		.onu_id = 0x101,
+		.msg_id = XGSPON_PLOAM_UP_KEY_REPORT,
+		.seq_no = 3,
+	};
+	u8 body[T_BUF] = {};
+
+	up.key_report.type = XGSPON_PLOAM_KEY_REPORT_TYPE_EXISTING;
+	up.key_report.index = XGSPON_PLOAM_KEY_INDEX_SECOND;
+	up.key_report.num = 5;
+	up.key_report.len = XGSPON_PLOAM_KEY_FRAGMENT_LEN;
+	memset(up.key_report.key, 0xc3, XGSPON_PLOAM_KEY_FRAGMENT_LEN);
+
+	KUNIT_EXPECT_EQ(test,
+			xgspon_ploam_up_build(body + T_PREFIX, XGSPON_PLOAM_BODY_LEN,
+					      &up),
+			XGSPON_PLOAM_BODY_LEN);
+
+	KUNIT_EXPECT_EQ(test, body[8], 1);		/* type */
+	KUNIT_EXPECT_EQ(test, body[9], 2);		/* key index */
+	KUNIT_EXPECT_EQ(test, XGSPON_PLOAM_KEY_REPORT_TYPE_NEW, 0);
+	KUNIT_EXPECT_EQ(test, body[10], 5);	/* fragment number */
+	KUNIT_EXPECT_EQ(test, body[12], 0xc3);	/* fragment starts at 12 */
+	KUNIT_EXPECT_EQ(test, body[43], 0xc3);
+	/* byte 11 is between the header and the fragment and stays clear */
+	KUNIT_EXPECT_EQ(test, body[11], 0);
+}
+
+/* The three narrowed fields are masked, not truncated by the caller. */
+static void ploam_key_report_mask_test(struct kunit *test)
+{
+	struct xgspon_ploam_up up = {
+		.onu_id = 0x101,
