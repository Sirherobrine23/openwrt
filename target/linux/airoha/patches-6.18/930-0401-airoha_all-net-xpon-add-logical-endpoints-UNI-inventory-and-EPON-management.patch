 		airoha_fe_rmw(eth, REG_EN7528_PSE_FQFC_CFG, EN7528_PSE_FQ_MAX_MASK,
 			      FIELD_PREP(EN7528_PSE_FQ_MAX_MASK, EN7528_PSE_FQ_MAX));
