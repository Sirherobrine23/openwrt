+static bool airoha_epon_oam_rx(void *data, struct sk_buff *skb, u8 channel,
+			       u16 wire_id, u32 flags)
+{
+	struct xpon_priv *priv = data;
+
+	if (flags & AIROHA_XPON_OAM_RX_F_CRC_ERROR)
+		dev_kfree_skb_any(skb);
