From da761ed7b38436824b42ad8b76d35ebdfc902a94 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 22 Oct 2026 16:20:56 -0300
Subject: [PATCH] dt-bindings: net: describe AN7552 and AN7563 copper Ethernet

Describe the AN7552 frame engine, its AN7563 package variant and the
integrated PHY board profiles. Extend the switch and pinctrl schemas
for the resources used by the Ethernet reference device trees.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 Documentation/devicetree/bindings/arm/airoha.yaml  |   6 ++
 .../devicetree/bindings/net/airoha,an7552-eth.yaml | 109 +++++++++++++++++++++
 .../devicetree/bindings/net/airoha,an7552-phy.yaml |  36 +++++++
 .../bindings/net/dsa/mediatek,mt7530.yaml          |  21 +++-
 .../bindings/pinctrl/airoha,an7563-pinctrl.yaml    |   7 ++
 MAINTAINERS                                        |   2 +
 6 files changed, 177 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/arm/airoha.yaml b/Documentation/devicetree/bindings/arm/airoha.yaml
--- a/Documentation/devicetree/bindings/arm/airoha.yaml
+++ b/Documentation/devicetree/bindings/arm/airoha.yaml
@@ -18,6 +18,12 @@ properties:
     const: '/'
   compatible:
     oneOf:
+      - items:
+          - const: airoha,an7552-evb
+          - const: airoha,an7552
+      - items:
+          - const: airoha,an7563-evb
+          - const: airoha,an7563
       - items:
           - enum:
               - airoha,en7523-evb
diff --git a/Documentation/devicetree/bindings/net/airoha,an7552-eth.yaml b/Documentation/devicetree/bindings/net/airoha,an7552-eth.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/airoha,an7552-eth.yaml
@@ -0,0 +1,109 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/airoha,an7552-eth.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha AN7552 and AN7563 Frame Engine
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  AN7552 and AN7563 have two QDMA engines and an integrated Gigabit switch.
+  The switch CPU port connects to GDM1. The initial driver supports the
+  copper LAN datapath; PON and Ethernet SerDes require separate providers.
+
+properties:
+  compatible:
+    oneOf:
+      - const: airoha,an7552-eth
+      - items:
+          - const: airoha,an7563-eth
+          - const: airoha,an7552-eth
+
+  reg:
+    items:
+      - description: Frame engine registers
+      - description: QDMA LAN registers
+      - description: QDMA WAN registers
+      - description: GDMP SRAM configuration
+
+  reg-names:
+    items:
+      - const: fe
+      - const: qdma0
+      - const: qdma1
+      - const: gdmp
+
+  interrupts:
+    minItems: 10
+    maxItems: 10
+
+  interrupt-names:
+    items:
+      - const: lan0
+      - const: lan1
+      - const: lan2
+      - const: lan3
+      - const: wan0
+      - const: wan1
+      - const: wan2
+      - const: wan3
+      - const: fe-error
+      - const: pdma
+
+  resets:
+    items:
+      - description: Frame engine reset
+      - description: PDMA reset
+      - description: QDMA reset
+
+  reset-names:
+    items:
+      - const: fe
+      - const: pdma
+      - const: qdma
+
+  memory-region:
+    items:
+      - description: QDMA LAN forwarding payload memory
+      - description: QDMA WAN forwarding payload memory
+
+  memory-region-names:
+    items:
+      - const: qdma0-buf
+      - const: qdma1-buf
+
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 0
+
+  ethernet@1:
+    type: object
+    $ref: ethernet-controller.yaml#
+    unevaluatedProperties: false
+    properties:
+      compatible:
+        const: airoha,eth-mac
+      reg:
+        const: 1
+    required:
+      - compatible
+      - reg
+      - phy-mode
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - resets
+  - reset-names
+  - '#address-cells'
+  - '#size-cells'
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/net/airoha,an7552-phy.yaml b/Documentation/devicetree/bindings/net/airoha,an7552-phy.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/airoha,an7552-phy.yaml
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/airoha,an7552-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha AN7552 and AN7563 integrated Gigabit PHYs
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+select:
+  required:
+    - airoha,mdi-resistor-ohms
+
+allOf:
+  - $ref: ethernet-phy.yaml#
+
+properties:
+  reg:
+    minimum: 9
+    maximum: 12
+
+  airoha,mdi-resistor-ohms:
+    enum: [0, 5]
+    default: 5
+    description: External MDI series resistance used by the board design.
+
+  airoha,integrated-transformer:
+    type: boolean
+    description: Use the SDK compensation profile for an integrated transformer.
+
+required:
+  - reg
+
+unevaluatedProperties: false
diff --git a/Documentation/devicetree/bindings/net/dsa/mediatek,mt7530.yaml b/Documentation/devicetree/bindings/net/dsa/mediatek,mt7530.yaml
--- a/Documentation/devicetree/bindings/net/dsa/mediatek,mt7530.yaml
+++ b/Documentation/devicetree/bindings/net/dsa/mediatek,mt7530.yaml
@@ -108,6 +108,14 @@ properties:
           Built-in switch of the Airoha AN7583 SoC
         const: airoha,an7583-switch
 
+      - description: Built-in switch of the AN7552 SoC
+        const: airoha,an7552-switch
+
+      - description: Built-in switch of the AN7563 SoC
+        items:
+          - const: airoha,an7563-switch
+          - const: airoha,an7552-switch
+
   reg:
     maxItems: 1
 
@@ -115,6 +123,9 @@ properties:
     description:
       Phandle to the regulator node necessary for the core power.
 
+  "#address-cells":
+    enum: [0, 1]
+
   "#gpio-cells":
     const: 2
 
@@ -330,10 +341,12 @@ allOf:
   - if:
       properties:
         compatible:
-          enum:
-            - mediatek,mt7988-switch
-            - airoha,en7581-switch
-            - airoha,an7583-switch
+          contains:
+            enum:
+              - mediatek,mt7988-switch
+              - airoha,en7581-switch
+              - airoha,an7583-switch
+              - airoha,an7552-switch
     then:
       $ref: "#/$defs/builtin-dsa-port"
       properties:
diff --git a/Documentation/devicetree/bindings/pinctrl/airoha,an7563-pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/airoha,an7563-pinctrl.yaml
--- a/Documentation/devicetree/bindings/pinctrl/airoha,an7563-pinctrl.yaml
+++ b/Documentation/devicetree/bindings/pinctrl/airoha,an7563-pinctrl.yaml
@@ -16,6 +16,13 @@ properties:
   compatible:
     const: airoha,an7563-pinctrl
 
+  airoha,chip-scu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the CHIP-SCU syscon for pin multiplexing.
+
+  "#address-cells":
+    const: 0
+
   interrupts:
     maxItems: 1
 
