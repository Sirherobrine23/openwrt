From e14e029865bc527445cc804e395d5effa46bf8d6 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 30 Oct 2026 00:21:55 -0300
Subject: [PATCH] net: an7552: fix ppe entries and lro flush

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c         |  14 +-
 drivers/net/ethernet/airoha/airoha_eth.h         |  34 +-
 drivers/net/ethernet/airoha/airoha_ppe.c         | 448 ++++++++++++++++++++---
 drivers/net/ethernet/airoha/airoha_ppe_debugfs.c |  10 +-
 drivers/net/ethernet/airoha/airoha_regs.h        |   2 +-
 5 files changed, 450 insertions(+), 58 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2602,7 +2602,7 @@ static bool airoha_qdma_should_check_ppe_skb(struct airoha_eth *eth,
 	if (reason == AIROHA_PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED)
 		return true;
 
-	if (!airoha_is(eth, airoha_en7523))
+	if (!airoha_is(eth, airoha_en7523, airoha_an7552))
 		return false;
 
 	return reason == AIROHA_PPE_CPU_REASON_HIT_UNBIND ||
@@ -2801,6 +2801,15 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 			}
 		}
 
+		if (airoha_is(eth, airoha_an7552)) {
+			msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
+			hash = FIELD_GET(QDMA_ETH_RXMSG_PPE_ENTRY_MASK, msg1);
+			reason = FIELD_GET(QDMA_ETH_RXMSG_CRSN_MASK, msg1);
+			if (airoha_qdma_foe_entry_is_valid(eth, hash) &&
+			    reason == AIROHA_PPE_CPU_REASON_HIT_UNBIND_RATE_REACHED)
+				airoha_ppe_check_lro(q->qdma, q->skb, hash);
+		}
+
 		if (eth->soc->gpon_metadata &&
 		    (READ_ONCE(dev->flags) & AIROHA_PRIV_F_XPON_MANAGED)) {
 			bool consumed;
@@ -6678,6 +6687,7 @@ static void airoha_fe_lro_disable(struct airoha_eth *eth, int qdma_id)
 	case airoha_an7552:
 		/* Only the first RXQ map exists on this four-ring variant. */
 		airoha_fe_clear(eth, REG_CDM_LRO_EN(id), AN7552_LRO_RXQ_EN_MASK);
+		airoha_ppe_lro_flush(eth, qdma_id);
 		for (i = 0; i < EN7523_AIROHA_MAX_NUM_LRO_QUEUES; i++)
 			airoha_fe_clear(eth, REG_CDM_LRO_RXQ(id, i),
 					LRO_RXQ_MASK(i));
@@ -7704,6 +7714,8 @@ static int airoha_dev_stop(struct net_device *netdev)
 	airoha_tso_flush(dev->eth, netdev);
 	qdma = airoha_qdma_deref(dev);
 	airoha_gdm_update_hw_stats(dev);
+	if (airoha_is(dev->eth, airoha_an7552))
+		airoha_fe_lro_disable(dev->eth, qdma - dev->eth->qdma);
 
 	if (econet) {
 		scoped_guard(spinlock, &dev->reg_lock) {
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -619,6 +619,24 @@ struct airoha_foe_bridge {
 	struct airoha_foe_mac_info l2;
 };
 
+/* AN7552 L2 entries retain a 24-byte ingress key before the action. */
+struct an7552_foe_bridge {
+	u32 dest_mac_hi;
+	u32 vlan_dest_mac_lo;
+	u32 hsk;
+	u32 src_mac_hi;
+	u32 src_mac_lo;
+	u32 rsv1[4];
+	u32 data;
+	u32 ib2;
+	u32 vlan1_etype;
+	u32 rsv2;
+	u32 vlan2;
+	u32 rsv3;
+	u32 meter;
+	u32 rsv4[3];
+};
+
 struct airoha_foe_ipv4_tuple {
 	u32 src_ip;
 	u32 dest_ip;
@@ -693,6 +711,7 @@ struct airoha_foe_entry {
 			u32 ib1;
 			union {
 				struct airoha_foe_bridge bridge;
+				struct an7552_foe_bridge an7552_bridge;
 				struct airoha_foe_ipv4 ipv4;
 				struct airoha_foe_ipv4_dslite dslite;
 				struct airoha_foe_ipv6 ipv6;
@@ -1223,6 +1242,12 @@ struct airoha_ppe_v1 {
 	u32 rx_gem_changed;
 };
 
+struct airoha_ppe_lro_entry {
+	struct airoha_foe_entry entry;
+	u16 hash;
+	bool valid;
+};
+
 struct airoha_ppe {
 	struct airoha_ppe_common common;
 
@@ -1246,6 +1271,10 @@ struct airoha_ppe {
 	 */
 	bool offload_setup_done;
 
+	/* Protected by ppe_lock; one TCP connection per LRO queue. */
+	struct airoha_ppe_lro_entry
+		lro[AIROHA_MAX_NUM_QDMA][EN7523_AIROHA_MAX_NUM_LRO_QUEUES];
+
 	struct airoha_ppe_v1 v1;
 };
 
@@ -1557,6 +1586,9 @@ void airoha_ppe_set_cpu_port(struct airoha_gdm_dev *dev, u8 ppe_id, u8 fport);
 bool airoha_ppe_is_enabled(struct airoha_eth *eth, int index);
 void airoha_ppe_check_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 			  u16 hash, bool rx_wlan);
+void airoha_ppe_check_lro(struct airoha_qdma *qdma, struct sk_buff *skb,
+			  u16 hash);
+void airoha_ppe_lro_flush(struct airoha_eth *eth, unsigned int qdma_id);
 int airoha_ppe_setup_tc_wed(struct airoha_eth *eth, struct net_device *dev,
 			    enum tc_setup_type type, void *type_data);
 int airoha_ppe_setup_tc_block_cb(struct airoha_ppe_dev *dev, void *type_data);
@@ -1564,8 +1596,6 @@ int airoha_ppe_init(struct airoha_eth *eth);
 void airoha_ppe_deinit(struct airoha_eth *eth);
 void airoha_ppe_init_upd_mem(struct airoha_gdm_dev *dev, const u8 *addr);
 u32 airoha_ppe_get_total_num_entries(struct airoha_ppe *ppe);
-struct airoha_foe_entry *airoha_ppe_foe_get_entry(struct airoha_ppe *ppe,
-						  u32 hash);
 void airoha_ppe_foe_entry_get_stats(struct airoha_ppe *ppe, u32 hash,
 				    struct airoha_foe_stats64 *stats);
 void airoha_ppe_v1_read_entry(struct airoha_ppe *ppe, u16 hash,
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -12,8 +12,12 @@
 #include <linux/rhashtable.h>
 #include <linux/rtnetlink.h>
 #include <linux/slab.h>
-#include <net/ipv6.h>
+#include <net/addrconf.h>
+#include <net/dsfield.h>
 #include <net/flow_offload.h>
