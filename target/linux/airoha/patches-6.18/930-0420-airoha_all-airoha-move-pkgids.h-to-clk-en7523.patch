From c9d6f528180dc036e3891e95dac2496bd8fae142 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 21 Oct 2026 00:32:32 -0300
Subject: [PATCH] airoha: move pkgids.h to clk-en7523

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../bindings/clock/airoha,en7523-scu.yaml          |  37 +-
 Documentation/devicetree/bindings/mfd/syscon.yaml  |   2 +
 arch/arm/boot/dts/airoha/en7523.dtsi               |   2 +
 arch/mips/boot/dts/econet/en751221.dtsi            |   7 +
 arch/mips/boot/dts/econet/en751627.dtsi            |   7 +
 arch/mips/boot/dts/econet/en7580.dtsi              |  10 +-
 arch/mips/econet/init.c                            |   8 +-
 drivers/clk/clk-en7523.c                           | 896 +++++++++++++++------
 drivers/cpufreq/Kconfig.arm                        |   3 +-
 drivers/cpufreq/airoha-cpufreq.c                   |  81 +-
 include/linux/soc/airoha/pkgids.h                  | 722 ++---------------
 11 files changed, 804 insertions(+), 971 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/airoha,en7523-scu.yaml b/Documentation/devicetree/bindings/clock/airoha,en7523-scu.yaml
--- a/Documentation/devicetree/bindings/clock/airoha,en7523-scu.yaml
+++ b/Documentation/devicetree/bindings/clock/airoha,en7523-scu.yaml
@@ -38,6 +38,7 @@ properties:
     maxItems: 2
 
   reg-names:
+    minItems: 1
     items:
       - const: np-scu
       - const: mcucfg
@@ -46,6 +47,12 @@ properties:
     $ref: /schemas/types.yaml#/definitions/phandle
     description: Phandle to the SoC CHIP-SCU syscon.
 
+  airoha,scu-efuse:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: |
+      Phandle to the eFuse syscon at 0x1fbf8200. The register range must
+      cover the package identification words at offsets 0x14 and 0x18.
+
   "#clock-cells":
     description: Clock identifier from the matching SoC clock binding header.
     const: 1
@@ -68,9 +75,10 @@ allOf:
     then:
       properties:
         reg:
+          minItems: 1
           items:
             - description: NP-SCU registers
-            - description: MCUCFG registers used while switching the CPU PLL
+            - description: Optional MCUCFG registers used while switching the CPU PLL
       required:
         - reg-names
         - airoha,chip-scu
@@ -111,7 +119,9 @@ allOf:
       properties:
         reg:
           maxItems: 1
-        reg-names: false
+        reg-names:
+          items:
+            - const: np-scu
       required:
         - airoha,chip-scu
 
@@ -141,7 +151,7 @@ examples:
       #address-cells = <2>;
       #size-cells = <2>;
 
-      scuclk: clock-controller@1fb00000 {
+      scuclk_en7581: clock-controller@1fb00000 {
         compatible = "airoha,en7581-scu";
         reg = <0x0 0x1fb00000 0x0 0x970>;
         #clock-cells = <1>;
@@ -149,3 +159,24 @@ examples:
       };
     };
 
+
+  - |
+    chip_scu_en751221: syscon@1fa20000 {
+      compatible = "airoha,chip-scu", "syscon";
+      reg = <0x1fa20000 0x400>;
+    };
+
+    scu_efuse: syscon@1fbf8200 {
+      compatible = "airoha,scu-efuse", "syscon";
+      reg = <0x1fbf8200 0x1c>;
+    };
+
+    scuclk_en751221: system-controller@1fb00000 {
+      compatible = "econet,en751221-scu", "syscon";
+      reg = <0x1fb00000 0x1000>;
+      reg-names = "np-scu";
+      airoha,chip-scu = <&chip_scu_en751221>;
+      airoha,scu-efuse = <&scu_efuse>;
+      #clock-cells = <1>;
+      #reset-cells = <1>;
+    };
diff --git a/Documentation/devicetree/bindings/mfd/syscon.yaml b/Documentation/devicetree/bindings/mfd/syscon.yaml
--- a/Documentation/devicetree/bindings/mfd/syscon.yaml
+++ b/Documentation/devicetree/bindings/mfd/syscon.yaml
@@ -28,6 +28,7 @@ select:
       contains:
         enum:
           - airoha,en7581-pbus-csr
+          - airoha,scu-efuse
           - al,alpine-sysfabric-service
           - allwinner,sun8i-a83t-system-controller
           - allwinner,sun8i-h3-system-controller
@@ -139,6 +140,7 @@ properties:
     items:
       - enum:
           - airoha,en7581-pbus-csr
+          - airoha,scu-efuse
           - al,alpine-sysfabric-service
           - allwinner,sun8i-a83t-system-controller
           - allwinner,sun8i-h3-system-controller
diff --git a/arch/arm/boot/dts/airoha/en7523.dtsi b/arch/arm/boot/dts/airoha/en7523.dtsi
--- a/arch/arm/boot/dts/airoha/en7523.dtsi
+++ b/arch/arm/boot/dts/airoha/en7523.dtsi
@@ -247,7 +247,9 @@ scuclk: system-controller@1fb00000 {
 		reg = <0x1fb00000 0x1000>,
 		      <0x1efbe000 0x800>;
 		reg-names = "np-scu", "mcucfg";
+
 		airoha,chip-scu = <&chip_scu>;
+
 		#clock-cells = <1>;
 		#reset-cells = <1>;
 	};
diff --git a/arch/mips/boot/dts/econet/en751221.dtsi b/arch/mips/boot/dts/econet/en751221.dtsi
--- a/arch/mips/boot/dts/econet/en751221.dtsi
+++ b/arch/mips/boot/dts/econet/en751221.dtsi
@@ -115,10 +115,17 @@ chip_scu: syscon@1fa20000 {
 		reg = <0x1fa20000 0x400>;
 	};
 
+	scu_efuse: syscon@1fbf8200 {
+		compatible = "airoha,scu-efuse", "syscon";
+		reg = <0x1fbf8200 0x1c>;
+	};
+
 	scuclk: system-controller@1fb00000 {
 		compatible = "econet,en751221-scu", "syscon";
 		reg = <0x1fb00000 0x1000>;
+
 		airoha,chip-scu = <&chip_scu>;
+		airoha,scu-efuse = <&scu_efuse>;
 
 		#clock-cells = <1>;
 		#reset-cells = <1>;
diff --git a/arch/mips/boot/dts/econet/en751627.dtsi b/arch/mips/boot/dts/econet/en751627.dtsi
--- a/arch/mips/boot/dts/econet/en751627.dtsi
+++ b/arch/mips/boot/dts/econet/en751627.dtsi
@@ -99,11 +99,18 @@ chip_scu: syscon@1fa20000 {
 			reg = <0x1fa20000 0x400>;
 		};
 
+		scu_efuse: syscon@1fbf8200 {
+			compatible = "airoha,scu-efuse", "syscon";
+			reg = <0x1fbf8200 0x1c>;
+		};
+
 		scuclk: system-controller@1fb00000 {
 			compatible = "econet,en751627-scu", "syscon";
 			reg = <0x1fb00000 0x1000>;
 
 			airoha,chip-scu = <&chip_scu>;
+			airoha,scu-efuse = <&scu_efuse>;
+
 			#clock-cells = <1>;
 			#reset-cells = <1>;
 		};
diff --git a/arch/mips/boot/dts/econet/en7580.dtsi b/arch/mips/boot/dts/econet/en7580.dtsi
--- a/arch/mips/boot/dts/econet/en7580.dtsi
+++ b/arch/mips/boot/dts/econet/en7580.dtsi
@@ -144,15 +144,23 @@ pcie_phy1: pcie-phy@1fac0000 {
 		};
 
 		chip_scu: syscon@1fa20000 {
-			compatible = "airoha,scuclk", "econet,en7580-chip-scu", "syscon";
+			compatible = "airoha,chip-scu", "syscon";
 			reg = <0x1fa20000 0x400>;
 		};
 
+		scu_efuse: syscon@1fbf8200 {
+			compatible = "airoha,scu-efuse", "syscon";
+			reg = <0x1fbf8200 0x1c>;
+		};
+
 		scuclk: system-controller@1fb00000 {
 			compatible = "econet,en7580-scu", "syscon";
 			reg = <0x1fb00000 0x1000>;
+			reg-names = "np-scu";
 
 			airoha,chip-scu = <&chip_scu>;
+			airoha,scu-efuse = <&scu_efuse>;
+
 			#clock-cells = <1>;
 			#reset-cells = <1>;
 		};
diff --git a/arch/mips/econet/init.c b/arch/mips/econet/init.c
--- a/arch/mips/econet/init.c
+++ b/arch/mips/econet/init.c
@@ -18,13 +18,10 @@
 #include <asm/reboot.h>
 #include <asm/mips-cps.h>
 
-#include "linux/soc/airoha/pkgids.h"
+#include <linux/soc/airoha/pkgids.h>
 
 #define CR_AHB_RSTCR		((void __iomem *)CKSEG1ADDR(0x1fb00040))
 #define RESET			BIT(31)
-#define NP_SCU_BASE		((void __iomem *)CKSEG1ADDR(0x1fb00000))
-#define CHIP_SCU_BASE		((void __iomem *)CKSEG1ADDR(AIROHA_CHIP_SCU_BASE_PHYS))
-#define EFUSE_BASE		((void __iomem *)CKSEG1ADDR(AIROHA_EFUSE_BASE_PHYS))
 
 #ifdef CONFIG_CPU_LITTLE_ENDIAN
 #define UART_BASE		CKSEG1ADDR(0x1fbf0000)	/* LE: byte at offset 0 */
@@ -120,8 +117,7 @@ const char *get_system_type(void)
 	static char system_type[64];
 	const char *soc;
 
-	soc = airoha_soc_name_from_mips_mem(NP_SCU_BASE, CHIP_SCU_BASE,
-				     EFUSE_BASE);
+	soc = airoha_id_name(airoha_get_pkg_id(NULL));
 
 	snprintf(system_type, sizeof(system_type), "EcoNet %s", soc);
 	return system_type;
diff --git a/drivers/clk/clk-en7523.c b/drivers/clk/clk-en7523.c
--- a/drivers/clk/clk-en7523.c
+++ b/drivers/clk/clk-en7523.c
@@ -6,6 +6,7 @@
 #include <linux/bitfield.h>
 #include <linux/bitops.h>
 #include <linux/delay.h>
+#include <linux/export.h>
 #include <linux/clk-provider.h>
 #include <linux/io.h>
 #include <linux/irqflags.h>
@@ -16,6 +17,7 @@
 #include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/reset-controller.h>
+#include <linux/soc/airoha/pkgids.h>
 #include <dt-bindings/clock/en7523-clk.h>
 #include <dt-bindings/clock/econet,en751221-scu.h>
 #include <dt-bindings/clock/econet,en7528-scu.h>
@@ -77,8 +79,6 @@
 #define   REG_RESET_CONTROL_PCIEHB	BIT(29)
 #define   REG_RESET_CONTROL_PCIE1	BIT(27)
 #define   REG_RESET_CONTROL_PCIE2	BIT(26)
-#define REG_HIR				0x064
-#define   REG_HIR_MASK			GENMASK(31, 16)
 #define REG_TRNG_BUS_CLK_GAT		0x1e4
 #define REG_TRNG_PER_CLK_GAT_1		0x1e8
 #define REG_TRNG_PER_CLK_GAT_2		0x1ec
@@ -135,24 +135,53 @@
 #define EN7580_REG_TOD_DIVIDER_ENABLE	0x1e4
 #define EN7580_MAX_CLKS			5
 
-enum en_hir {
-	HIR_UNKNOWN	= -1,
-	HIR_TC3169	= 0,
-	HIR_TC3182	= 1,
-	HIR_RT65168	= 2,
-	HIR_RT63165	= 3,
-	HIR_RT63365	= 4,
-	HIR_MT751020	= 5,
-	HIR_MT7505	= 6,
-	HIR_EN751221	= 7,
-	HIR_EN7526C	= 8,
-	HIR_EN751627	= 9,
-	HIR_EN7580	= 10,
-	HIR_EN7528	= 11,
-	HIR_EN7523	= 12,
-	HIR_EN7581	= 13,
-	HIR_MAX		= 14,
-};
+/* SCU PKG ID */
+#define AIROHA_NP_SCU_PDIDR		0x05c
+#define AIROHA_NP_SCU_HIR		0x064
+#define AIROHA_NP_SCU_SUBMODEL		0x0f8
+#define AIROHA_NP_SCU_SCREG_WR1		0x284
+#define AIROHA_CHIP_SCU_PACKAGE		0x174
+#define AIROHA_CHIP_SCU_CONFIG		0x1ec
+#define AIROHA_EFUSE_VERIFY_DATA0	0x014
+#define AIROHA_EFUSE_VERIFY_DATA1	0x018
+
+#define AIROHA_NP_SCU_HIR_MASK		GENMASK(31, 16)
+#define AIROHA_NP_SCU_PDIDR_MASK	GENMASK(15, 0)
+#define AIROHA_NP_SCU_PACKAGE_ID_MASK	GENMASK(3, 0)
+#define AIROHA_NP_SCU_PACKAGE_ID_EXT	BIT(7)
+#define AIROHA_NP_SCU_SUBMODEL_MASK	GENMASK(1, 0)
+
+/* EN7512/EN7521 and EN7526C/EN7522 eFuse encoding. */
+#define AIROHA_EFUSE_PKG_MASK		GENMASK(5, 0)
+#define AIROHA_EFUSE_PKG_IGNORE_BIT01	GENMASK(5, 2)
+#define AIROHA_EFUSE_REMARK_BIT		BIT(6)
+#define AIROHA_EFUSE_PKG_REMARK_SHIFT	7
+
+#define AIROHA_EFUSE_DDR3_BIT		BIT(23)
+#define AIROHA_EFUSE_DDR3_REMARK_BIT	BIT(24)
+
+/* EN7516/EN7527 eFuse encoding. */
+#define AIROHA_EFUSE_7516_PKG_MASK	GENMASK(19, 18)
+#define AIROHA_EFUSE_7516_REMARK_BIT	BIT(0)
+#define AIROHA_EFUSE_7516_REMARK_SHIFT	2
+
+#define AIROHA_EFUSE_EN7527H		0x00000
+#define AIROHA_EFUSE_EN7527G		0x00000
+#define AIROHA_EFUSE_EN7516G		0x80000
+#define AIROHA_EFUSE_EN7561G		0xc0000
+
+/* Additional package selectors used by the legacy vendor code. */
+#define AIROHA_EN751627_QFP_MASK	BIT(15)
+#define AIROHA_EN7526C_FP_MASK		BIT(10)
+#define AIROHA_EN7526C_FTC_BIT		BIT(9)
+#define AIROHA_EN7526C_FTC_REMARK_BIT	BIT(10)
+
+/* MT7510/MT7520 module-selection bits in EFUSE_VERIFY_DATA0. */
+#define AIROHA_MT751020_ENP_SEL		BIT(3)
+#define AIROHA_MT751020_ENP_LOW		BIT(1)
+#define AIROHA_MT751020_ENP_HIGH	BIT(5)
+#define AIROHA_MT751020_ENS_LOW		BIT(2)
+#define AIROHA_MT751020_ENS_HIGH	BIT(6)
 
 struct en_clk_desc {
 	int id;
@@ -205,10 +234,9 @@ struct en_rst_data {
 };
 
 struct econet_clk_soc_data {
-	const char *chip_scu_compatible;
 	u32 spi_base;
 	u32 spi_alt_base;
-	enum en_hir spi_alt_hir;
+	enum airoha_pkg spi_alt_hir;
 	u16 spi_div_reg;
 	u32 spi_div_mask;
 	u32 spi_div_default;
@@ -220,7 +248,10 @@ struct econet_clk_soc_data {
 	u32 shared_unzip_val;
 };
 
-struct en_clk_soc_data {
+struct airoha_clk_priv;
+
+struct airoha_clk_soc_data {
+	const char *old_chip_scu_compatible;
 	bool probe_child;
 	u32 num_clocks;
 	u32 num_base_clks;
@@ -231,10 +262,291 @@ struct en_clk_soc_data {
 	const struct econet_clk_soc_data *econet;
 	const struct clk_ops pcie_ops;
 	int (*hw_init)(struct platform_device *pdev,
-		       const struct en_clk_soc_data *soc_data,
+		       struct airoha_clk_priv *priv,
 		       struct clk_hw_onecell_data *clk_data);
 };
 
+struct airoha_clk_priv {
+	const struct airoha_clk_soc_data *soc_data;
+	enum airoha_id_source soc_source;
+	enum airoha_pkg soc_family;
+	enum airoha_pkg_ids soc_id;
+	struct regmap *scu_chip;
+	struct regmap *scu_np;
+	void __iomem *np_scu_base;
+	void __iomem *chip_scu_base;
+	void __iomem *efuse_base;
+	void __iomem *mcucfg;
+};
+
+static const struct of_device_id of_match_clk_en7523[];
+
+static enum airoha_pkg_ids
+airoha_pkg_id_from_range(u32 pkgid, enum airoha_pkg_ids first,
+			 enum airoha_pkg_ids last)
+{
+	u32 id;
+
+	if (pkgid > (u32)(last - first))
+		return END_PACKAGE_ID;
+
+	id = first + pkgid;
+	if (id >= ARRAY_SIZE(airoha_pkg_id_names) ||
+	    !airoha_pkg_id_names[id])
+		return END_PACKAGE_ID;
+
+	return id;
+}
+
+static enum airoha_pkg airoha_pkg_from_id(u32 id)
+{
+	switch (id) {
+	case AN7583_PKG:
+	case 0x7583:
+	case 0x9510:
+	case 0x7553:
+	case 0x7567:
+		return AN7583_PKG;
+	case AN7552_PKG:
+	case 0x7552:
+	case 0x7563:
+		return AN7552_PKG;
+	case EN7581_PKG:
+	case 0x7581:
+	case 0x7566:
+	case 0x7551:
+		return EN7581_PKG;
+	case EN7523_PKG:
+	case 0x7523:
+	case 0x7529:
+	case 0x7562:
+		return EN7523_PKG;
+	case EN7528_PKG:
+	case 0x7528:
+	case 0x7561:
+		return EN7528_PKG;
+	case EN7580_PKG:
+	case 0x7580:
+	case 0x7565:
+		return EN7580_PKG;
+	case EN751627_PKG:
+	case 0x7516:
+	case 0x7527:
+		return EN751627_PKG;
+	case EN7526C_PKG:
+	case 0x7522:
+		return EN7526C_PKG;
+	case EN751221_PKG:
+	case 0x7512:
+	case 0x7513:
+	case 0x7521:
+	case 0x7526:
+		return EN751221_PKG;
+	case MT751020_PKG:
+	case 0x7510:
+	case 0x7520:
+	case 0x7525:
+		return MT751020_PKG;
+	default:
+		return UNKNOWN_PKG;
+	}
+}
+
+static u32 airoha_efuse_pkg_value(u32 efuse_data0)
+{
+	if (efuse_data0 & AIROHA_EFUSE_REMARK_BIT)
+		return (efuse_data0 >> AIROHA_EFUSE_PKG_REMARK_SHIFT) &
+		       AIROHA_EFUSE_PKG_MASK;
+
+	return efuse_data0 & AIROHA_EFUSE_PKG_MASK;
+}
+
+static u32 airoha_efuse_7516_pkg_value(u32 efuse_data0)
+{
+	if (efuse_data0 & AIROHA_EFUSE_7516_REMARK_BIT)
+		return (efuse_data0 >> AIROHA_EFUSE_7516_REMARK_SHIFT) &
+		       AIROHA_EFUSE_7516_PKG_MASK;
+
+	return efuse_data0 & AIROHA_EFUSE_7516_PKG_MASK;
+}
+
+static bool airoha_efuse_is_ddr3(u32 efuse_data0)
+{
+	if (efuse_data0 & AIROHA_EFUSE_REMARK_BIT)
+		return !!(efuse_data0 & AIROHA_EFUSE_DDR3_REMARK_BIT);
+
+	return !!(efuse_data0 & AIROHA_EFUSE_DDR3_BIT);
+}
+
+static bool
+airoha_en7526c_is_ft_c(u32 efuse_data0, u32 efuse_data1)
+{
+	if (efuse_data0 & AIROHA_EFUSE_REMARK_BIT)
+		return !!(efuse_data1 & AIROHA_EN7526C_FTC_REMARK_BIT);
+
+	return !!(efuse_data1 & AIROHA_EN7526C_FTC_BIT);
+}
+
+static enum airoha_pkg_ids
+airoha_en751221_variant_id(u32 efuse_data0)
+{
+	switch (airoha_efuse_pkg_value(efuse_data0)) {
+	case EN7526F_EFUSE:
+		return EN7526F;
+	case EN7526D_EFUSE:
+		return EN7526D;
+	case EN7526G_EFUSE:
+		return EN7526G;
+	case EN7512_EFUSE:
+		return EN7512;
+	case EN7513_EFUSE:
+		return EN7513;
+	case EN7513G_EFUSE:
+		return EN7513G;
+	case EN7586_EFUSE:
+		return EN7586;
+	case EN7521F_EFUSE:
+		return EN7521F;
+	case EN7526FT_EFUSE:
+		return EN7526FT;
+	case EN7521G_EFUSE:
+		return EN7521G;
+	case EN7521S_EFUSE:
+		return EN7521S;
+	default:
+		return EN751221;
+	}
+}
+
+static enum airoha_pkg_ids
+airoha_en7526c_variant_id(u32 efuse_data0, u32 efuse_data1,
+			  u32 chip_scu_config)
+{
+	u32 pkg = airoha_efuse_pkg_value(efuse_data0) &
+		  AIROHA_EFUSE_PKG_IGNORE_BIT01;
+
+	/* The vendor macros make these refinements orthogonal to the base ID. */
+	if (airoha_en7526c_is_ft_c(efuse_data0, efuse_data1))
+		return EN7526FT_C;
+
+	switch (pkg) {
+	case EN7526F_EFUSE:
+		if (chip_scu_config & AIROHA_EN7526C_FP_MASK)
+			return EN7526FP;
+		return EN7526F;
+	case EN7521F_EFUSE:
+		if (airoha_efuse_is_ddr3(efuse_data0))
+			return EN7521FCUD;
+		return EN7521F;
+	case EN7521S_EFUSE:
+		return EN7521S;
+	default:
+		return END_PACKAGE_ID;
+	}
+}
+
+static enum airoha_pkg_ids
+airoha_en751627_variant_id(u32 efuse_data0, u32 chip_scu_package)
+{
+	switch (airoha_efuse_7516_pkg_value(efuse_data0)) {
+	case AIROHA_EFUSE_EN7527G:
+		if (chip_scu_package & AIROHA_EN751627_QFP_MASK)
+			return EN7527H;
+		return EN7527G;
+	case AIROHA_EFUSE_EN7516G:
+		return EN7516G;
+	case AIROHA_EFUSE_EN7561G:
+		return EN7561G;
+	default:
+		return EN751627;
+	}
+}
+
+static bool airoha_mt751020_is_enp(u32 efuse_data0)
+{
+	if (efuse_data0 & AIROHA_MT751020_ENP_SEL)
+		return !!(efuse_data0 & AIROHA_MT751020_ENP_HIGH);
+
+	return !!(efuse_data0 & AIROHA_MT751020_ENP_LOW);
+}
+
+static bool airoha_mt751020_is_ens(u32 efuse_data0)
+{
+	if (efuse_data0 & AIROHA_MT751020_ENP_SEL)
+		return !!(efuse_data0 & AIROHA_MT751020_ENS_HIGH);
+
+	return !!(efuse_data0 & AIROHA_MT751020_ENS_LOW);
+}
+
+static enum airoha_pkg_ids
+airoha_mt751020_variant_id(u32 submodel, u32 efuse_data0)
+{
+	bool enp = airoha_mt751020_is_enp(efuse_data0);
+	bool ens = airoha_mt751020_is_ens(efuse_data0);
+
+	switch (FIELD_GET(AIROHA_NP_SCU_SUBMODEL_MASK, submodel)) {
+	case 0:
+		return enp ? MT7510 : MT7511;
+	case 2:
+		if (ens)
+			return MT7520S;
+		return enp ? MT7520 : MT7525;
+	case 3:
+		return enp ? MT7520G : MT7525G;
+	default:
+		return END_PACKAGE_ID;
+	}
+}
