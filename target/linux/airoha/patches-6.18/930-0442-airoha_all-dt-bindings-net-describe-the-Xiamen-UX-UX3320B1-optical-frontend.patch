From e11fe739de73473043353a28fddbfa7cfe7d61f1 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sun, 25 Oct 2026 21:35:37 -0300
Subject: [PATCH] dt-bindings: net: describe the Xiamen UX UX3320B1 optical
 frontend

Register the UX vendor prefix and describe an independent I2C optical
frontend with board-specific NVMEM or firmware calibration. Document the
native 768-byte register-image layout instead of accepting the unrelated
EN757x BOB or Semtech tables.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../devicetree/bindings/net/ux,ux3320b1.yaml       | 70 ++++++++++++++++++++++
 .../devicetree/bindings/vendor-prefixes.yaml       |  2 +
 2 files changed, 72 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/ux,ux3320b1.yaml b/Documentation/devicetree/bindings/net/ux,ux3320b1.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/ux,ux3320b1.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/ux,ux3320b1.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiamen UX UX3320B1 optical frontend
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  UX3320B1 is an optical transceiver controller used with an external BOSA.
+  Its SFF-8472 A2 interface uses an 8-bit bank selector at 0x7f for the upper
+  128-byte register window. The chip handles the calibrated optical loops.
+  TX_DISABLE, RX_LOS and burst-enable board signals belong to the digital
+  PHY consumer, not this I2C provider.
+
+properties:
+  compatible:
+    const: ux,ux3320b1
+
+  reg:
+    maxItems: 1
+
+  '#optical-frontend-cells':
+    const: 0
+
+  nvmem-cells:
+    maxItems: 1
+    description:
+      Board-specific calibrated register image in the 768-byte format exported
+      by the AOT4221NK stock driver. This is not its cfg.bob factory record.
+
+  nvmem-cell-names:
+    items:
+      - const: calibration
+
+  firmware-name:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: |
+      Board-specific final calibrated register image. The 768 bytes contain
+      the A2 lower half followed by upper banks 0, 3, 4, 5 and 6, each in a
+      128-byte slot. NVMEM takes precedence. If absent, request
+      ux/ux3320b1-hwconfig.bin. Missing calibration leaves TX disabled.
+
+required:
+  - compatible
+  - reg
+  - '#optical-frontend-cells'
+
+dependencies:
+  nvmem-cells: [nvmem-cell-names]
+  nvmem-cell-names: [nvmem-cells]
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        optical-frontend@51 {
+            compatible = "ux,ux3320b1";
+            reg = <0x51>;
+            #optical-frontend-cells = <0>;
+            firmware-name = "ux/aot4221nk-ux3320b1-hwconfig.bin";
+        };
+    };
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -1711,6 +1711,8 @@ patternProperties:
     description: Ultratronik GmbH
   "^utoo,.*":
     description: Aigo Digital Technology Co., Ltd.
+  "^ux,.*":
+    description: Xiamen UX IC Co., Ltd.
   "^v3,.*":
     description: V3 Semiconductor
   "^vaisala,.*":

