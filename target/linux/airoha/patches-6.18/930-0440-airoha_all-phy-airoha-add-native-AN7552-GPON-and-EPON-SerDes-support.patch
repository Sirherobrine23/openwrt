+		0x63886595 : 0x64000000;
+	for (i = 0; i < 9; i++) {
+		usleep_range(1000, 1100);
+		ncpo = airoha_xpon_phy_read(priv, AN7552_LCPLL_NCPO);
+		if (ncpo > target - 0x10000 && ncpo < target + 0x10000)
+			break;
