From dd5a38e981f87c2f6d87b65430fa6ec56568558e Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sun, 25 Oct 2026 20:53:47 -0300
Subject: [PATCH] phy: airoha: add native AN7552 GPON and EPON SerDes support

The AOT4221NK stock PHY module has a separate Mode_Config_7552(). The
EN7523 PMA settings do not initialize the AN7552 optical PLL and CDR.
Add the native GPON/EPON settings, FW_READY management, TDC settling,
TX reset release, and the crystal-dependent K-band recovery sequence.

Select optical PON in NP-SCU SSTR before releasing the shared SerDes
reset. Leave pad routing to pinctrl: AN7552 IOMUX_CTRL3 is in chip SCU
at 0x21c, not the EN7523 NP-SCU location used by the old backend.
Mask the digital/PMA interrupt sources and use the existing READY/LOS
polling work. Keep the existing EN7523 ready/reset behavior as fallback
callbacks for its own compatible.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/phy/airoha/Kconfig                 |   2 +-
 drivers/phy/airoha/phy-airoha-en7580-seq.h | 497 -----------------
 drivers/phy/airoha/phy-airoha-xpon.c       | 829 ++++++++++++++++++++++++++++-
 3 files changed, 819 insertions(+), 509 deletions(-)

diff --git a/drivers/phy/airoha/Kconfig b/drivers/phy/airoha/Kconfig
--- a/drivers/phy/airoha/Kconfig
+++ b/drivers/phy/airoha/Kconfig
@@ -39,7 +39,7 @@ config PHY_AIROHA_XPON
 	depends on MFD_SYSCON
 	select GENERIC_PHY
 	help
-	  Enable the digital GPON/EPON PHY found in Airoha EN7523-family and
+	  Enable the digital GPON/EPON PHY found in Airoha AN7552, EN7523-family and
 	  EcoNet EN751221 SoCs. The driver programs the common xPON receiver,
 	  selects the protocol mode and runs the SoC-specific PHY bring-up.
 	  EN7580 uses a separate XGS-PON PCS/PMA calibration and LOS recovery
diff --git a/drivers/phy/airoha/phy-airoha-en7580-seq.h b/drivers/phy/airoha/phy-airoha-en7580-seq.h
deleted file mode 100644
--- a/drivers/phy/airoha/phy-airoha-en7580-seq.h
+++ /dev/null
@@ -1,497 +0,0 @@
-/* SPDX-License-Identifier: GPL-2.0-only */
-/* EN7580 XGS-PON sequences from xpon_phy_10g/src/en7580_pma.c.
- * Preserve register masks, reset strobes and delay ordering.
- * XFI/JCPLL registers remain owned by the XSI PCS driver.
- */
