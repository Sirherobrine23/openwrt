 struct omci_service_config {
 	u32 cookie;
@@ -340,6 +343,8 @@ struct omci_service_config {
 	u16 tag_tci;
 	bool tag_untagged;
 	bool strip_downstream;
+	struct xpon_vlan_config vlan;
