From 87f42b611282a5410259aa79dc2d1a3c32222d42 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 5 Nov 2026 21:09:54 -0300
Subject: [PATCH] net: airoha: update npu regs and others changes

---
 arch/arm/boot/dts/airoha/an7552.dtsi      |   2 +-
 arch/arm/boot/dts/airoha/en7523.dtsi      |   2 +-
 arch/arm64/boot/dts/airoha/an7581.dtsi    |   2 +-
 drivers/net/ethernet/airoha/airoha_eth.c  |  12 +-
 drivers/net/ethernet/airoha/airoha_eth.h  |   6 +-
 drivers/net/ethernet/airoha/airoha_npu.c  | 470 +++++++++---------------------
 include/linux/soc/airoha/airoha_offload.h |  16 +-
 7 files changed, 171 insertions(+), 339 deletions(-)

diff --git a/arch/arm/boot/dts/airoha/an7552.dtsi b/arch/arm/boot/dts/airoha/an7552.dtsi
--- a/arch/arm/boot/dts/airoha/an7552.dtsi
+++ b/arch/arm/boot/dts/airoha/an7552.dtsi
@@ -499,7 +499,7 @@ map0 {
 	};
 
 	npu: npu@1e900000 {
-		compatible = "airoha,airoha_an7552-npu";
+		compatible = "airoha,an7552-npu";
 		reg = <0x1e900000 0x313000>;
 		interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>,
 		             <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>,
diff --git a/arch/arm/boot/dts/airoha/en7523.dtsi b/arch/arm/boot/dts/airoha/en7523.dtsi
--- a/arch/arm/boot/dts/airoha/en7523.dtsi
+++ b/arch/arm/boot/dts/airoha/en7523.dtsi
@@ -29,7 +29,7 @@ atf@80000000 {
 
 		npu_binary: npu-binary@84000000 {
 			no-map;
-			reg = <0x84000000 0x00100000>;
+			reg = <0x84000000 0x00400000>;
 		};
 
 		npu_pkt: npu-pkt@84d00000 {
diff --git a/arch/arm64/boot/dts/airoha/an7581.dtsi b/arch/arm64/boot/dts/airoha/an7581.dtsi
--- a/arch/arm64/boot/dts/airoha/an7581.dtsi
+++ b/arch/arm64/boot/dts/airoha/an7581.dtsi
@@ -1000,7 +1000,7 @@ pcie2_slot2: pcie@2,0 {
 		};
 
 		npu: npu@1e900000 {
-			compatible = "airoha,en7581-npu", "airoha,airoha_en7581-npu";
+			compatible = "airoha,en7581-npu", "airoha,en7581-npu";
 			reg = <0x0 0x1e900000 0x0 0x313000>;
 
 			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>,
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -3657,9 +3657,13 @@ static int airoha_qdma_modern_hw_init(struct airoha_qdma *qdma)
 		airoha_qdma_irq_enable(&qdma->irq_banks[i], QDMA_INT_REG_IDX3,
 				       INT_RX3_MASK(RX_IRQ_BANK_PIN_MASK(i)));
 	}
-	/* setup tx irqs */
-	airoha_qdma_irq_enable(&qdma->irq_banks[0], QDMA_INT_REG_IDX0,
-			       TX_COHERENT_LOW_INT_MASK | INT_TX_MASK);
+	/* setup tx irqs, TX IRQ queue 1 stays with the NPU on EN7523 */
+	if (airoha_is(qdma->eth, airoha_en7523) && qdma == &qdma->eth->qdma[0])
+		airoha_qdma_irq_enable(&qdma->irq_banks[0], QDMA_INT_REG_IDX0,
+				       TX_COHERENT_LOW_INT_MASK | TX_DONE_INT_MASK(0));
+	else
+		airoha_qdma_irq_enable(&qdma->irq_banks[0], QDMA_INT_REG_IDX0,
+				       TX_COHERENT_LOW_INT_MASK | INT_TX_MASK);
 	if (!compact_irq)
 		airoha_qdma_irq_enable(&qdma->irq_banks[0], QDMA_INT_REG_IDX4,
 				       TX_COHERENT_HIGH_INT_MASK);
@@ -11639,6 +11643,8 @@ static int airoha_eth_probe(struct platform_device *pdev)
 		goto error;
 
 	err = airoha_npu_start(eth->dev);
+	if (err == -EPROBE_DEFER)
+		goto error;
 	if (err && err != -ENODEV && err != -EPROBE_DEFER &&
 	    err != -EOPNOTSUPP)
 		dev_warn(eth->dev, "failed to start NPU: %d\n", err);
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -1533,7 +1533,11 @@ void airoha_qdma_stop(struct airoha_qdma *qdma);
 
 static inline u16 airoha_qdma_get_txq(struct airoha_qdma *qdma, u16 qid)
 {
-	return qid % qdma->eth->soc->tx_ring;
+	qid %= qdma->eth->soc->tx_ring;
+	if (qid == 6 && qdma->eth->soc->version == airoha_en7523 &&
+	    qdma == &qdma->eth->qdma[0])
+		qid++;
+	return qid;
 }
 
 static inline bool airoha_is_lan_gdm_dev(struct airoha_gdm_dev *dev)
diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -45,10 +45,18 @@
 
 #define REG_NPU_LOCAL_SRAM		0x0
 
-#define REG_PC_DBG(_soc, _n)		((_soc)->pc_base_addr + ((_n) * 0x100))
-#define REG_CR_BOOT_TRIGGER(_soc)	((_soc)->cluster_base_addr + 0x000)
-#define REG_CR_BOOT_CONFIG(_soc)	((_soc)->cluster_base_addr + 0x004)
-#define REG_CR_BOOT_BASE(_soc, _n)	((_soc)->cluster_base_addr + 0x020 + ((_n) << 2))
+#define V1_NPU_CLUSTER_BASE		0x308000
+#define V2_NPU_CLUSTER_BASE		0x306000
+#define V1_CR_PC_BASE_ADDR		(V1_NPU_CLUSTER_BASE + 0x800)
+#define V2_CR_PC_BASE_ADDR		0x305000
+
+#define NPU_CLUSTER_BASE(_SOC)		((_SOC)->version == NPU_V1 ? V1_NPU_CLUSTER_BASE : V2_NPU_CLUSTER_BASE)
+#define CR_PC_BASE_ADDR(_SOC)		((_SOC)->version == NPU_V1 ? V1_CR_PC_BASE_ADDR : V2_CR_PC_BASE_ADDR)
+
+#define REG_PC_DBG(_SOC, _n)		(CR_PC_BASE_ADDR(_SOC) + ((_n) * 0x100))
+#define REG_CR_BOOT_TRIGGER(_SOC)	(NPU_CLUSTER_BASE(_SOC) + 0x000)
+#define REG_CR_BOOT_CONFIG(_SOC)	(NPU_CLUSTER_BASE(_SOC) + 0x004)
+#define REG_CR_BOOT_BASE(_SOC, _n)	(NPU_CLUSTER_BASE(_SOC) + 0x020 + ((_n) << 2))
 
 #define NPU_MBOX_BASE_ADDR		0x30c000
 
@@ -80,7 +88,28 @@
 #define REG_WDT_TIMER_CTRL(_n)		(NPU_TIMER_BASE_ADDR + ((_n) * 0x100))
 #define WDT_EN_MASK			BIT(25)
 #define WDT_INTR_MASK			BIT(21)
-#define AN7552_WDT_TIMER_EN_MASK	0x1e0001ef
+
+#define AN7552_WDT_TIMER_EN_MASK	0x1e0001ef /* keep enable_bits (4 cntTimers + 4 wdogTimers) */
+#define AN7581_WDT_TIMER_EN_MASK	0x2000027  /* keep enable_bits (3 cntTimers + 1 wdogTimer) */
+#define EN7523_WDT_TIMER_EN_MASK	0x2000027  /* keep enable_bits (3 cntTimers + 1 wdogTimer) */
+
+#define EN7523_CSR_REG_NUM		12
+#define AN7581_CSR_REG_NUM		3
+#define AN7552_CSR_REG_NUM		3
+
+#define V1_CSR_PC_BASE_ADDR		0x1ec08800
+#define V2_CSR_PC_BASE_ADDR		0x1ec05000
+
+#define EN7523_NPU_CORES		4
+#define AN7552_NPU_CORES		2
+#define AN7583_NPU_CORES		6
+#define AN7581_NPU_CORES		8
+#define MAX_NPU_CORES(_SOC)		((_SOC)->version == NPU_V2 ?   AN7581_NPU_CORES : \
+					 (_SOC)->version == NPU_V2_S ? AN7552_NPU_CORES : \
+					 (_SOC)->version == NPU_V2_P ? AN7583_NPU_CORES : \
+								       EN7523_NPU_CORES)
+
+#define STATIC_L2C_SRAM_SIZE(_SOC)	((_SOC)->version == NPU_V2 ? SZ_256K : SZ_128K)
 
 enum {
 	NPU_OP_SET = 1,
@@ -130,21 +159,16 @@ struct airoha_npu_fw {
 
 struct airoha_npu_soc_data {
 	enum airoha_npu_version version;
-	int max_cores;
-	int cluster_base_addr;
-	int pc_base_addr;
+
 	u32 mbox_func_mask;
-	int wdt_irq_base;
 	bool shared_wdt;
-	u16 watchdogs;
+	bool have_wdt;
+	u16 wlan_mbox_size;
 
 	struct airoha_npu_fw fw_rv32;
 	struct airoha_npu_fw fw_data;
 
 	void (*boot_core)(struct airoha_npu *npu, struct reserved_mem *rmem);
-
-	const u32 wlan_func_set[WLAN_FUNC_SET_WAIT_MAX];
-	const u32 wlan_func_get[WLAN_FUNC_GET_WAIT_MAX];
 };
 
 struct airoha_npu_priv {
@@ -281,9 +305,6 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	u32 val, offset = 0;
 	int ret;
 
-	if (len > AIROHA_NPU_MBOX_SIZE)
-		return -EINVAL;
-
 	if (reply && reply_len > len)
 		return -EINVAL;
 
@@ -291,8 +312,9 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	    !(npu->soc_data->mbox_func_mask & BIT(func_id)))
 		return -EOPNOTSUPP;
 
-	if (npu->soc_data->version == NPU_V1 && func_id > NPU_FUNC_TR471)
-		return -EOPNOTSUPP;
+	/* A mailbox request requires a coherent payload buffer. */
+	if (!core->buf)
+		return -ENODEV;
 
 	airoha_npu_debugfs_count(npu, AIROHA_NPU_DBG_MBOX_REQUESTS);
 
@@ -307,6 +329,7 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	spin_lock_bh(&core->lock);
 
 	memcpy(core->buf, data, len);
+	dma_wmb();
 
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(0) + offset, core->addr);
 	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(1) + offset, len);
@@ -637,12 +660,6 @@ static int airoha_npu_wlan_msg_send(struct airoha_npu *npu, int ifindex,
 	struct wlan_mbox_data *wlan_data;
 	int err, len;
 
-	if (func_id < 0 || func_id >= WLAN_FUNC_SET_WAIT_MAX)
-		return -EINVAL;
-	if (npu->soc_data->wlan_func_set[func_id] == WLAN_FUNC_SET_WAIT_MAX)
-		return -EOPNOTSUPP;
-	func_id = npu->soc_data->wlan_func_set[func_id];
-
 	len = sizeof(*wlan_data) + data_len;
 	wlan_data = kzalloc(len, gfp);
 	if (!wlan_data)
@@ -666,12 +683,6 @@ static int airoha_npu_wlan_msg_get(struct airoha_npu *npu, int ifindex,
 	struct wlan_mbox_data *wlan_data;
 	int err, len;
 
-	if (func_id < 0 || func_id >= WLAN_FUNC_GET_WAIT_MAX)
-		return -EINVAL;
-	if (npu->soc_data->wlan_func_get[func_id] == WLAN_FUNC_GET_WAIT_MAX)
-		return -EOPNOTSUPP;
-	func_id = npu->soc_data->wlan_func_get[func_id];
-
 	len = sizeof(*wlan_data) + data_len;
 	wlan_data = kzalloc(len, gfp);
 	if (!wlan_data)
@@ -820,7 +831,7 @@ static int airoha_npu_debugfs_status_show(struct seq_file *m, void *private)
 
 	seq_printf(m, "device: %s\n", dev_name(npu->dev));
 	seq_printf(m, "npu_interface: v%u\n", npu->soc_data->version + 1);
-	seq_printf(m, "cores: %d\n", npu->soc_data->max_cores);
+	seq_printf(m, "cores: %d\n", MAX_NPU_CORES(npu->soc_data));
 	if (dbg->fw_version_valid)
 		seq_printf(m, "firmware: v%u.%u (0x%08x)\n",
 			   dbg->fw_version >> 16, dbg->fw_version & 0xffff,
@@ -928,7 +939,7 @@ static int airoha_npu_debugfs_registers_show(struct seq_file *m,
 				      REG_CR_BOOT_TRIGGER(npu->soc_data));
 	airoha_npu_debugfs_print_reg(m, npu, "BOOT_CONFIG",
 				      REG_CR_BOOT_CONFIG(npu->soc_data));
-	for (i = 0; i < npu->soc_data->max_cores; i++) {
+	for (i = 0; i < MAX_NPU_CORES(npu->soc_data); i++) {
 		snprintf(name, sizeof(name), "CORE%d_BOOT_BASE", i);
 		airoha_npu_debugfs_print_reg(m, npu, name,
 					      REG_CR_BOOT_BASE(npu->soc_data, i));
@@ -1164,7 +1175,7 @@ static int airoha_npu_debugfs_json_show(struct seq_file *m, void *private)
 	airoha_npu_debugfs_json_string(m, dev_name(npu->dev));
 	seq_printf(m, ",\n  \"interface\": {\"version\": %u, "
 		   "\"cores\": %d},\n  \"firmware\": ",
-		   npu->soc_data->version + 1, npu->soc_data->max_cores);
+		   npu->soc_data->version, MAX_NPU_CORES(npu->soc_data));
 	if (dbg->fw_version_valid)
 		seq_printf(m, "{\"major\": %u, \"minor\": %u, "
 			   "\"raw\": %u, \"raw_hex\": \"0x%08x\"}",
@@ -1272,7 +1283,7 @@ static int airoha_npu_debugfs_json_show(struct seq_file *m, void *private)
 				    REG_CR_BOOT_TRIGGER(npu->soc_data), &first);
 	airoha_npu_debugfs_json_reg(m, npu, "BOOT_CONFIG",
 				    REG_CR_BOOT_CONFIG(npu->soc_data), &first);
-	for (i = 0; i < npu->soc_data->max_cores; i++) {
+	for (i = 0; i < MAX_NPU_CORES(npu->soc_data); i++) {
 		snprintf(name, sizeof(name), "CORE%d_BOOT_BASE", i);
 		airoha_npu_debugfs_json_reg(m, npu, name,
 					    REG_CR_BOOT_BASE(npu->soc_data, i),
@@ -1435,6 +1446,10 @@ struct airoha_npu *airoha_npu_get(struct device *dev)
 	if (!np)
 		return ERR_PTR(-ENODEV);
 
+	if (!of_device_is_available(np)) {
+		of_node_put(np);
+		return ERR_PTR(-ENODEV);
+	}
 	pdev = of_find_device_by_node(np);
 
 	if (!pdev) {
@@ -1450,6 +1465,7 @@ struct airoha_npu *airoha_npu_get(struct device *dev)
 		goto error_pdev_put;
 	}
 
+	device_lock(&pdev->dev);
 	npu = platform_get_drvdata(pdev);
 	if (!npu) {
 		npu = ERR_PTR(-EPROBE_DEFER);
@@ -1470,9 +1486,11 @@ struct airoha_npu *airoha_npu_get(struct device *dev)
 		goto error_module_put;
 	}
 
+	device_unlock(&pdev->dev);
 	return npu;
 
 error_module_put:
+	device_unlock(&pdev->dev);
 	module_put(THIS_MODULE);
 error_pdev_put:
 	platform_device_put(pdev);
@@ -1495,7 +1513,7 @@ static void airoha_boot_core_v1(struct airoha_npu *npu,
 	int core;
 
 	/* setting booting address */
-	for (core = 0; core < npu->soc_data->max_cores; core++) {
+	for (core = 0; core < MAX_NPU_CORES(npu->soc_data); core++) {
 		regmap_write(npu->regmap, REG_CR_BOOT_BASE(npu->soc_data, core), rmem->base);
 		usleep_range(1000, 2000);
 
@@ -1520,13 +1538,13 @@ static void airoha_boot_core_v2(struct airoha_npu *npu,
 	int i;
 
 	/* setting booting address */
-	for (i = 0; i < npu->soc_data->max_cores; i++)
+	for (i = 0; i < MAX_NPU_CORES(npu->soc_data); i++)
 		regmap_write(npu->regmap, REG_CR_BOOT_BASE(npu->soc_data, i), rmem->base);
 	usleep_range(1000, 2000);
 
 	/* enable NPU cores */
 	regmap_write(npu->regmap, REG_CR_BOOT_CONFIG(npu->soc_data),
-		     GENMASK(npu->soc_data->max_cores - 1, 0));
+		     GENMASK(MAX_NPU_CORES(npu->soc_data) - 1, 0));
 	regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER(npu->soc_data), 0x1);
 	msleep(100);
 }
@@ -1547,287 +1565,6 @@ static int sram_size_of_l2c(struct regmap *scuclk)
 	return val;
 }
 
