-		int j;
-
+		port = eth->ports[i];
 		if (!port)
 			continue;
 
 		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
-			struct airoha_gdm_dev *dev = port->devs[j];
-			int err;
-
+			dev = port->devs[j];
 			if (!dev)
 				continue;
 
-			err = register_netdev(netdev_from_priv(dev));
+			netdev = netdev_from_priv(dev);
