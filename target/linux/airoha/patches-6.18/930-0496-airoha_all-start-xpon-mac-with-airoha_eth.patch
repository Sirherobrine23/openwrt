 			if (err)
 				return err;
 
@@ -10840,7 +10776,45 @@ static int airoha_register_gdm_devices(struct airoha_eth *eth)
 
 	set_bit(DEV_STATE_REGISTERED, &eth->state);
 
-	return 0;
+	port = eth->ports[AIROHA_GDM2_IDX - 1];
+	if (!port || !port->devs[0])
