From d6eccb17d1a5dcd44791599a587848fd282b96e5 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 27 Oct 2026 17:35:32 -0300
Subject: [PATCH] mips: airoha: update dts

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 arch/mips/boot/dts/econet/en751627.dtsi |  1 -
 arch/mips/boot/dts/econet/en7528.dtsi   | 17 ++++++++++-------
 arch/mips/boot/dts/econet/en7580.dtsi   |  1 -
 3 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/arch/mips/boot/dts/econet/en751627.dtsi b/arch/mips/boot/dts/econet/en751627.dtsi
--- a/arch/mips/boot/dts/econet/en751627.dtsi
+++ b/arch/mips/boot/dts/econet/en751627.dtsi
@@ -19,7 +19,6 @@ / {
 
 	chosen {
 		stdout-path = "serial0:115200n8";
-		linux,usable-memory-range = <0x00020000 0x1fe00000>;
 	};
 
 	aliases {
diff --git a/arch/mips/boot/dts/econet/en7528.dtsi b/arch/mips/boot/dts/econet/en7528.dtsi
--- a/arch/mips/boot/dts/econet/en7528.dtsi
+++ b/arch/mips/boot/dts/econet/en7528.dtsi
@@ -19,7 +19,6 @@ / {
 
 	chosen {
 		stdout-path = "serial0:115200n8";
-		linux,usable-memory-range = <0x00020000 0x1fe00000>;
 	};
 
 	aliases {
@@ -228,16 +227,16 @@ pinctrl: pinctrl {
 				gpio-ranges = <&pinctrl 0 0 42>;
 
 				pcie0_rst_pins: pcie0-rst-pins {
-					conf {
-						pins = "pcie_reset0";
-						drive-open-drain = <1>;
+					mux {
+						function = "pcie_reset";
+						groups = "pcie_reset0";
 					};
 				};
 
 				pcie1_rst_pins: pcie1-rst-pins {
-					conf {
-						pins = "pcie_reset1";
-						drive-open-drain = <1>;
+					mux {
+						function = "pcie_reset";
+						groups = "pcie_reset1";
 					};
 				};
 
@@ -591,6 +590,8 @@ pcie0: pcie@1fb81000 {
 			clock-names = "sys_ck0";
 			phys = <&pcie_phy0>;
 			phy-names = "pcie-phy0";
+			pinctrl-names = "default";
+			pinctrl-0 = <&pcie0_rst_pins>;
 			bus-range = <0x00 0xff>;
 			ranges = <0x01000000 0 0x00000000 0x1f600000 0 0x00010000>,
 				 <0x82000000 0 0x20000000 0x20000000 0 0x08000000>;
@@ -631,6 +632,8 @@ pcie1: pcie@1fb83000 {
 			clock-names = "sys_ck1";
 			phys = <&pcie_phy1>;
 			phy-names = "pcie-phy1";
+			pinctrl-names = "default";
+			pinctrl-0 = <&pcie1_rst_pins>;
 			bus-range = <0x00 0xff>;
 			ranges = <0x01000000 0 0x00000000 0x1f610000 0 0x00010000>,
 				 <0x82000000 0 0x28000000 0x28000000 0 0x08000000>;
diff --git a/arch/mips/boot/dts/econet/en7580.dtsi b/arch/mips/boot/dts/econet/en7580.dtsi
--- a/arch/mips/boot/dts/econet/en7580.dtsi
+++ b/arch/mips/boot/dts/econet/en7580.dtsi
@@ -19,7 +19,6 @@ / {
 
 	chosen {
 		stdout-path = "serial0:115200n8";
-		linux,usable-memory-range = <0x00020000 0x1fe00000>;
 	};
 
 	aliases {

