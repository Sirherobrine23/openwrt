From 48758d4fa5bb67cc37da25048af40107feaa821d Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 30 Oct 2026 00:52:18 -0300
Subject: [PATCH] net: omci: prepare for xdsl line

---
 include/net/xpon/omci.h     |  41 +++++
 include/uapi/linux/omci.h   |  36 ++++-
 net/xpon/Kconfig            |  17 +-
 net/xpon/omci/.kunitconfig  |   7 +
 net/xpon/omci/Makefile      |   3 +-
 net/xpon/omci/access.c      | 310 +++++++++++++++++++++++++++++++++++++
 net/xpon/omci/access_test.c | 370 ++++++++++++++++++++++++++++++++++++++++++++
 net/xpon/omci/core.c        |  58 +++++++
 net/xpon/omci/internal.h    |  19 +++
 9 files changed, 857 insertions(+), 4 deletions(-)

diff --git a/include/net/xpon/omci.h b/include/net/xpon/omci.h
--- a/include/net/xpon/omci.h
+++ b/include/net/xpon/omci.h
@@ -7,10 +7,51 @@
 #include <uapi/linux/omci.h>
 
 struct device;
+struct net_device;
 struct omci_device;
+struct omci_line;
 struct xpon_device;
 struct sk_buff;
 
+/**
+ * struct omci_line_status - technology-neutral access state
+ * @access: enum omci_access_type (the currently selected technology)
+ * @state: enum omci_line_state
+ * @flags: OMCI_LINE_F_*; unknown rates must not set RATES_VALID
+ * @downstream_bps: downstream line rate, in bits per second
+ * @upstream_bps: upstream line rate, in bits per second
+ */
+struct omci_line_status {
+	u8 access;
+	u8 state;
+	u32 flags;
+	u64 downstream_bps;
+	u64 upstream_bps;
+};
+
+/**
+ * struct omci_line_ops - local access management, independent of OMCC
+ * @get_status: fill a coherent snapshot; may sleep
+ * @retrain: optional DSL retrain request; may sleep, must return real errors
+ *
+ * Callbacks are serialized with each other and with unregister. They must
+ * not register/unregister a line or call the line registry recursively.
+ * Netlink calls hold RTNL; callbacks must not acquire RTNL themselves.
+ * The provider must unregister before freeing @priv or unloading its code.
+ */
+struct omci_line_ops {
+	int (*get_status)(void *priv, struct omci_line_status *status);
+	int (*retrain)(void *priv);
+};
+
+/* Registering a local DSL line does not instantiate an ONU or OMCC. */
+struct omci_line *omci_line_register(struct device *parent,
+				     struct net_device *netdev,
+				     const struct omci_line_ops *ops,
+				     void *priv);
+void omci_line_unregister(struct omci_line *line);
+u32 omci_line_id(const struct omci_line *line);
+
 #define OMCI_IDENTITY_F_SERIAL_NUMBER	BIT(0)
 #define OMCI_IDENTITY_F_VENDOR_ID	BIT(1)
 #define OMCI_IDENTITY_F_PASSWORD	BIT(2)
diff --git a/include/uapi/linux/omci.h b/include/uapi/linux/omci.h
--- a/include/uapi/linux/omci.h
+++ b/include/uapi/linux/omci.h
@@ -3,7 +3,7 @@
 #define _UAPI_LINUX_OMCI_H
 
 #define OMCI_GENL_NAME		"omci"
-#define OMCI_GENL_VERSION	14
+#define OMCI_GENL_VERSION	15
 #define OMCI_MAX_PDU_LEN	1980
 #define OMCI_MAX_ATTR_DATA	64
 #define OMCI_MAX_CONFIG_VALUE	64
@@ -41,6 +41,9 @@ enum omci_cmd {
 	OMCI_CMD_MIB_NEXT,
 	OMCI_CMD_CLASS_GET,
 	OMCI_CMD_CLASS_NEXT,
+	/* Local access management; these commands do not send OMCI PDUs. */
+	OMCI_CMD_LINE_GET,
+	OMCI_CMD_LINE_RETRAIN,
 
 	__OMCI_CMD_MAX,
 };
@@ -112,12 +115,43 @@ enum omci_attr {
 	OMCI_ATTR_AGENT_OPERATIONAL,
 	OMCI_ATTR_AGENT_DYING_GASP,
 	OMCI_ATTR_ONU_TYPE,
+	OMCI_ATTR_LINE_ID,		/* u32, separate from OMCI_ATTR_DEV_ID */
+	OMCI_ATTR_ACCESS_TYPE,		/* u8, enum omci_access_type */
+	OMCI_ATTR_LINE_STATE,		/* u8, enum omci_line_state */
+	OMCI_ATTR_LINE_FLAGS,		/* u32, OMCI_LINE_F_* */
+	OMCI_ATTR_DOWNSTREAM_BPS,		/* u64, only when RATES_VALID */
+	OMCI_ATTR_UPSTREAM_BPS,		/* u64, only when RATES_VALID */
+	OMCI_ATTR_LINE_CAPABILITIES,	/* u32, OMCI_LINE_CAP_* */
 
 	__OMCI_ATTR_MAX,
 };
 
 #define OMCI_ATTR_MAX (__OMCI_ATTR_MAX - 1)
 
+/* Access technology is independent of the OMCI PDU framing format. */
+enum omci_access_type {
+	OMCI_ACCESS_UNSPEC,
+	OMCI_ACCESS_GPON,
+	OMCI_ACCESS_XGPON,
+	OMCI_ACCESS_XGSPON,
+	OMCI_ACCESS_XDSL,
+};
+
+enum omci_line_state {
+	OMCI_LINE_UNKNOWN,
+	OMCI_LINE_UNAVAILABLE,	/* e.g. no reconstructed DSL line engine */
+	OMCI_LINE_DOWN,
+	OMCI_LINE_TRAINING,
+	OMCI_LINE_UP,
+};
+
+#define OMCI_LINE_F_STARTED	(1U << 0)
+#define OMCI_LINE_F_CARRIER	(1U << 1)
+#define OMCI_LINE_F_RATES_VALID	(1U << 2)
+
+#define OMCI_LINE_CAP_OMCC	(1U << 0)
+#define OMCI_LINE_CAP_RETRAIN	(1U << 1)
+
 /**
  * enum omci_vlan_filter_attr - VLAN tagging filter data attributes
  *
diff --git a/net/xpon/Kconfig b/net/xpon/Kconfig
--- a/net/xpon/Kconfig
+++ b/net/xpon/Kconfig
@@ -31,12 +31,25 @@ config XPON_PLOAM_KUNIT_TEST
 	  Say Y here to run these tests at boot, or M to build a test module.
 
 config XPON_OMCI
-	tristate "xPON OMCI agent"
+	tristate "xPON OMCI agent and access line management"
 	default y
 	help
 	  In-kernel ONU Management and Control Interface agent used by GPON and
 	  XGS-PON providers. The protocol implementation is owned by the xPON
-	  subsystem and is attached to one xPON device.
+	  subsystem and is attached to one xPON device. The same Netlink family
+	  also exposes local access line status for GPON, XG-PON, XGS-PON and
+	  xDSL. Local xDSL management does not require an optical device or
+	  create an OMCI transport over a copper line.
+
+config XPON_OMCI_ACCESS_KUNIT_TEST
+	bool "OMCI access line tests" if !KUNIT_ALL_TESTS
+	depends on KUNIT=y && XPON_OMCI=y
+	default KUNIT_ALL_TESTS
+	help
+	  Test line registration, removal, provider errors, PON mode reporting
+	  and retrain dispatch without DSL or optical hardware.
+	  Also verify 64-bit rate encoding and that removal waits for an
+	  in-flight management callback before releasing provider storage.
 
 config XPON_OMCI_KUNIT_TEST
 	bool "OMCI service reconciliation tests" if !KUNIT_ALL_TESTS
