-		cfg.cookie = cookie;
-		KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
-	}
-	/* Replaying an existing cookie in a full bucket must not spill. */
-	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
-	KUNIT_EXPECT_EQ(test, airoha_service_count(table), 1U);
