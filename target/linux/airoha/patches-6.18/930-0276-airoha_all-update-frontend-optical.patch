-#endif
-
-static int __init airoha_lddla_init(void)
-{
-	int ret = 0;
-
-#if IS_ENABLED(CONFIG_EN7570_PHY)
-	ret = i2c_add_driver(&en7570_i2c_driver);
-	if (ret)
-		return ret;
