From b32c21f0cc342ef0ed66cf2efdcc0a8f48c3a582 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 7 Oct 2026 23:04:13 -0300
Subject: [PATCH] dt-bindings: net: describe the EN7580 XGS-PON MAC

Describe the EN7580 10G MAC independently of the legacy GPON register
layout. Limit its WAN mode to XGS-PON and require explicit reset, SCU
and GDM2 resources; newer ARM SoCs do not use this compatible.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../bindings/net/airoha,en7523-xpon.yaml           |  12 ---
 .../bindings/net/airoha,en7580-xpon.yaml           | 109 +++++++++++++++++++++
 MAINTAINERS                                        |   1 +
 3 files changed, 110 insertions(+), 12 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
--- a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
@@ -85,13 +85,6 @@ properties:
     description:
       Phandle to the SoC SCU syscon used to select GPON or EPON mode.
 
-  airoha,pon-mode:
-    description:
-      Protocol engine selected for a unified *-xpon compatible. The property
-      is optional and defaults to GPON. Legacy mode-specific compatibles do
-      not require it.
-    enum: [gpon, epon]
-
   airoha,gpon-serial-number:
     deprecated: true
     $ref: /schemas/types.yaml#/definitions/uint8-array
@@ -176,14 +169,10 @@ allOf:
         - phy-names
         - resets
         - reset-names
-      properties:
-        airoha,pon-mode: true
     else:
       required:
         - phys
         - phy-names
-      properties:
-        airoha,pon-mode: false
   - if:
       properties:
         compatible:
@@ -218,7 +207,6 @@ examples:
         resets = <&scuclk EN7523_XPON_MAC_RST>;
         reset-names = "mac";
         airoha,scu = <&scuclk>;
-        airoha,pon-mode = "gpon";
         airoha,gpon-serial-number = [49 4e 56 50 71 43 86 02];
         airoha,gpon-password = [30 30 31 34 34 35 31 38 33 30];
         phys = <&xpon_phy>;
diff --git a/Documentation/devicetree/bindings/net/airoha,en7580-xpon.yaml b/Documentation/devicetree/bindings/net/airoha,en7580-xpon.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/airoha,en7580-xpon.yaml
@@ -0,0 +1,109 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/airoha,en7580-xpon.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha EN7580 XGS-PON MAC
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  The MIPS EN7580 contains a 10G PON MAC engine at offset 0x5000 in the
+  shared xPON region at 0x1fb60000. Its register layout, PLOAM format and
+  activation protocol differ from the older GPON engine at offset 0x4000.
+  The EN7580 WAN selector uses 0x0a for XGS-PON. This compatible describes
+  only EN7580; it is not a fallback for AN7581 or AN7583.
+
+properties:
+  compatible:
+    const: airoha,en7580-xpon
+
+  reg:
+    maxItems: 1
+    description: Shared xPON register region, including the entire 10G MAC.
+
+  reg-names:
+    const: mac
+
+  interrupts:
+    minItems: 1
+    maxItems: 2
+
+  interrupt-names:
+    minItems: 1
+    items:
+      - const: mac
+      - const: dying-gasp
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: mac
+
+  airoha,scu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: System controller containing the WAN mode selector.
+
+  ethernet:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: GDM2 Ethernet datapath associated with this MAC.
+
+  phys:
+    maxItems: 1
+    description: Digital PON PHY used for optical link operation.
+
+  phy-names:
+    const: xpon
+
+  sfp:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Pluggable optical module or cage.
+
+  optical-frontends:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    maxItems: 1
+
+  optical-frontend-names:
+    items:
+      - const: pon
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - resets
+  - reset-names
+  - airoha,scu
+  - ethernet
+
+dependencies:
+  interrupts: [interrupt-names]
+  interrupt-names: [interrupts]
+  phys: [phy-names]
+  phy-names: [phys]
+  optical-frontends: [optical-frontend-names]
+  optical-frontend-names: [optical-frontends]
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/mips-gic.h>
+    #include <dt-bindings/reset/econet,en7580-scu.h>
+
+    xmac@1fb60000 {
+        compatible = "airoha,en7580-xpon";
+        reg = <0x1fb60000 0x10000>;
+        reg-names = "mac";
+        interrupts = <GIC_SHARED 26 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SHARED 18 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "mac", "dying-gasp";
+        resets = <&scuclk EN7580_XPON_MAC_RST>;
+        reset-names = "mac";
+        airoha,scu = <&scuclk>;
+        ethernet = <&gdm2>;
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -753,6 +753,7 @@ L:	linux-mediatek@lists.infradead.org (moderated for non-subscribers)
 L:	netdev@vger.kernel.org
 S:	Maintained
 F:	Documentation/devicetree/bindings/net/airoha,en7523-wed.yaml
