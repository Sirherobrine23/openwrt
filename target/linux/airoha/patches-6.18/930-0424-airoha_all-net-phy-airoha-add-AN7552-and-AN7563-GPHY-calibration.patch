+		127, 126, 122, 117, 112, 109, 104, 101, 97, 94, 90, 88, 84, 80, 78, 74,
+		72, 68, 66, 64, 61, 58, 56, 53, 51, 48, 47, 44, 42, 40, 38, 36,
