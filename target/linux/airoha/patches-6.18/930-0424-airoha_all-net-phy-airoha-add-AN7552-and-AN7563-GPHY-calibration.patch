+		[TX_AMP_1G_C] = { 4, 4, 1, 2 },
+		[TX_AMP_1G_D] = { 3, 3, 1, 2 },
+		[TX_AMP_100M_A] = { 17, 17, 16, 15 },
+		[TX_AMP_100M_B] = { 17, 15, 14, 18 },
+		[TX_AMP_10M_A] = { 22, 22, 22, 23 },
+		[TX_AMP_10M_B] = { 22, 22, 22, 23 },
+		[R50_A] = { 0, 0, 0, 0 },
+		[R50_B] = { 0, 0, 0, 0 },
+		[R50_C] = { 0, 0, 0, 0 },
