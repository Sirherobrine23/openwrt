+	{ MDIO_MMD_VEND1, 0x00e7, 0x5555 },
+	{ MDIO_MMD_VEND1, 0x00e9, 0x0001 },
+	{ MDIO_MMD_VEND1, 0x00fe, 0x0000 },
+	{ MDIO_MMD_VEND1, 0x00e6, 0x1111 },
