From 1a746f68b742f2ef91d46fa1b4a11a648146a20c Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sun, 25 Oct 2026 15:37:01 -0300
Subject: [PATCH] dt-bindings: net: airoha: describe the AN7552 GPON/EPON MAC

Add the native AN7552 MAC compatible and require its dedicated interrupt
and reset resources, as used by the existing an7552.dtsi. This describes
the 1G protocol MAC; it does not add a PHY/PMA bring-up sequence.

Signed-off-by: Codex <codex@openai.com>
Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
--- a/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7523-xpon.yaml
@@ -10,8 +10,8 @@ maintainers:
   - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
 
 description: |
-  The Airoha EN7523/EN7528 and EcoNet EN751221/EN7521 families contain one xPON
-  MAC complex shared by the GPON and EPON protocol engines. Both generations
+  The Airoha AN7552/EN7523/EN7528 and EcoNet EN751221/EN7521 families contain
+  one xPON MAC complex shared by the GPON and EPON protocol engines. Both generations
   use GDM2/CDM2 as the packet datapath and expose the xPON register region at
   0x1fb60000, with GPON at offset 0x4000 and EPON at offset 0x6000.
 
@@ -23,6 +23,7 @@ properties:
   compatible:
     oneOf:
       - enum:
+          - airoha,an7552-xpon
           - airoha,en7523-xpon
           - airoha,en751627-xpon
           - airoha,en7528-xpon
@@ -157,6 +158,7 @@ allOf:
       properties:
         compatible:
           enum:
+            - airoha,an7552-xpon
             - airoha,en7523-xpon
             - airoha,en751627-xpon
             - airoha,en7528-xpon
@@ -177,6 +179,7 @@ allOf:
       properties:
         compatible:
           enum:
+            - airoha,an7552-xpon
             - airoha,en7523-xpon
             - airoha,en751627-xpon
             - airoha,en7528-xpon

