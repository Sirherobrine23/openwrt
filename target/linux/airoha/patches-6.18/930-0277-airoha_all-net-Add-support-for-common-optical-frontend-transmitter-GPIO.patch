-	seq_printf(s, "ddmi bias:   0x%04x\n", lddla->ddmi_current);
-	seq_printf(s, "ddmi tx_pwr: 0x%04x\n", lddla->ddmi_tx_power);
-	seq_printf(s, "ddmi rx_pwr: 0x%04x\n", lddla->ddmi_rx_power);
