-	u16 p = priv->lddla.ddmi_rx_power;
-
-	en7571_alarm_set(priv, AIROHA_ALARM_RX_LOW_POWER, p < EN7571_RX_PWR_LOW_THLD);
-	en7571_alarm_set(priv, AIROHA_ALARM_RX_HIGH_POWER, p > EN7571_RX_PWR_HIGH_THLD);
-}
