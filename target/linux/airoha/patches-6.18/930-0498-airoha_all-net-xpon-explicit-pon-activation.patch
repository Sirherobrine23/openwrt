From a0539a55efa0848176f2ada66d348be8b8da3f1d Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 17 Nov 2026 22:37:43 -0300
Subject: [PATCH] net: xpon: explicit pon activation

---
 drivers/net/ethernet/airoha/airoha_eth.c   |   5 +-
 drivers/net/ethernet/airoha/airoha_omci.c  |  35 +---
 drivers/net/ethernet/airoha/airoha_omci.h  |  11 +-
 drivers/net/ethernet/airoha/airoha_ploam.c |   9 +-
 drivers/net/ethernet/airoha/airoha_ploam.h |   7 +-
 drivers/net/ethernet/airoha/airoha_xpon.c  | 249 ++++++++++++-----------------
 drivers/net/ethernet/airoha/airoha_xpon.h  |  10 +-
 include/net/xpon.h                         |  21 +++
 include/net/xpon/omci.h                    |   3 +-
 include/uapi/linux/xpon.h                  |   8 +
 net/xpon/Makefile                          |   2 +-
 net/xpon/activation.c                      | 231 ++++++++++++++++++++++++++
 net/xpon/core.c                            |  13 ++
 net/xpon/genl.c                            |  66 +++++++-
 net/xpon/internal.h                        |  18 +++
 net/xpon/omci/core.c                       |  23 ++-
 net/xpon/sysfs.c                           |  73 ++++++++-
 net/xpon/tests.c                           |  55 +++++++
 net/xpon/uni.c                             |   4 +-
 19 files changed, 629 insertions(+), 214 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -5070,9 +5070,8 @@ static int econet_xpon_control_start(struct net_device *netdev)
 		goto out;
 	}
 
-	/* OMCI activation is allowed while pon0 is administratively down. Keep
-	 * QDMA1 alive independently from ndo_open(), mirroring the vendor WAN
-	 * QDMA control-plane ownership.
+	/* Keep QDMA1 available for the PON control plane independently of
+	 * ndo_open(). The xPON core gates protocol activation and OMCI.
 	 */
 	airoha_qdma_start(port->qdma);
 	port->xpon_control_started = true;
diff --git a/drivers/net/ethernet/airoha/airoha_omci.c b/drivers/net/ethernet/airoha/airoha_omci.c
--- a/drivers/net/ethernet/airoha/airoha_omci.c
+++ b/drivers/net/ethernet/airoha/airoha_omci.c
@@ -16,20 +16,6 @@
 #include "airoha_eth.h"
 #include "airoha_omci.h"
 
-static int airoha_gpon_omci_start_transport(struct omci_device *odev)
-{
-	struct airoha_gpon_omci *omci = omci_device_priv(odev);
-
-	return omci->hw_ops->start(omci->hw_priv);
-}
-
-static void airoha_gpon_omci_stop_transport(struct omci_device *odev)
-{
-	struct airoha_gpon_omci *omci = omci_device_priv(odev);
-
-	omci->hw_ops->stop(omci->hw_priv);
-}
-
 static int airoha_gpon_omci_xmit(struct omci_device *odev,
 				 struct sk_buff *skb, u16 gem_port_id)
 {
@@ -159,13 +145,11 @@ int airoha_gpon_omci_register(struct airoha_gpon_omci *omci,
 	u32 capabilities = OMCI_CAP_HW_MIC;
 	int ret;
 
-	if (!hw_ops || !hw_ops->start || !hw_ops->stop || !hw_ops->xmit)
+	if (!hw_ops || !hw_ops->xmit)
 		return -EINVAL;
 	omci->hw_ops = hw_ops;
 	omci->hw_priv = hw_priv;
 	omci->ops = (struct omci_device_ops) {
-		.start = airoha_gpon_omci_start_transport,
-		.stop = airoha_gpon_omci_stop_transport,
 		.xmit = airoha_gpon_omci_xmit,
 		.get_ani_topology = hw_ops->get_ani_topology ?
 			airoha_gpon_omci_get_ani_topology : NULL,
@@ -197,8 +181,11 @@ int airoha_gpon_omci_register(struct airoha_gpon_omci *omci,
 	omci->odev = omci_device_register(xpon,
 					  capabilities,
 					  &omci->ops, omci);
-	if (IS_ERR(omci->odev))
-		return PTR_ERR(omci->odev);
+	if (IS_ERR(omci->odev)) {
+		ret = PTR_ERR(omci->odev);
+		omci->odev = NULL;
+		return ret;
+	}
 
 	omci_device_set_identity_info(omci->odev, identity);
 	ret = omci_device_set_dying_gasp_enabled(omci->odev, true,
@@ -211,16 +198,6 @@ int airoha_gpon_omci_register(struct airoha_gpon_omci *omci,
 	return ret;
 }
 
-int airoha_gpon_omci_start(struct airoha_gpon_omci *omci)
-{
-	return omci_device_start(omci->odev);
-}
-
-void airoha_gpon_omci_stop(struct airoha_gpon_omci *omci)
-{
-	omci_device_stop(omci->odev);
-}
-
 void airoha_gpon_omci_unregister(struct airoha_gpon_omci *omci)
 {
 	omci_device_unregister(omci->odev);
diff --git a/drivers/net/ethernet/airoha/airoha_omci.h b/drivers/net/ethernet/airoha/airoha_omci.h
--- a/drivers/net/ethernet/airoha/airoha_omci.h
+++ b/drivers/net/ethernet/airoha/airoha_omci.h
@@ -17,13 +17,10 @@ struct omci_service_config;
 struct sk_buff;
 struct xpon_device;
 
-/* MAC operations are passed in by the provider, keeping the common OMCI
- * module independent of the driver that uses it. start/stop/xmit are required;
- * absent provisioning callbacks remain unsupported by the shared agent.
+/* MAC operations are passed in by the provider. The MAC and control QDMA
+ * lifecycle is independent of the OMCI agent; xmit is required.
  */
 struct airoha_gpon_omci_hw_ops {
-	int (*start)(void *priv);
-	void (*stop)(void *priv);
 	int (*xmit)(void *priv, struct sk_buff *skb, u16 port_id);
 	int (*get_ani_topology)(void *priv, struct omci_ani_topology *topology);
 	int (*set_tcont)(void *priv, u16 entity_id, u16 alloc_id, bool valid);
@@ -53,8 +50,6 @@ int airoha_gpon_omci_register(struct airoha_gpon_omci *omci,
 			      const struct airoha_gpon_omci_hw_ops *hw_ops,
 			      void *hw_priv,
 			      const struct omci_identity *identity, bool has_tod);
-int airoha_gpon_omci_start(struct airoha_gpon_omci *omci);
-void airoha_gpon_omci_stop(struct airoha_gpon_omci *omci);
 void airoha_gpon_omci_unregister(struct airoha_gpon_omci *omci);
 void airoha_gpon_omci_set_onu_id(struct airoha_gpon_omci *omci, u16 onu_id);
 void airoha_gpon_omci_set_channel(struct airoha_gpon_omci *omci,
@@ -68,8 +63,6 @@ bool airoha_gpon_omci_receive(void *data, struct sk_buff *skb, u8 channel,
 
 int airoha_gpon_omci_hw_get_ani_topology(void *hw_priv,
 					 struct omci_ani_topology *topology);
-int airoha_gpon_omci_hw_start(void *hw_priv);
-void airoha_gpon_omci_hw_stop(void *hw_priv);
 int airoha_gpon_omci_hw_set_tcont(void *hw_priv, u16 entity_id,
 				  u16 alloc_id, bool valid);
 int airoha_gpon_omci_hw_set_gem_port(void *hw_priv, u16 entity_id,
diff --git a/drivers/net/ethernet/airoha/airoha_ploam.c b/drivers/net/ethernet/airoha/airoha_ploam.c
--- a/drivers/net/ethernet/airoha/airoha_ploam.c
+++ b/drivers/net/ethernet/airoha/airoha_ploam.c
@@ -274,8 +274,9 @@ static void handle_upstream_overhead(struct ploam_priv *pp,
 	delay_mode = (c[7] >> 5) & 1;
 	delay_time = ((u16)c[8] << 8) | c[9];
 
-	pp->ops->set_overhead(pp->hw_priv, c[0], c[1], c[2], c[3],
-			      delim, delay_mode, delay_time);
+	if (pp->ops->set_overhead(pp->hw_priv, c[0], c[1], c[2], c[3],
+				  delim, delay_mode, delay_time))
+		return;
 	ploam_set_state(pp, GPON_O3_SERIAL_NUMBER);
 }
 
@@ -737,8 +738,8 @@ void ploam_handle_downstream(struct ploam_priv *pp,
 
 void ploam_notify_dying_gasp(struct ploam_priv *pp)
 {
-	/* An ONU in emergency stop must not transmit at all. */
-	if (pp->state >= GPON_O2_STANDBY &&
+	/* O1/O2 have no upstream registration; O7 forbids transmission. */
+	if (pp->state >= GPON_O3_SERIAL_NUMBER &&
 	    pp->state != GPON_O7_EMERGENCY_STOP)
 		ploam_send_dying_gasp(pp);
 }
diff --git a/drivers/net/ethernet/airoha/airoha_ploam.h b/drivers/net/ethernet/airoha/airoha_ploam.h
--- a/drivers/net/ethernet/airoha/airoha_ploam.h
+++ b/drivers/net/ethernet/airoha/airoha_ploam.h
@@ -67,6 +67,7 @@ airoha_ploam_encode(struct airoha_ploam_msg *raw,
  *   PLOAM. guard_bits is the raw message value (PHY_TX_EN_BIT_LEN_CONST=24
  *   should be written to G_PLOu_GUARD_BIT). t1/t2/t3 go to G_PLOu_PRMBL_*,
  *   delim/delay_mode/delay_time go to the PHY and G_PRE_ASSIGNED_DLY.
+ *   Return an error to hold O2, including when activation is not authorized.
  * @set_t3_preamble: program G_PLOu_PRMBL_TYPE3 from Extended_Burst_Length.
  * @set_key_switch_time: write the AES key-switch superframe counter to
  *   G_AES_CFG so the shadow key becomes active at the OLT-specified frame.
@@ -88,9 +89,9 @@ struct ploam_ops {
 	void (*set_eqd_o4)(void *priv, u32 byte_delay, u32 bit_delay);
 	void (*adjust_eqd_o5)(void *priv, u32 new_eqd);
 	void (*enable_us_fec)(void *priv);
-	void (*set_overhead)(void *priv, u8 guard_bits, u8 t1_pbits, u8 t2_pbits,
-			     u8 t3_pbits, const u8 delim[3],
-			     bool delay_mode, u16 delay_time);
+	int (*set_overhead)(void *priv, u8 guard_bits, u8 t1_pbits, u8 t2_pbits,
+			    u8 t3_pbits, const u8 delim[3],
+			    bool delay_mode, u16 delay_time);
 	void (*set_t3_preamble)(void *priv, u8 o3_t3, u8 o5_t3);
 	void (*set_key_switch_time)(void *priv, u32 superframe);
 	void (*request_new_key)(void *priv);
diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -1049,7 +1049,6 @@ static int gpon_load_credentials(struct xpon_priv *priv)
 
 	if (!(identity->valid & OMCI_IDENTITY_F_SERIAL_NUMBER)) {
 		gpon_random_serial_number(airoha_default_vendor_id, identity);
-		priv->identity_hold = true;
 		dev_warn(
 			priv->dev,
 			"GPON serial number missing; generated random development serial %8phN\n",
@@ -1721,15 +1720,20 @@ static void gpon_cb_enable_us_fec(void *hw_priv)
 	gpon_set_bits(priv, GPON_GBL_CFG, GBL_CFG_US_FEC_EN);
 }
 
-static void gpon_cb_set_overhead(void *hw_priv, u8 guard_bits, u8 t1_pbits,
-				 u8 t2_pbits, u8 t3_pbits, const u8 delim[3],
-				 bool delay_mode, u16 delay_time)
+static int gpon_cb_set_overhead(void *hw_priv, u8 guard_bits, u8 t1_pbits,
+				u8 t2_pbits, u8 t3_pbits, const u8 delim[3],
+				bool delay_mode, u16 delay_time)
 {
 	struct xpon_priv *priv = hw_priv;
 	u32 prmbl, pre_dly;
 	u8 effective_guard_bits = guard_bits;
 	int ret;
 
+	if (!xpon_device_activation_allowed(priv->xpon) ||
+	    READ_ONCE(priv->config_restart_pending) ||
+	    atomic_read(&priv->activation_restart_pending))
+		return -EAGAIN;
+
 	/*
 	 * The EN751221/EN7521 vendor GPON stack does not program the gbits
 	 * value from Upstream_Overhead into the legacy digital PHY.  It uses
@@ -1759,9 +1763,11 @@ static void gpon_cb_set_overhead(void *hw_priv, u8 guard_bits, u8 t1_pbits,
 	ret = airoha_xpon_phy_set_gpon_overhead(priv->phy, effective_guard_bits,
 						t1_pbits, t2_pbits, t3_pbits,
 						delim);
-	if (ret)
+	if (ret) {
 		dev_warn(priv->dev, "failed to program GPON PHY overhead: %d\n",
 			 ret);
+		return ret;
+	}
 
 	gpon_write(priv, GPON_PLOu_GUARD_BIT, effective_guard_bits);
 
@@ -1780,25 +1786,13 @@ static void gpon_cb_set_overhead(void *hw_priv, u8 guard_bits, u8 t1_pbits,
 	 * power-on leaves enough time for the EN757x safe/rogue latch to assert
 	 * again before the first Serial_Number_ONU burst.
 	 */
-	if (priv->match_data->gpon_rearm_tx_on_overhead) {
-		ret = airoha_xpon_tx_enable(priv, true);
-		if (ret) {
-			dev_warn(
-				priv->dev,
-				"failed to enable optical transmitter for GPON O3: %d\n",
-				ret);
-			return;
-		}
-
-		ret = airoha_xpon_tx_rearm(priv->dev, airoha_xpon_frontend(priv));
-		if (ret) {
-			dev_warn(
-				priv->dev,
-				"failed to rearm optical transmitter for GPON O3: %d\n",
-				ret);
-			airoha_xpon_tx_enable(priv, false);
-			return;
-		}
+	ret = airoha_xpon_tx_enable(priv, true);
+	if (ret)
+		return ret;
+	ret = airoha_xpon_tx_rearm(priv->dev, airoha_xpon_frontend(priv));
+	if (ret) {
+		airoha_xpon_tx_enable(priv, false);
+		return ret;
 	}
 
 	gpon_adjust_mac_rx_delay(priv);
@@ -1816,6 +1810,14 @@ static void gpon_cb_set_overhead(void *hw_priv, u8 guard_bits, u8 t1_pbits,
 		gpon_read(priv, GPON_PLOu_PRMBL_TYPE3),
 		gpon_read(priv, GPON_PLOu_DELM_BIT),
 		gpon_read(priv, GPON_PRE_ASSIGNED_DLY));
+	if (!xpon_device_activation_allowed(priv->xpon) ||
+	    READ_ONCE(priv->config_restart_pending) ||
+	    atomic_read(&priv->activation_restart_pending)) {
+		airoha_xpon_tx_enable(priv, false);
+		return -EAGAIN;
+	}
+
+	return 0;
 }
 
 static void gpon_cb_set_t3_preamble(void *hw_priv, u8 o3_t3, u8 o5_t3)
@@ -2246,15 +2248,6 @@ void airoha_gpon_omci_hw_config_changed(void *hw_priv, u16 key,
 		dev_dbg(priv->dev,
 			"OMCI configuration changed (key %u), GPON restart not required\n",
 			key);
-		/*
-		 * A box with no identity changes nothing that needs a restart,
-		 * but rpcd's first apply still lands here: the default
-		 * permissive option differs from the kernel's. If it didn't,
-		 * the hold would just run to its timeout.
-		 */
-		if (READ_ONCE(priv->identity_hold))
-			mod_delayed_work(priv->fsm_wq, &priv->restart_work,
-					 msecs_to_jiffies(GPON_CONFIG_RESTART_DEBOUNCE_MS));
 		return;
 	}
 
@@ -2656,6 +2649,7 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 	 */
 	switch (state) {
 	case GPON_O2_STANDBY:
+		xpon_device_activation_request(priv->xpon);
 		phy_state = AIROHA_XPON_PHY_GPON_OPER_DISABLED;
 		break;
 	case GPON_O3_SERIAL_NUMBER:
@@ -2725,30 +2719,9 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 
 	switch (state) {
 	case GPON_O2_STANDBY:
-		if (priv->match_data->gpon_rearm_tx_on_overhead) {
-			ret = airoha_xpon_tx_enable(priv, false);
-			if (ret)
-				dev_warn(
-					priv->dev,
-					"failed to disable optical transmitter in GPON O2: %d\n",
-					ret);
-		} else if (priv->gpon_o7_tx_off) {
-			/*
-			 * This generation transmits from PHY power-on, and
-			 * Upstream_Overhead will not release the transmitter
-			 * that O7 gated: do it on leaving O7.
-			 */
-			ret = airoha_xpon_tx_enable(priv, true);
-			if (!ret)
-				ret = airoha_xpon_tx_rearm(priv->dev,
-							   airoha_xpon_frontend(priv));
-			if (ret)
-				dev_warn(
-					priv->dev,
-					"failed to enable optical transmitter after GPON O7: %d\n",
-					ret);
-		}
-		priv->gpon_o7_tx_off = false;
+		ret = airoha_xpon_tx_enable(priv, false);
+		if (ret)
+			dev_warn(priv->dev, "failed to gate GPON TX in O2: %d\n", ret);
 		/*
 		 * Match the stock SDK for this generation: 0x058b is the
 		 * reset/O1 value, and activation starts from O2 with the
@@ -2765,7 +2738,9 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 		priv->byte_delay = 0;
 		priv->bit_delay = 0;
 		gpon_set_bit_delay(priv, 0);
-		fallthrough;
+		cancel_delayed_work(&priv->to1_work);
+		cancel_delayed_work(&priv->to2_work);
+		break;
 	case GPON_O3_SERIAL_NUMBER:
 	case GPON_O4_RANGING:
 		/* Start / restart TO1 timer */
@@ -2796,8 +2771,8 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 		cancel_delayed_work(&priv->to2_work);
 		/*
 		 * G.984.3: an ONU in emergency stop must not transmit. The
-		 * transmitter was released at Upstream_Overhead (or at PHY
-		 * power-on), so gate it here until Disable_Serial_Number
+		 * transmitter was released at Upstream_Overhead,
+		 * so gate it here until Disable_Serial_Number
 		 * enables the ONU again.
 		 */
 		ret = airoha_xpon_tx_enable(priv, false);
@@ -2806,7 +2781,6 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 				priv->dev,
 				"failed to disable optical transmitter in GPON O7: %d\n",
 				ret);
-		priv->gpon_o7_tx_off = true;
 		/*
 		 * Drop the ONU-ID, as the TO1 return to O2 does: the next
 		 * activation gets a new one from the OLT.
@@ -2868,22 +2842,9 @@ static int gpon_enable(struct xpon_priv *priv)
 	if (!READ_ONCE(priv->started) || !READ_ONCE(priv->optical_active))
 		return -ENETDOWN;
 
-	/*
-	 * The real identity is in userspace, which can't apply it for another
-	 * 26 s. Ranging before then shows the OLT a random serial, it answers
-	 * with Deactivate_ONU-ID, and repeated alarms can get a line banned.
-	 * TX_DISABLE stays asserted from PHY probe, so a held box is dark.
-	 * restart_work ends the hold on the first apply, or on this timeout so
-	 * that a box with no identity still comes up.
-	 */
-	if (READ_ONCE(priv->identity_hold)) {
-		dev_info(priv->dev,
-			 "GPON MAC held for the identity, up to %u ms\n",
-			 GPON_IDENTITY_HOLD_MS);
-		queue_delayed_work(priv->fsm_wq, &priv->restart_work,
-				   msecs_to_jiffies(GPON_IDENTITY_HOLD_MS));
-		return 0;
-	}
+	ret = airoha_xpon_tx_enable(priv, false);
+	if (ret)
+		return ret;
 
 	dev_info(priv->dev, "starting GPON MAC from state %s\n",
 		 gpon_state_name(ploam_get_state(priv->ploam)));
@@ -2931,38 +2892,15 @@ static int gpon_enable(struct xpon_priv *priv)
 	if (ret)
 		goto err_disable_frontend;
 
-	/*
-	 * EN7523 is already known to work with TX enabled immediately after
-	 * PHY power-on.  The older EN751221/EN7528 GPON stack instead keeps the
-	 * frontend TX path disabled throughout O2 and releases/rearms it from
-	 * gpon_cb_set_overhead(), immediately before O3.
-	 *
-	 * BEN remains under control of the digital xPON PHY and gates each
-	 * individual GPON burst.
-	 */
-	if (priv->match_data->gpon_rearm_tx_on_overhead) {
-		ret = airoha_xpon_tx_enable(priv, false);
-		if (ret)
-			goto err_stop_phy;
+	/* RX synchronization must not implicitly authorize an upstream burst. */
+	ret = airoha_xpon_tx_enable(priv, false);
+	if (ret)
+		goto err_stop_phy;
 
-		if (priv->match_data->gpon_runtime_tgen) {
-			/*
-			 * Run TGEN only on SoCs which explicitly need the late
-			 * calibration. Keep TX_DISABLE asserted so PRBS never
-			 * reaches the optical line.
-			 */
-			ret = airoha_xpon_tx_timing_calibrate(priv);
-			if (ret)
-				goto err_stop_phy;
-		} else
-			dev_info(
-				priv->dev,
-				"preserving frontend-provisioned GPON TX timing\n");
-	} else {
-		ret = airoha_xpon_tx_enable(priv, true);
-		if (ret)
-			goto err_stop_phy;
-		ret = airoha_xpon_tx_rearm(priv->dev, airoha_xpon_frontend(priv));
+	if (priv->match_data->gpon_rearm_tx_on_overhead &&
+	    priv->match_data->gpon_runtime_tgen) {
+		/* Keep TX_DISABLE asserted during the late TGEN calibration. */
+		ret = airoha_xpon_tx_timing_calibrate(priv);
 		if (ret)
 			goto err_stop_phy;
 	}
@@ -3015,11 +2953,7 @@ static int gpon_enable(struct xpon_priv *priv)
 	gpon_ploam_rx_queue_reset(priv);
 	WRITE_ONCE(priv->mac_enabled, true);
 
-	/*
-	 * The external TX interlock has already been released by the PHY
-	 * power-on path.  GPON stays optically quiet in O2 because BEN is
-	 * generated by the xPON hardware only for valid upstream grants.
-	 */
+	/* The external TX interlock remains asserted until O3 is authorized. */
 	ploam_start(priv->ploam);
 	WRITE_ONCE(priv->phy_link_known, false);
 	mod_delayed_work(priv->fsm_wq, &priv->phy_link_work, 0);
@@ -3158,6 +3092,7 @@ static void gpon_disable(struct xpon_priv *priv)
 	if (!omci_reset)
 		airoha_gpon_omci_reset_session(&priv->omci);
