From 0d040a3153a7b2b6fc9ccb8f22dc4767dc214683 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 21 Oct 2026 00:32:17 -0300
Subject: [PATCH] net: xpon: expose endpoint paths to offload providers

GEM endpoints are Ethernet netdevices with their own private data. An
offload provider must resolve their parent and protocol binding rather
than treating their private area as a physical GDM port.

Expose a checked endpoint lookup which captures the binding under the
xPON state lock. Reject disabled or stopped endpoints. Provide a field
comparison helper so providers can revalidate a captured binding without
depending on structure padding.

Notify offload providers when an existing endpoint changes its binding,
and forward flowtable setup to the parent device. Other TC setup types
remain unsupported on endpoints.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 include/net/xpon.h  | 24 ++++++++++++++++++++++++
 net/xpon/endpoint.c | 38 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 62 insertions(+)

diff --git a/include/net/xpon.h b/include/net/xpon.h
--- a/include/net/xpon.h
+++ b/include/net/xpon.h
@@ -3,6 +3,7 @@
 #define _NET_XPON_H
 
 #include <linux/bitops.h>
+#include <linux/errno.h>
 #include <linux/log2.h>
 #include <linux/types.h>
 #include <linux/netdevice.h>
@@ -66,6 +67,16 @@ struct xpon_endpoint_config {
 	bool enabled;
 };
 
+static inline bool
+xpon_endpoint_same_binding(const struct xpon_endpoint_config *a,
+			   const struct xpon_endpoint_config *b)
+{
+	return a->id == b->id && a->wire_id == b->wire_id &&
+	       a->scheduler_id == b->scheduler_id && a->link_id == b->link_id &&
+	       a->type == b->type && a->channel == b->channel &&
+	       a->queue == b->queue && a->enabled == b->enabled;
+}
+
 struct xpon_link_info {
 	u16 llid;
 	u8 state;
@@ -156,4 +167,17 @@ int xpon_endpoint_queue(struct xpon_device *xpon,
 bool xpon_endpoint_receive(struct xpon_device *xpon, u8 type, u16 wire_id,
 			   struct sk_buff *skb);
 
+/* The caller must keep dev alive; the returned lower device is borrowed. */
+#if IS_REACHABLE(CONFIG_XPON)
+int xpon_endpoint_get_path(struct net_device *dev, struct net_device **lower,
+			   struct xpon_endpoint_config *config);
+#else
+static inline int
+xpon_endpoint_get_path(struct net_device *dev, struct net_device **lower,
+		       struct xpon_endpoint_config *config)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+
 #endif /* _NET_XPON_H */
diff --git a/net/xpon/endpoint.c b/net/xpon/endpoint.c
--- a/net/xpon/endpoint.c
+++ b/net/xpon/endpoint.c
@@ -4,6 +4,7 @@
 #include <linux/etherdevice.h>
 #include <linux/rtnetlink.h>
 #include <net/net_namespace.h>
+#include <net/pkt_cls.h>
 
 #include "internal.h"
 
@@ -75,6 +76,18 @@ static int xpon_endpoint_stop(struct net_device *dev)
 	return 0;
 }
 
+static int xpon_endpoint_setup_tc(struct net_device *dev,
+				  enum tc_setup_type type, void *type_data)
+{
+	struct xpon_endpoint *ep = netdev_priv(dev);
+	struct net_device *lower = ep->xpon->netdev;
+
+	if (type != TC_SETUP_FT || !lower->netdev_ops->ndo_setup_tc)
+		return -EOPNOTSUPP;
+
+	return lower->netdev_ops->ndo_setup_tc(lower, type, type_data);
+}
+
 static const struct net_device_ops xpon_endpoint_ops = {
 	.ndo_open = xpon_endpoint_open,
 	.ndo_stop = xpon_endpoint_stop,
@@ -82,8 +95,28 @@ static const struct net_device_ops xpon_endpoint_ops = {
 	.ndo_get_stats64 = dev_get_tstats64,
 	.ndo_set_mac_address = eth_mac_addr,
 	.ndo_validate_addr = eth_validate_addr,
+	.ndo_setup_tc = xpon_endpoint_setup_tc,
 };
 
+int xpon_endpoint_get_path(struct net_device *dev, struct net_device **lower,
+			   struct xpon_endpoint_config *config)
+{
+	struct xpon_endpoint *ep;
+	bool ready;
+
+	if (dev->netdev_ops != &xpon_endpoint_ops)
+		return -EOPNOTSUPP;
+	ep = netdev_priv(dev);
+	spin_lock_bh(&ep->xpon->state_lock);
+	*config = ep->config;
+	ready = config->enabled && !READ_ONCE(ep->xpon->unregistering);
+	*lower = ep->xpon->netdev;
+	spin_unlock_bh(&ep->xpon->state_lock);
+
+	return ready && netif_running(dev) ? 0 : -ENETDOWN;
+}
+EXPORT_SYMBOL_GPL(xpon_endpoint_get_path);
+
 static void xpon_endpoint_destructor(struct net_device *dev)
 {
 	struct xpon_endpoint *ep = netdev_priv(dev);
@@ -110,6 +143,7 @@ int xpon_endpoint_set(struct xpon_device *xpon,
 	struct net_device *dev = NULL;
 	struct xpon_endpoint *ep, *other;
 	unsigned long key, old_key = 0;
+	bool changed = false;
 	int ret;
 
 	ASSERT_RTNL();
@@ -161,6 +195,7 @@ int xpon_endpoint_set(struct xpon_device *xpon,
 		netif_carrier_off(dev);
 	} else {
 		old_key = xpon_rx_key(ep->config.type, ep->config.wire_id);
+		changed = !xpon_endpoint_same_binding(&ep->config, config);
 	}
 	ret = xa_err(xa_store(&xpon->rx_endpoints, key, ep, GFP_KERNEL));
 	if (ret)
@@ -175,6 +210,9 @@ int xpon_endpoint_set(struct xpon_device *xpon,
 			netif_carrier_on(ep->netdev);
 		else
 			netif_carrier_off(ep->netdev);
+		/* Flush provider offloads which captured the previous binding. */
+		if (changed)
+			call_netdevice_notifiers(NETDEV_CHANGE, ep->netdev);
 		xpon_device_report_event(xpon, XPON_EVENT_ENDPOINT);
 		return 0;
 	}

