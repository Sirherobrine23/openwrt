From 09d971a59d040d11070972fcbb4ba76baa4e8b2f Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 3 Nov 2026 13:12:15 -0300
Subject: [PATCH] phy: add support for 10G pon family

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/phy/airoha/xpon/an7581.c    |  1 +
 drivers/phy/airoha/xpon/an7583.c    |  1 +
 drivers/phy/airoha/xpon/core.c      | 45 +++++++++++++++++++++++++++++++++
 drivers/phy/airoha/xpon/en7580.c    | 50 ++++++++++++++++++++++++++++++++-----
 drivers/phy/airoha/xpon/xpon.h      |  8 ++++++
 include/linux/phy/phy-airoha-xpon.h | 15 +++++++++++
 6 files changed, 114 insertions(+), 6 deletions(-)

diff --git a/drivers/phy/airoha/xpon/an7581.c b/drivers/phy/airoha/xpon/an7581.c
--- a/drivers/phy/airoha/xpon/an7581.c
+++ b/drivers/phy/airoha/xpon/an7581.c
@@ -1202,6 +1202,7 @@ static int an7581_probe(struct airoha_xpon_phy *priv, struct platform_device *pd
 
 static const struct airoha_xpon_phy_soc_data airoha_an7581_xpon_phy_data = {
 	.name = "AN7581",
+	.has_xgspon_profiles = true,
 	.min_size = SZ_4K,
 	.ana_offset = AN7581_ANA_OFFSET,
 	.pma_offset = AN7581_PMA_OFFSET,
diff --git a/drivers/phy/airoha/xpon/an7583.c b/drivers/phy/airoha/xpon/an7583.c
--- a/drivers/phy/airoha/xpon/an7583.c
+++ b/drivers/phy/airoha/xpon/an7583.c
@@ -1065,6 +1065,7 @@ static int an7583_probe(struct airoha_xpon_phy *priv, struct platform_device *pd
 
 static const struct airoha_xpon_phy_soc_data airoha_an7583_xpon_phy_data = {
 	.name = "AN7583",
+	.has_xgspon_profiles = true,
 	.min_size = SZ_4K,
 	.ana_offset = AN7583_ANA_OFFSET,
 	.pma_offset = AN7583_PMA_OFFSET,
diff --git a/drivers/phy/airoha/xpon/core.c b/drivers/phy/airoha/xpon/core.c
--- a/drivers/phy/airoha/xpon/core.c
+++ b/drivers/phy/airoha/xpon/core.c
@@ -16,6 +16,7 @@
 #include <linux/reset.h>
 #include <linux/sizes.h>
 #include <linux/slab.h>
+#include <linux/unaligned.h>
 #include <linux/workqueue.h>
 
 #include "xpon.h"
@@ -56,6 +57,50 @@ void airoha_xpon_phy_rmw(struct airoha_xpon_phy *priv, u32 reg,
 }
 EXPORT_SYMBOL_GPL(airoha_xpon_phy_rmw);
 
+int airoha_xpon_phy_set_xgspon_profile(struct phy *phy,
+				       const struct airoha_xpon_phy_burst_profile *profile)
+{
+	struct airoha_xpon_phy *priv;
+	u32 offset, mask, info;
+	int ret = 0;
+
+	if (!phy || !profile || profile->index > 3 || !profile->preamble_len ||
+	    profile->preamble_len > 8 || profile->delimiter_len > 8)
+		return -EINVAL;
+	priv = phy_get_drvdata(phy);
+	/* Serialize PCS writes with generic PHY power and mode changes. */
+	mutex_lock(&phy->mutex);
+	if (!priv->soc->has_xgspon_profiles ||
+	    priv->submode != AIROHA_XPON_PHY_SUBMODE_XGSPON) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (!priv->powered) {
+		ret = -ENOLINK;
+		goto out;
+	}
+	/* EN7580 and AN7581/AN7583 share this PCS burst-profile layout. */
+	offset = profile->index * 8;
+	airoha_xpon_phy_write(priv, XPON_XGS_PREAMBLE_UPPER + offset,
+			      get_unaligned_be32(profile->preamble));
+	airoha_xpon_phy_write(priv, XPON_XGS_PREAMBLE_LOWER + offset,
+			      get_unaligned_be32(profile->preamble + 4));
+	airoha_xpon_phy_write(priv, XPON_XGS_DELIMITER_UPPER + offset,
+			      get_unaligned_be32(profile->delimiter));
+	airoha_xpon_phy_write(priv, XPON_XGS_DELIMITER_LOWER + offset,
+			      get_unaligned_be32(profile->delimiter + 4));
+	mask = BIT(profile->index * 8);
+	airoha_xpon_phy_rmw(priv, XPON_XGS_TX_FEC_ENABLE, mask, profile->fec ? mask : 0);
+	info = FIELD_PREP(GENMASK(23, 16), profile->preamble_repeat) |
+	       FIELD_PREP(GENMASK(11, 8), profile->preamble_len) |
+	       FIELD_PREP(GENMASK(3, 0), profile->delimiter_len);
+	airoha_xpon_phy_write(priv, XPON_XGS_PSBU_INFO + profile->index * 4, info);
+out:
+	mutex_unlock(&phy->mutex);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_xpon_phy_set_xgspon_profile);
+
 void airoha_xpon_phy_run(struct airoha_xpon_phy *priv,
 			 const struct airoha_xpon_phy_step *seq, size_t count)
 {
diff --git a/drivers/phy/airoha/xpon/en7580.c b/drivers/phy/airoha/xpon/en7580.c
--- a/drivers/phy/airoha/xpon/en7580.c
+++ b/drivers/phy/airoha/xpon/en7580.c
@@ -922,7 +922,10 @@ static int en7580_phy_set_mode(struct phy *phy, enum phy_mode mode, int submode)
 {
 	struct airoha_xpon_phy *priv = phy_get_drvdata(phy);
 
-	if (mode != PHY_MODE_ETHERNET || submode != AIROHA_XPON_PHY_SUBMODE_XGSPON)
+	if (mode != PHY_MODE_ETHERNET ||
+	    (submode != AIROHA_XPON_PHY_SUBMODE_XGSPON &&
+	     submode != AIROHA_XPON_PHY_SUBMODE_XEPON_10G_10G &&
+	     submode != AIROHA_XPON_PHY_SUBMODE_XEPON_10G_1G))
 		return -EOPNOTSUPP;
 	/* Live changes are owned by the MAC/core and require a stopped PHY. */
 	if (priv->powered)
@@ -931,6 +934,37 @@ static int en7580_phy_set_mode(struct phy *phy, enum phy_mode mode, int submode)
 	return 0;
 }
 
+/* Rate-dependent subset of the vendor en7580_pma.c TXPLL/TX/RX modes.
+ * Common 10G receiver setup is shared with the XGS sequence. The transmitter
+ * remains disabled until an IEEE 802.3av MPCP backend authorizes bursts.
+ */
+static void en7580_xepon_set_rate(struct airoha_xpon_phy *priv)
+{
+	bool asymmetric = priv->submode ==
+		AIROHA_XPON_PHY_SUBMODE_XEPON_10G_1G;
+
+	/* LCPLL 10.3125G: setting_mode_XPON_TXPLL(10) for symmetric,
+	 * setting_mode_XPON_TXPLL(1) for the 1.25G upstream profile.
+	 */
+	airoha_xpon_phy_write(priv, 0x3230,
+			       asymmetric ? 0x08000000 : 0x08400000);
+	airoha_xpon_phy_write(priv, 0x3248,
+			       asymmetric ? 0x20000000 : 0x21000000);
+	airoha_xpon_phy_write(priv, 0x324c,
+			       asymmetric ? 0x20000000 : 0x21000000);
+	airoha_xpon_phy_rmw(priv, 0x3234, BIT(8), BIT(8));
+	/* RX always runs at 10.3125G. 1G upstream uses a narrower TX bus. */
+	airoha_xpon_phy_rmw(priv, 0x3118, GENMASK(25, 24), 0);
+	airoha_xpon_phy_rmw(priv, 0x3714, GENMASK(1, 0), 2);
+	airoha_xpon_phy_rmw(priv, 0x3754, GENMASK(2, 0), 0);
+	airoha_xpon_phy_rmw(priv, 0x3150, GENMASK(12, 10),
+			      (asymmetric ? 1 : 5) << 10);
+	airoha_xpon_phy_rmw(priv, 0x3150, GENMASK(5, 4),
+			      (asymmetric ? 1 : 2) << 4);
+	airoha_xpon_phy_rmw(priv, 0x3874, GENMASK(1, 0),
+			      asymmetric ? 1 : 2);
+}
+
 static int en7580_phy_power_on(struct phy *phy)
 {
 	struct airoha_xpon_phy *priv = phy_get_drvdata(phy);
@@ -951,10 +985,9 @@ static int en7580_phy_power_on(struct phy *phy)
 	ret = reset_control_assert(priv->reset);
 	if (ret)
 		goto err_power;
-	ret = regmap_update_bits(priv->scu, EN7523_SCU_WAN_CONF,
-				 EN7523_SCU_WAN_MODE_MASK, 0x0a);
-	if (ret)
-		goto err_power;
+	/* WAN_CONF is owned by the xPON MAC/net/xpon mode transaction.
+	 * Never overwrite the requested XEPON mode with XGS-PON here.
+	 */
 	ret = reset_control_deassert(priv->reset);
 	if (ret)
 		goto err_power;
@@ -964,6 +997,8 @@ static int en7580_phy_power_on(struct phy *phy)
 	if (ret)
 		goto err_power;
 	en7580_phy_run(priv, init);
+	if (priv->submode != AIROHA_XPON_PHY_SUBMODE_XGSPON)
+		en7580_xepon_set_rate(priv);
 	soc->xgspon_configured = true;
 	en7580_phy_mask_interrupts(priv);
 	airoha_xpon_phy_rmw(priv, EN7580_PHY_RX_CTRL, BIT(16), 0);
@@ -1012,7 +1047,9 @@ static int en7580_phy_power_on(struct phy *phy)
 	priv->ready_reported = false;
 	mod_delayed_work(system_wq, &priv->ready_work, msecs_to_jiffies(1000));
 	mutex_unlock(&soc->xgspon_lock);
-	dev_info(priv->dev, "EN7580 XGS-PON PHY powered; optical TX remains disabled\n");
+	dev_info(priv->dev, "EN7580 %s PHY powered; optical TX remains disabled\n",
+		 priv->submode == AIROHA_XPON_PHY_SUBMODE_XGSPON ?
+		 "XGS-PON" : "XEPON bring-up");
 	return 0;
 
 err_power:
@@ -1187,6 +1224,7 @@ static int en7580_xpon_phy_probe(struct airoha_xpon_phy *priv,
 
 static const struct airoha_xpon_phy_soc_data airoha_en7580_xpon_phy_data = {
 	.name = "EN7580",
+	.has_xgspon_profiles = true,
 	.pma_offset = EN7580_XPON_PHY_PMA_OFFSET,
 	.min_size = EN7580_XPON_PHY_PCS_MIN_SIZE,
 	.default_submode = AIROHA_XPON_PHY_SUBMODE_XGSPON,
diff --git a/drivers/phy/airoha/xpon/xpon.h b/drivers/phy/airoha/xpon/xpon.h
--- a/drivers/phy/airoha/xpon/xpon.h
+++ b/drivers/phy/airoha/xpon/xpon.h
@@ -59,6 +59,13 @@ struct reset_control;
 #define XPON_INT_STATUS				0x05f8
 #define EN7528_XPON_REG_580			0x0580
 
+#define XPON_XGS_PREAMBLE_UPPER			0x0a18
+#define XPON_XGS_PREAMBLE_LOWER			0x0a1c
+#define XPON_XGS_DELIMITER_UPPER			0x0a38
+#define XPON_XGS_DELIMITER_LOWER			0x0a3c
+#define XPON_XGS_TX_FEC_ENABLE			0x0a58
+#define XPON_XGS_PSBU_INFO			0x0a5c
+
 #define XPON_RX_CTRL0				0x3028
 #define XPON_PMA_CTRL0				0x4100
 #define XPON_PMA_CTRL8				0x4110
@@ -154,6 +161,7 @@ struct airoha_xpon_phy_soc_data {
 	bool has_integrated_pma;
 	bool manages_fw_ready;
 	bool has_gpon_bip;
+	bool has_xgspon_profiles;
 	enum airoha_xpon_phy_submode default_submode;
 	const struct phy_ops *ops;
 	int (*pre_init)(struct airoha_xpon_phy *priv);
diff --git a/include/linux/phy/phy-airoha-xpon.h b/include/linux/phy/phy-airoha-xpon.h
--- a/include/linux/phy/phy-airoha-xpon.h
+++ b/include/linux/phy/phy-airoha-xpon.h
@@ -8,11 +8,26 @@
 
 struct phy;
 
+struct airoha_xpon_phy_burst_profile {
+	u8 preamble[8];
+	u8 delimiter[8];
+	u8 index;
+	u8 preamble_len;
+	u8 delimiter_len;
+	u8 preamble_repeat;
+	bool fec;
+};
+
+int airoha_xpon_phy_set_xgspon_profile(struct phy *phy,
+				       const struct airoha_xpon_phy_burst_profile *profile);
+
 /* Driver-specific submodes used with PHY_MODE_ETHERNET. */
 enum airoha_xpon_phy_submode {
 	AIROHA_XPON_PHY_SUBMODE_GPON = 0,
 	AIROHA_XPON_PHY_SUBMODE_EPON = 1,
 	AIROHA_XPON_PHY_SUBMODE_XGSPON = 2,
+	AIROHA_XPON_PHY_SUBMODE_XEPON_10G_10G = 3,
+	AIROHA_XPON_PHY_SUBMODE_XEPON_10G_1G = 4,
 };
 
 /*

