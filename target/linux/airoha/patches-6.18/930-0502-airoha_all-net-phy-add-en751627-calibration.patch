 	if (ret >= 0)
-		ret = __phy_package_write_mmd(phydev, AIROHA_DEFAULT_PORT0_ADDR,
+		ret = __phy_package_write_mmd(phydev, airoha_p0_addr(phydev),
 					      devad, regnum, (ret & ~mask) | set);
 	phy_unlock_mdio_bus(phydev);
 
