+	return airoha_package_write_mmd(phydev, airoha_p0_addr(phydev),
 					devad, regnum, val);
 }
 
@@ -661,10 +724,10 @@ static int airoha_p0_modify_mmd(struct phy_device *phydev, int devad, u32 regnum
 	int ret;
 
