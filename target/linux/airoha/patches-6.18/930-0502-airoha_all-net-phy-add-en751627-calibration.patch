+	/* Vendor global 0x1f register profile, applied to each PHY. */
+	{ MDIO_MMD_VEND2, 0x273, 0x1000 },
+	{ MDIO_MMD_VEND2, 0x272, 0x14ff },
+	{ MDIO_MMD_VEND2, 0x268, 0x0728 },
+	{ MDIO_MMD_VEND2, 0x269, 0x111f },
