+	{ MDIO_MMD_VEND2, 0x044, 0x0030 },
+	{ MDIO_MMD_VEND2, 0x27c, 0x0808 },
+	{ MDIO_MMD_VEND2, 0x27b, 0x1177 },
+	{ MDIO_MMD_VEND2, 0x417, 0x7775 },
+	{ MDIO_MMD_VEND2, 0x024, 0xc007 },
+	{ MDIO_MMD_VEND2, 0x025, 0x003f },
