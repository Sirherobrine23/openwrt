From 21c8344c030504a8e85dfb1c84cf4970e754302a Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 15 Oct 2026 16:20:24 -0300
Subject: [PATCH] airoha: en7580: add L2 cache size and remove mm_config debug
 log

---
 arch/mips/boot/dts/econet/en7580.dtsi | 13 +++++++++++++
 arch/mips/kernel/cpu-probe.c          |  6 ------
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/arch/mips/boot/dts/econet/en7580.dtsi b/arch/mips/boot/dts/econet/en7580.dtsi
--- a/arch/mips/boot/dts/econet/en7580.dtsi
+++ b/arch/mips/boot/dts/econet/en7580.dtsi
@@ -48,24 +48,28 @@ cpu0: cpu@0 {
 			device_type = "cpu";
 			compatible = "mips,mips1004Kc";
 			reg = <0>;
+			next-level-cache = <&l2>;
 		};
 
 		cpu1: cpu@1 {
 			device_type = "cpu";
 			compatible = "mips,mips1004Kc";
 			reg = <1>;
+			next-level-cache = <&l2>;
 		};
 
 		cpu2: cpu@2 {
 			device_type = "cpu";
 			compatible = "mips,mips1004Kc";
 			reg = <2>;
+			next-level-cache = <&l2>;
 		};
 
 		cpu3: cpu@3 {
 			device_type = "cpu";
 			compatible = "mips,mips1004Kc";
 			reg = <3>;
+			next-level-cache = <&l2>;
 		};
 
 		cpu-map {
@@ -91,6 +95,15 @@ thread1 {
 				};
 			};
 		};
+
+		l2: l2-cache {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+			cache-size = <0x80000>;
+			cache-line-size = <32>;
+			cache-sets = <2048>;
+		};
 	};
 
 	cpuintc: interrupt-controller {
diff --git a/arch/mips/kernel/cpu-probe.c b/arch/mips/kernel/cpu-probe.c
--- a/arch/mips/kernel/cpu-probe.c
+++ b/arch/mips/kernel/cpu-probe.c
@@ -1442,13 +1442,7 @@ static inline void cpu_probe_mips(struct cpuinfo_mips *c, unsigned int cpu)
 
 	spram_config();
 
-	pr_emerg("EN751221: Config0 before mm_config = %08x, PRId = %08x, CPU type = %u\n",
-		 read_c0_config(), read_c0_prid(), c->cputype);
-	
 	mm_config(c);
-	
-	pr_emerg("EN751221: Config0 after mm_config = %08x\n",
-		 read_c0_config());
 
 	switch (__get_cpu_type(c->cputype)) {
 	case CPU_M5150:

