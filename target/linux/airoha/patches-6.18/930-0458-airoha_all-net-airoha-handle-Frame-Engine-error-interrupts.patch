From 56ce3e2808ce453fad0f96cc5181aac5c496e85b Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Mon, 26 Oct 2026 22:35:52 -0300
Subject: [PATCH] net: airoha: handle Frame Engine error interrupts

EN7523 enables FE interrupt sources without requesting their handler.
Keep the FE masked during hardware initialization, request the optional
named fe-error IRQ and clear stale status before unmasking events.
Synchronize and mask the handler before tearing down DMA resources,
including when probe fails after registering the IRQ.

Select the shared SDK PSE/GDM2 event map for EN7580, EN7523, EN7581,
AN7552 and AN7583. Leave EN751221/EN751627/EN7528 monitoring disabled
until their event maps are verified. Add TSO alert bits only with an
active TSO v2 implementation; PDMA TX completion polling is unchanged.

Acknowledge only observed enabled status using W1C. Expose atomic
per-event FE counters through ethtool on each GDM and rate-limit alerts.
Count auto-aging notifications silently. On AN7552, report and mask PSE
exceptions until reprobe instead of resetting a live core without a
coordinated DMA/PPE recovery path.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../ethernet/airoha/fe-interrupts.rst              |  58 +++++++
 drivers/net/ethernet/airoha/airoha_eth.c           | 178 +++++++++++++++++++--
 drivers/net/ethernet/airoha/airoha_eth.h           |   4 +
 drivers/net/ethernet/airoha/airoha_regs.h          |   9 ++
 4 files changed, 232 insertions(+), 17 deletions(-)

diff --git a/Documentation/networking/device_drivers/ethernet/airoha/fe-interrupts.rst b/Documentation/networking/device_drivers/ethernet/airoha/fe-interrupts.rst
new file mode 100644
--- /dev/null
+++ b/Documentation/networking/device_drivers/ethernet/airoha/fe-interrupts.rst
@@ -0,0 +1,58 @@
+.. SPDX-License-Identifier: GPL-2.0-only
+
+Airoha/EcoNet Frame Engine interrupts
+=====================================
+
+The Ethernet driver requests the optional interrupt named ``fe-error`` on
+EN7580, EN7523, EN7581, AN7552 and AN7583. The IRQ must be named in the DT;
+there is no positional fallback. Missing names leave monitoring disabled
+without preventing Ethernet operation. EN751221, EN751627 and EN7528 keep
+monitoring disabled until their event maps have been verified.
+
+The shared SDK FE register map defines status at FE + 0x08 and enable at
+FE + 0x0c. Per-SoC masks select PSE free-queue exhaustion (bit 8) and GDM2
+MBI/GEM/FIFO events (bits 16-18 and 20-23). This is the default event set
+in the SDK EN7580/EN7523 registration path. The newer SoCs use the same
+status definitions. Board validation is still required for each target.
+Normal PSE flow-control notifications (bits 0-5) and flow-control drops
+(bit 9) remain masked, matching the SDK default.
+
+When TSO v2 is active, FE TSO alerts (bits 12-15) are also enabled. The SDK
+labels these collectively as TSO alerts without documenting their individual
+meanings; counters retain their bit numbers. These are not the PDMA TX_DONE
+interrupts at FE + 0xa20. This change does not replace TSO completion polling.
+
+Only AN7552 enables the PSE exception event (bit 28), matching the SDK's
+``SUPPORT_DETECT_PSE_EXCEPTION`` capability. The handler acknowledges the
+exception and masks that source until driver reprobe. It does not copy the
+SDK's PSE core reset: resetting an active core requires coordinated DMA/PPE
+recovery. This reports an exception, but does not recover a stalled datapath.
+The other event sources remain enabled.
+
+Initialization keeps FE interrupts masked, requests the IRQ, clears stale
+status and then unmasks supported events. The handler reads enabled status,
+returns IRQ_NONE for an unrelated interrupt, and acknowledges only observed
+events using write-one-to-clear. Remove and probe-error paths synchronize
+the handler and mask events before releasing the IRQ and DMA resources.
+
+Diagnostics
+-----------
+
+``/proc/interrupts`` lists the handler as ``airoha-fe-error``. Event counters
+are available through ethtool on any GDM interface, for example::
+
+  ethtool -S eth0 | grep fe_irq_
+  ethtool -S pon0 | grep fe_irq_
+
+These are shared FE counters: eth0 and pon0 show the same values. They count
+observed status assertions, not packets or a lossless total of hardware
+faults. Multiple events can coalesce in a single status bit. Stale status
+cleared during initialization is not counted. Sources outside the configured
+monitoring mask are omitted; the PSE exception counter remains visible after
+masking that source. MBI auto-aging notifications are counted without warning
+messages. Other alerts produce rate-limited diagnostics.
+
+During board validation, exercise bidirectional traffic, optical channel
+retirement and interface stop/start with TSO enabled and disabled. Check the
+FE counters together with PDMA indices, BQL inflight bytes and kernel logs.
+Do not infer successful recovery or TSO segmentation from IRQ counts alone.
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -6697,10 +6697,107 @@ static void airoha_fe_pse_init(struct airoha_eth *eth)
 		airoha_fe_wr(eth, AN7552_PSE_SHARE_USED_THD, 0x01e001f4);
 }
 
+static irqreturn_t airoha_fe_irq_handler(int irq, void *data)
+{
+	struct airoha_eth *eth = data;
+	u32 status, events;
+	int bit;
+
+	status = airoha_fe_rr(eth, REG_FE_INT_STATUS);
+	status &= airoha_fe_rr(eth, REG_FE_INT_ENABLE) & eth->fe_irq_mask;
+	if (!status)
+		return IRQ_NONE;
+
+	/* W1C: acknowledge only the enabled events that were observed. */
+	airoha_fe_wr(eth, REG_FE_INT_STATUS, status);
+	airoha_fe_rr(eth, REG_FE_INT_STATUS);
+
+	for (events = status; events; events &= events - 1) {
+		bit = __ffs(events);
+		atomic64_inc(&eth->fe_irq_stats[bit]);
+	}
+
+	/* The SDK resets the PSE core here. That requires coordinated DMA
+	 * recovery; mask this source until reprobe instead of resetting live
+	 * queues or repeatedly interrupting on an unrecovered exception.
+	 */
+	if (status & FE_INT_PSE_EXCEPTION) {
+		airoha_fe_clear(eth, REG_FE_INT_ENABLE, FE_INT_PSE_EXCEPTION);
+		airoha_fe_rr(eth, REG_FE_INT_ENABLE);
+		dev_err_ratelimited(eth->dev,
+				    "PSE exception; FE exception interrupt masked\n");
+	}
+
+	/* MBI auto-aging events also occur during normal channel retirement. */
+	if (status & ~(GDM2_RX_INTR1_MASK | GDM2_TX_INTR2_MASK |
+		       FE_INT_PSE_EXCEPTION))
+		dev_warn_ratelimited(eth->dev, "FE interrupt status %#08x\n", status);
+
+	return IRQ_HANDLED;
+}
+
+static int airoha_fe_irq_init(struct platform_device *pdev,
+			      struct airoha_eth *eth)
+{
+	u32 mask = eth->soc->fe_irq_mask;
+	int irq, err;
+
+	/* Keep generations with unverified event maps disabled. */
+	if (!mask)
+		return 0;
+
+	irq = platform_get_irq_byname_optional(pdev, "fe-error");
+	if (irq == -ENXIO) {
+		dev_warn(eth->dev, "FE error IRQ missing; event monitoring disabled\n");
+		return 0;
+	}
+	if (irq < 0)
+		return dev_err_probe(eth->dev, irq,
+				     "failed to get FE error IRQ\n");
+
+	/* FE TSO alerts are separate from PDMA TX completion interrupts. The
+	 * SDK does not document the individual meanings of bits 12 through 15.
+	 */
+	if (airoha_tso_version(eth) == AIROHA_TSO_V2)
+		mask |= FE_INT_TSO_MASK;
+	eth->fe_irq_mask = mask;
+
+	err = request_irq(irq, airoha_fe_irq_handler, 0, "airoha-fe-error", eth);
+	if (err)
+		return dev_err_probe(eth->dev, err,
+				     "failed to request FE error IRQ\n");
+	eth->fe_irq = irq;
+
+	/* Discard stale status before unmasking the registered handler. */
+	airoha_fe_wr(eth, REG_FE_INT_STATUS, mask);
+	airoha_fe_wr(eth, REG_FE_INT_ENABLE, mask);
+	airoha_fe_rr(eth, REG_FE_INT_ENABLE);
+	return 0;
+}
+
+static void airoha_fe_irq_cleanup(struct airoha_eth *eth)
+{
+	if (!eth->fe_irq)
+		return;
+
+	/* Stop and synchronize the handler before it can race the mask write. */
+	disable_irq(eth->fe_irq);
+	airoha_fe_wr(eth, REG_FE_INT_ENABLE, 0);
+	airoha_fe_rr(eth, REG_FE_INT_ENABLE);
+	free_irq(eth->fe_irq, eth);
+	eth->fe_irq = 0;
+}
+
 static int airoha_fe_init(struct airoha_eth *eth)
 {
 	int err;
 
+	/* No FE event may be unmasked before airoha_fe_irq_init(). */
+	if (eth->soc->fe_irq_mask) {
+		airoha_fe_wr(eth, REG_FE_INT_ENABLE, 0);
+		airoha_fe_rr(eth, REG_FE_INT_ENABLE);
+	}
+
 	/*
 	 * The EN7528 SCU assigns the shared GDMP SRAM to the FE before the
 	 * Ethernet driver probes. Increase the PSE free-queue pool to use that
@@ -6918,14 +7015,6 @@ static int airoha_fe_init(struct airoha_eth *eth)
 		airoha_fe_set(eth, REG_MC_VLAN_EN, MC_VLAN_EN_MASK);
 	}
 
-	/* enable Frame Engine interrupts */
-	if (airoha_is(eth, airoha_en7523))
-		airoha_fe_set(eth, REG_FE_INT_ENABLE,
-		      GDM2_RX_INTR3_MASK | GDM2_RX_INTR2_MASK |
-		      GDM2_RX_INTR1_MASK | GDM2_RX_INTR0_MASK |
-		      GDM2_TX_INTR2_MASK | GDM2_TX_INTR1_MASK |
-		      GDM2_TX_INTR0_MASK | PSE_FQ_EMPTY_MASK);
-
 	if (airoha_is(eth, airoha_an7552))
 		return 0;
 	return airoha_fe_mc_vlan_clear(eth);
@@ -8496,6 +8585,57 @@ static int airoha_xpon_xmit_oam(struct net_device *netdev, struct sk_buff *skb,
 	return ret == NETDEV_TX_BUSY ? -EBUSY : 0;
 }
 
+/* These counters belong to the FE, rather than to an individual GDM. */
+static const char airoha_fe_irq_names[32][ETH_GSTRING_LEN] = {
+	[8] = "fe_irq_pse_fq_empty",
+	[12] = "fe_irq_tso_bit12",
+	[13] = "fe_irq_tso_bit13",
+	[14] = "fe_irq_tso_bit14",
+	[15] = "fe_irq_tso_bit15",
+	[16] = "fe_irq_gdm2_tx_mbi_mac",
+	[17] = "fe_irq_gdm2_tx_mbi_csr",
+	[18] = "fe_irq_gdm2_tx_mbi_aging",
+	[20] = "fe_irq_gdm2_rx_mbi_csr",
+	[21] = "fe_irq_gdm2_rx_mbi_aging",
+	[22] = "fe_irq_gdm2_rx_fifo_overflow",
+	[23] = "fe_irq_gdm2_rx_gemport_issue",
+	[28] = "fe_irq_pse_exception",
+};
+
+static int airoha_get_sset_count(struct net_device *netdev, int sset)
+{
+	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+
+	if (sset != ETH_SS_STATS)
+		return -EOPNOTSUPP;
+
+	return hweight32(dev->eth->fe_irq_mask);
+}
+
+static void airoha_get_strings(struct net_device *netdev, u32 sset, u8 *data)
+{
+	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+	int i;
+
+	if (sset != ETH_SS_STATS)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(airoha_fe_irq_names); i++)
+		if (dev->eth->fe_irq_mask & BIT(i))
+			ethtool_puts(&data, airoha_fe_irq_names[i]);
+}
+
+static void airoha_get_ethtool_stats(struct net_device *netdev,
+				     struct ethtool_stats *stats, u64 *data)
+{
+	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(airoha_fe_irq_names); i++)
+		if (dev->eth->fe_irq_mask & BIT(i))
+			*data++ = atomic64_read(&dev->eth->fe_irq_stats[i]);
+}
+
 static void airoha_ethtool_get_mac_stats(struct net_device *netdev,
 					 struct ethtool_eth_mac_stats *stats)
 {
@@ -9542,6 +9682,9 @@ static const struct net_device_ops airoha_netdev_ops = {
 
 static const struct ethtool_ops airoha_ethtool_ops = {
 	.get_drvinfo		= airoha_eth_get_drvinfo,
+	.get_sset_count		= airoha_get_sset_count,
+	.get_strings		= airoha_get_strings,
+	.get_ethtool_stats	= airoha_get_ethtool_stats,
 	.get_eth_mac_stats	= airoha_ethtool_get_mac_stats,
 	.get_rmon_stats		= airoha_ethtool_get_rmon_stats,
 	.get_link_ksettings	= airoha_ethtool_get_link_ksettings,
@@ -10143,6 +10286,7 @@ static void airoha_eth_cleanup(struct airoha_eth *eth)
 {
 	int i;
 
+	airoha_fe_irq_cleanup(eth);
 	airoha_wed_exit();
 	if (test_and_clear_bit(DEV_STATE_NAPI_STARTED, &eth->state)) {
 		for (i = 0; i < AIROHA_MAX_NUM_QDMA; i++) {
@@ -10687,6 +10831,7 @@ const struct airoha_eth_soc_data econet_en7528_soc_data = {
 
 const struct airoha_eth_soc_data econet_en7580_soc_data = {
 	.version = econet_en7580,
+	.fe_irq_mask = FE_INT_ERROR_MASK,
 	.xpon_ops = &en7580_xpon_ops,
 	.num_ppe = 1,
 	.tx_ring = 8,
@@ -10710,6 +10855,7 @@ const struct airoha_eth_soc_data econet_en7580_soc_data = {
 
 const struct airoha_eth_soc_data airoha_en7581_soc_data = {
 	.version = airoha_en7581,
+	.fe_irq_mask = FE_INT_ERROR_MASK,
 	.xsi_rsts_names = en7581_xsi_rsts_names,
 	.num_xsi_rsts = ARRAY_SIZE(en7581_xsi_rsts_names),
 	.num_ppe = 2,
@@ -10731,6 +10877,7 @@ const struct airoha_eth_soc_data airoha_en7581_soc_data = {
 
 const struct airoha_eth_soc_data airoha_an7583_soc_data = {
 	.version = airoha_an7583,
+	.fe_irq_mask = FE_INT_ERROR_MASK,
 	.xsi_rsts_names = an7583_xsi_rsts_names,
 	.num_xsi_rsts = ARRAY_SIZE(an7583_xsi_rsts_names),
 	.num_ppe = 1,
@@ -10752,6 +10899,7 @@ const struct airoha_eth_soc_data airoha_an7583_soc_data = {
 
 const struct airoha_eth_soc_data airoha_en7523_soc_data = {
 	.version = airoha_en7523,
+	.fe_irq_mask = FE_INT_ERROR_MASK,
 	.xpon_ops = &airoha_xpon_ops,
 	.xsi_rsts_names = en7523_xsi_rsts_names,
 	.num_xsi_rsts = ARRAY_SIZE(en7523_xsi_rsts_names),
@@ -10777,6 +10925,7 @@ const struct airoha_eth_soc_data airoha_en7523_soc_data = {
 
 static const struct airoha_eth_soc_data an7552_soc_data = {
 	.version = airoha_an7552,
+	.fe_irq_mask = FE_INT_ERROR_MASK | FE_INT_PSE_EXCEPTION,
 	.xpon_ops = &airoha_xpon_ops,
 	// .xsi_rsts_names = en7523_xsi_rsts_names,
 	// .num_xsi_rsts = ARRAY_SIZE(en7523_xsi_rsts_names),
@@ -10820,6 +10969,8 @@ static int airoha_eth_probe(struct platform_device *pdev)
 
 	eth->dev = &pdev->dev;
 	eth->soc = soc;
+	for (i = 0; i < ARRAY_SIZE(eth->fe_irq_stats); i++)
+		atomic64_set(&eth->fe_irq_stats[i], 0);
 	/* fe.c: EN7580 retires the GDM2 channels, every other SoC drops them */
 	eth->channel_retire = airoha_is(eth, econet_en7580);
 	eth->ppe_host_ops = &airoha_ppe_host_ops;
@@ -10936,16 +11087,9 @@ static int airoha_eth_probe(struct platform_device *pdev)
 	if (err)
 		goto error;
 
-	/* FE error is a distinct interrupt on EN7516/EN7527/EN7528 and the
-	 * newer Airoha FE. Do not depend on its positional index in the IRQ
-	 * array; EN751221 legitimately has no separate FE-error line.
-	 */
-	eth->fe_irq = platform_get_irq_byname_optional(pdev, "fe-error");
-	if (eth->fe_irq < 0 && eth->fe_irq != -ENXIO) {
-		err = dev_err_probe(eth->dev, eth->fe_irq,
-				    "failed to get FE error IRQ\n");
+	err = airoha_fe_irq_init(pdev, eth);
+	if (err)
 		goto error;
-	}
 
 	for (i = 0; ; i++) {
 		struct device_node *wed_np;
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -1324,6 +1324,7 @@ struct airoha_eth_soc_data {
 	int max_gdm_ports;
 	bool legacy_qdma;
 	bool ppe_datapath;
+	u32 fe_irq_mask;
 	u32 pse_fq_cfg;
 	u32 ppe_stats_entries;
 	u32 ppe_sram_entries;
@@ -1369,6 +1370,9 @@ struct airoha_eth {
 	struct net_device *napi_dev;
 	struct airoha_tso *tso;
 	int fe_irq;
+	u32 fe_irq_mask;
+	/* Shared FE event counts, indexed by FE_INT_STATUS bit. */
+	atomic64_t fe_irq_stats[32];
 
 	struct airoha_qdma qdma[AIROHA_MAX_NUM_QDMA];
 	struct airoha_gdm_port **ports;
diff --git a/drivers/net/ethernet/airoha/airoha_regs.h b/drivers/net/ethernet/airoha/airoha_regs.h
--- a/drivers/net/ethernet/airoha/airoha_regs.h
+++ b/drivers/net/ethernet/airoha/airoha_regs.h
@@ -90,6 +90,7 @@
 #define EN751221_PPE_CPU_REASON_NO_FLOW	0x07
 
 #define REG_FE_INT_STATUS		0x0008
+#define FE_INT_PSE_EXCEPTION		BIT(28)
 #define	GDM2_RX_INTR3_MASK		BIT(23)
 #define	GDM2_RX_INTR2_MASK		BIT(22)
 #define	GDM2_RX_INTR1_MASK		BIT(21)
@@ -97,7 +98,15 @@
 #define	GDM2_TX_INTR2_MASK		BIT(18)
 #define	GDM2_TX_INTR1_MASK		BIT(17)
 #define	GDM2_TX_INTR0_MASK		BIT(16)
+#define FE_INT_TSO_MASK			GENMASK(15, 12)
 #define	PSE_FQ_EMPTY_MASK		BIT(8)
+#define FE_INT_ERROR_MASK		(GDM2_RX_INTR3_MASK | \
+					 GDM2_RX_INTR2_MASK | \
+					 GDM2_RX_INTR1_MASK | \
+					 GDM2_RX_INTR0_MASK | \
+					 GDM2_TX_INTR2_MASK | \
+					 GDM2_TX_INTR1_MASK | \
+					 GDM2_TX_INTR0_MASK | PSE_FQ_EMPTY_MASK)
 #define REG_FE_INT_ENABLE		0x000C
 #define REG_FE_FOE_TS			0x0010
 

