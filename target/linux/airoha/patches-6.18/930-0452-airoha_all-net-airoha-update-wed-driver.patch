From 104d7193908427e356d917c0408f97e20ca70046 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Mon, 26 Oct 2026 14:03:49 -0300
Subject: [PATCH] net: airoha: update wed driver

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 arch/mips/boot/dts/econet/en7528.dtsi    |   4 +-
 drivers/net/ethernet/airoha/airoha_eth.c |   2 +-
 drivers/net/ethernet/airoha/airoha_eth.h |   2 +
 drivers/net/ethernet/airoha/airoha_ppe.c | 122 +++++++++++++++++++++++--------
 drivers/net/ethernet/airoha/airoha_wed.c | 118 +++++++++++++++++++-----------
 drivers/net/ethernet/airoha/airoha_wed.h |   7 +-
 drivers/net/ethernet/mtk_wed_private.h   |   2 +
 7 files changed, 180 insertions(+), 77 deletions(-)

diff --git a/arch/mips/boot/dts/econet/en7528.dtsi b/arch/mips/boot/dts/econet/en7528.dtsi
--- a/arch/mips/boot/dts/econet/en7528.dtsi
+++ b/arch/mips/boot/dts/econet/en7528.dtsi
@@ -705,7 +705,7 @@ xpon: xmac@1fb60000 {
 		/* <GIC_SHARED 56 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 port 1 */
 		/* <GIC_SHARED 58 IRQ_TYPE_LEVEL_HIGH> => WIFI DMA 1 for WOE */
 		wed0: wed@1fa02000 {
-			compatible = "airoha,en7523-wed", "syscon";
+			compatible = "econet,en7528-wed", "syscon";
 			reg = <0x1fa02000 0xb00>,
 			      <0x1fa06000 0x400>;
 			reg-names = "wed", "wdma";
@@ -714,7 +714,7 @@ wed0: wed@1fa02000 {
 		};
 
 		wed1: wed@1fa03000 {
-			compatible = "airoha,en7523-wed", "syscon";
+			compatible = "econet,en7528-wed", "syscon";
 			reg = <0x1fa03000 0xb00>,
 			      <0x1fa06400 0x400>;
 			reg-names = "wed", "wdma";
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -10827,7 +10827,7 @@ static int airoha_eth_probe(struct platform_device *pdev)
 		wed_np = of_parse_phandle(pdev->dev.of_node, "airoha,wed", i);
 		if (!wed_np)
 			break;
-		err = airoha_wed_add_hw(wed_np, i);
+		err = airoha_wed_add_hw(eth, wed_np, i);
 		if (err)
 			goto error;
 	}
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -1538,6 +1538,8 @@ void airoha_ppe_set_cpu_port(struct airoha_gdm_dev *dev, u8 ppe_id, u8 fport);
 bool airoha_ppe_is_enabled(struct airoha_eth *eth, int index);
 void airoha_ppe_check_skb(struct airoha_ppe_dev *dev, struct sk_buff *skb,
 			  u16 hash, bool rx_wlan);
+int airoha_ppe_setup_tc_wed(struct airoha_eth *eth, struct net_device *dev,
+			    enum tc_setup_type type, void *type_data);
 int airoha_ppe_setup_tc_block_cb(struct airoha_ppe_dev *dev, void *type_data);
 int airoha_ppe_init(struct airoha_eth *eth);
 void airoha_ppe_deinit(struct airoha_eth *eth);
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -43,12 +43,12 @@ static const struct rhashtable_params airoha_l2_flow_table_params = {
 	.automatic_shrinking = true,
 };
 
-static int airoha_ppe_v1_flow_offload_replace(struct net_device *dev,
-					       struct flow_cls_offload *f,
-					       const void *owner);
-static int airoha_ppe_v1_flow_offload_destroy(struct net_device *dev,
-					       struct flow_cls_offload *f);
-static int airoha_ppe_v1_flow_offload_stats(struct net_device *dev,
+static int airoha_ppe_v1_flow_offload_replace(struct airoha_ppe *ppe,
+					      struct flow_cls_offload *f,
+					      const void *owner);
+static int airoha_ppe_v1_flow_offload_destroy(struct airoha_ppe *ppe,
+					      struct flow_cls_offload *f);
+static int airoha_ppe_v1_flow_offload_stats(struct airoha_ppe *ppe,
 					    struct flow_cls_offload *f);
 static void airoha_ppe_v1_hw_init(struct airoha_ppe *ppe);
 
@@ -575,11 +575,15 @@ static int airoha_ppe_get_wdma_info(struct net_device *dev, const u8 *addr,
 	if (err)
 		return err;
 
+	if (!stack.num_paths)
+		return -ENODEV;
+
 	path = &stack.path[stack.num_paths - 1];
 	if (path->type != DEV_PATH_MTK_WDMA)
 		return -EINVAL;
 
 	info->idx = path->mtk_wdma.wdma_idx;
+	info->queue = path->mtk_wdma.queue;
 	info->bss = path->mtk_wdma.bss;
 	info->wcid = path->mtk_wdma.wcid;
 
@@ -663,6 +667,20 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 
 		if (!airoha_ppe_get_wdma_info(netdev, data->eth.h_dest,
 					      &info)) {
+			if (airoha_is(eth, airoha_en7523)) {
+				u8 ring = info.idx * 2 + info.queue;
+
+				if (info.idx > 1 || info.queue > 1 ||
+				    info.wcid > 0xff || info.bss > 0x3f)
+					return -EOPNOTSUPP;
+				val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, ring) |
+				       FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT,
+						  FE_PSE_PORT_GDM3) |
+				       AIROHA_FOE_IB2_PSE_QOS;
+				qdata |= FIELD_PREP(AIROHA_FOE_CHANNEL, 6 + ring);
+				wlan_etype = (info.wcid << 6) | info.bss;
+				goto wlan_done;
+			}
 			val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, info.idx) |
 			       FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT,
 					  airoha_is(eth, airoha_en7523) ?
@@ -758,6 +776,7 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 		}
 	}
 
+wlan_done:
 	if (is_multicast_ether_addr(data->eth.h_dest))
 		val |= AIROHA_FOE_IB2_MULTICAST;
 
@@ -2243,13 +2262,13 @@ static int airoha_ppe_flow_offload_cmd(struct airoha_eth *eth,
 
 	switch (f->command) {
 	case FLOW_CLS_REPLACE:
-		return v1 ? airoha_ppe_v1_flow_offload_replace(dev, f, owner) :
+		return v1 ? airoha_ppe_v1_flow_offload_replace(eth->ppe, f, owner) :
 			    airoha_ppe_flow_offload_replace(eth, f);
 	case FLOW_CLS_DESTROY:
-		return v1 ? airoha_ppe_v1_flow_offload_destroy(dev, f) :
+		return v1 ? airoha_ppe_v1_flow_offload_destroy(eth->ppe, f) :
 			    airoha_ppe_flow_offload_destroy(eth, f);
 	case FLOW_CLS_STATS:
-		return v1 ? airoha_ppe_v1_flow_offload_stats(dev, f) :
+		return v1 ? airoha_ppe_v1_flow_offload_stats(eth->ppe, f) :
 			    airoha_ppe_flow_offload_stats(eth, f);
 	default:
 		return -EOPNOTSUPP;
@@ -3956,12 +3975,16 @@ static struct airoha_ppe *airoha_ppe_from_netdev(struct net_device *netdev)
 	return gdm->ppe->priv;
 }
 
-static int airoha_ppe_v1_flow_set_output(struct airoha_foe_entry *entry,
-				  struct net_device *odev, bool vlan_valid,
-				  u16 vlan_id, u8 vlan_prio, bool *xpon,
-				  struct xpon_endpoint_config *endpoint)
+static int airoha_ppe_v1_flow_set_output(struct airoha_ppe *ppe,
+					 struct airoha_foe_entry *entry,
+					 struct net_device *odev, bool vlan_valid,
+					 u16 vlan_id, u8 vlan_prio, bool *xpon,
+					 struct xpon_endpoint_config *endpoint)
 {
+	struct airoha_wdma_info info = {};
 	struct airoha_gdm_common *gdm;
+	u8 dmac[ETH_ALEN];
+	u32 *l2 = airoha_foe_v1_l2(entry);
 	struct dsa_port *dp;
 	int dsa_port = -1;
 	int wifi_idx;
@@ -3971,6 +3994,28 @@ static int airoha_ppe_v1_flow_set_output(struct airoha_foe_entry *entry,
 	if (!odev)
 		return -EOPNOTSUPP;
 
+	put_unaligned_be32(l2[1], dmac);
+	put_unaligned_be16(FIELD_GET(AIROHA_FOE_L2_DMAC_LO, l2[2]), dmac + 4);
+	if (!airoha_ppe_get_wdma_info(odev, dmac, &info)) {
+		u8 ring = info.idx * 2 + info.queue;
+		u32 *data = airoha_foe_v1_data(entry);
+
+		if (!airoha_is(ppe->common.eth, econet_en7528) ||
+		    vlan_valid || info.idx > 1 || info.queue > 1 ||
+		    info.wcid > 0xff || info.bss > 0x3f)
+			return -EOPNOTSUPP;
+
+		/* The vendor LAN arbiter maps the fourth WDMA queue to channel 0. */
+		airoha_foe_v1_entry_set_pse_port(entry, AIROHA_FOE_V1_FP_QDMA_LAN);
+		airoha_foe_v1_entry_set_queue(entry, 0);
+		*data &= ~(AIROHA_FOE_V1_CHANNEL | AIROHA_FOE_V1_SHAPER_ID);
+		*data |= FIELD_PREP(AIROHA_FOE_V1_CHANNEL, ring == 3 ? 0 : 5 + ring) |
+			 FIELD_PREP(AIROHA_FOE_V1_SHAPER_ID, 0x7f);
+		airoha_foe_v1_l2_set(entry, 0, AIROHA_FOE_L2_ETYPE,
+				     (info.wcid << 6) | info.bss);
+		return 0;
+	}
+
 	wifi_idx = airoha_whnat_active() ? airoha_whnat_vif_index(odev) : -1;
 	if (wifi_idx >= 0) {
 		/*
@@ -4126,7 +4171,7 @@ static int airoha_ppe_v1_l2_flow_replace(struct airoha_ppe *ppe,
 		if (err)
 			return err;
 	}
-	err = airoha_ppe_v1_flow_set_output(&entry, odev, vlan_push, vlan_id,
+	err = airoha_ppe_v1_flow_set_output(ppe, &entry, odev, vlan_push, vlan_id,
 					    vlan_prio, &xpon, &endpoint);
 	if (err)
 		return err;
@@ -4171,11 +4216,10 @@ static int airoha_ppe_v1_l2_flow_replace(struct airoha_ppe *ppe,
 	return 0;
 }
 
-static int airoha_ppe_v1_flow_offload_replace(struct net_device *dev,
-				       struct flow_cls_offload *cls,
-				       const void *owner)
+static int airoha_ppe_v1_flow_offload_replace(struct airoha_ppe *ppe,
+					      struct flow_cls_offload *cls,
+					      const void *owner)
 {
-	struct airoha_ppe *ppe = airoha_ppe_from_netdev(dev);
 	struct flow_rule *rule = flow_cls_offload_flow_rule(cls);
 	struct flow_match_basic basic;
 	struct flow_match_ports ports;
@@ -4363,8 +4407,8 @@ static int airoha_ppe_v1_flow_offload_replace(struct net_device *dev,
 	if (pppoe_sid)
 		airoha_foe_v1_entry_set_pppoe(&entry, pppoe_sid);
 
-	err = airoha_ppe_v1_flow_set_output(&entry, odev, vlan_push, vlan_id,
-				     vlan_prio, &xpon, &endpoint);
+	err = airoha_ppe_v1_flow_set_output(ppe, &entry, odev, vlan_push, vlan_id,
+					    vlan_prio, &xpon, &endpoint);
 	if (err)
 		return err;
 	if (vlan_push && !xpon)
@@ -4409,10 +4453,9 @@ static int airoha_ppe_v1_flow_offload_replace(struct net_device *dev,
 	return 0;
 }
 
-static int airoha_ppe_v1_flow_offload_destroy(struct net_device *dev,
-					       struct flow_cls_offload *cls)
+static int airoha_ppe_v1_flow_offload_destroy(struct airoha_ppe *ppe,
+					      struct flow_cls_offload *cls)
 {
-	struct airoha_ppe *ppe = airoha_ppe_from_netdev(dev);
 	struct airoha_flow_table_entry *flow;
 
 	if (!ppe)
@@ -4483,10 +4526,9 @@ static unsigned long airoha_ppe_v1_flow_lastused(struct airoha_ppe *ppe,
 	return flow->v1_lastused;
 }
 
-static int airoha_ppe_v1_flow_offload_stats(struct net_device *dev,
+static int airoha_ppe_v1_flow_offload_stats(struct airoha_ppe *ppe,
 					    struct flow_cls_offload *cls)
 {
-	struct airoha_ppe *ppe = airoha_ppe_from_netdev(dev);
 	struct airoha_flow_table_entry *flow;
 	unsigned long lastused;
 
@@ -4532,6 +4574,7 @@ static int airoha_ppe_v1_flow_offload_stats(struct net_device *dev,
  */
 struct airoha_ppe_block_priv {
 	struct net_device *dev;
+	struct airoha_ppe *ppe;
 };
 
 static void airoha_ppe_block_priv_release(void *cb_priv)
@@ -4544,19 +4587,22 @@ static int airoha_ppe_tc_block_cb(enum tc_setup_type type, void *type_data,
 {
 	struct airoha_ppe_block_priv *priv = cb_priv;
 	struct net_device *dev = priv->dev;
-	struct airoha_ppe *ppe = airoha_ppe_from_netdev(dev);
+	struct airoha_ppe *ppe = priv->ppe;
 
 	if (!ppe || type != TC_SETUP_CLSFLOWER)
 		return -EOPNOTSUPP;
 
+	if (ppe->common.eth->soc->foe_format != AIROHA_FOE_FORMAT_V1)
+		return airoha_ppe_setup_tc_block_cb(&ppe->common.dev, type_data);
+
 	return airoha_ppe_flow_offload_cmd(ppe->common.eth, dev, type_data,
 					   priv);
 }
 
-static int airoha_ppe_setup_tc_block(struct net_device *dev,
-				 struct flow_block_offload *offload)
+static int airoha_ppe_setup_tc_block(struct airoha_ppe *ppe,
+				     struct net_device *dev,
+				     struct flow_block_offload *offload)
 {
-	struct airoha_ppe *ppe = airoha_ppe_from_netdev(dev);
 	flow_setup_cb_t *cb = airoha_ppe_tc_block_cb;
 	struct airoha_ppe_block_priv *priv;
 	struct flow_block_cb *block_cb;
@@ -4573,12 +4619,15 @@ static int airoha_ppe_setup_tc_block(struct net_device *dev,
 			flow_block_cb_incref(block_cb);
 			return 0;
 		}
-		err = airoha_ppe_v1_engine_arm(ppe);
+		err = 0;
+		if (ppe->common.eth->soc->foe_format == AIROHA_FOE_FORMAT_V1)
+			err = airoha_ppe_v1_engine_arm(ppe);
 		if (err)
 			return err;
 		priv = kzalloc(sizeof(*priv), GFP_KERNEL);
 		if (priv) {
 			priv->dev = dev;
+			priv->ppe = ppe;
 			block_cb = flow_block_cb_alloc(cb, dev, priv,
 						       airoha_ppe_block_priv_release);
 		} else {
@@ -4626,12 +4675,23 @@ static int airoha_ppe_setup_tc(struct airoha_ppe_dev *ppe_dev,
 	switch (type) {
 	case TC_SETUP_BLOCK:
 	case TC_SETUP_FT:
-		return airoha_ppe_setup_tc_block(dev, type_data);
+		return airoha_ppe_setup_tc_block(ppe_dev->priv, dev, type_data);
 	default:
 		return -EOPNOTSUPP;
 	}
 }
 
+int airoha_ppe_setup_tc_wed(struct airoha_eth *eth, struct net_device *dev,
+			    enum tc_setup_type type, void *type_data)
+{
+	if (!eth->ppe || !test_bit(DEV_STATE_REGISTERED, &eth->state))
+		return -ENODEV;
+	if (type != TC_SETUP_BLOCK && type != TC_SETUP_FT)
+		return -EOPNOTSUPP;
+
+	return airoha_ppe_setup_tc_block(eth->ppe, dev, type_data);
+}
+
 static int airoha_ppe_v1_init(struct airoha_eth *eth)
 {
 	u32 dram_entries = eth->soc->ppe_dram_entries;
diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
--- a/drivers/net/ethernet/airoha/airoha_wed.c
+++ b/drivers/net/ethernet/airoha/airoha_wed.c
@@ -30,20 +30,17 @@
 #include <linux/io.h>
 #include <linux/soc/mediatek/mtk_wed.h>
 
+#include "airoha_eth.h"
 #include "airoha_wed.h"
 
 #define MTK_WED_PKT_SIZE		1900
 #define MTK_WED_BUF_SIZE		2048
-#define MTK_WED_TXD_SIZE		128
 #define AIROHA_WDMA_DESC_CTRL_LAST_SEG1	BIT(14)
 #define MTK_WED_BUF_PER_PAGE		(PAGE_SIZE / MTK_WED_BUF_SIZE)
 #define MTK_WED_TX_RING_SIZE		2048
 #define MTK_WED_WDMA_RING_SIZE		1024
-#define MTK_WED_WDMA_DUMMY_RING_SIZE	8
 #define MTK_WED_DLY_INT_CFG		0x210
 #define MTK_WED_DLY_INT_VALUE		0xc014c014
-#define MTK_WED_MT7915_RX_DONE_BAND0	BIT(16)
-#define MTK_WED_MT7915_TX_DONE_MASK	(BIT(30) | BIT(31))
 #define AIROHA_WED_EXT_INT_MASK_VENDOR	0x2c008003
 #define AIROHA_WED_PCIE_OFST		0x564
 #define AIROHA_WED_WPDMA_OFST0		0x584
@@ -168,16 +165,13 @@ wlan_w32(struct mtk_wed_device *dev, u32 phys, u32 val)
 static u32
 mtk_wed_wlan_irq_mask(struct mtk_wed_device *dev, u32 mask)
 {
-	return mask | MTK_WED_MT7915_RX_DONE_BAND0;
+	return mask | BIT(dev->wlan.rx_tbit[0]);
 }
 
 static u32
 mtk_wed_core_irq_mask(struct mtk_wed_device *dev, u32 mask)
 {
-	if (dev->running)
-		return mtk_wed_wlan_irq_mask(dev, mask);
-
-	return mask & ~MTK_WED_MT7915_RX_DONE_BAND0;
+	return mask;
 }
 
 static u32
@@ -190,7 +184,7 @@ static u32
 mtk_wed_wpdma_irq_mask(struct mtk_wed_device *dev, u32 mask)
 {
 	return mtk_wed_wlan_irq_mask(dev, mask) |
-	       MTK_WED_MT7915_TX_DONE_MASK;
+	       BIT(dev->wlan.tx_tbit[0]) | BIT(dev->wlan.tx_tbit[1]);
 }
 
 static void
@@ -362,10 +356,25 @@ mtk_wed_assign(struct mtk_wed_device *dev)
 	if (dev->wlan.bus_type == MTK_WED_BUS_PCIE) {
 		struct device *device = &dev->wlan.pci_dev->dev;
 		struct pci_dev *pdev = dev->wlan.pci_dev;
+		struct pci_host_bridge *bridge = pci_find_host_bridge(pdev->bus);
+		struct device_node *np = dev_of_node(bridge->dev.parent);
+		struct resource res;
 		int index = pci_domain_nr(pdev->bus);
-
+		int i;
+
+		/* Dedicated host bridges both expose root-port slot 0. Match
+		 * their controller address before considering the legacy layout.
+		 */
+		if (!of_address_to_resource(np, 0, &res)) {
+			for (i = 0; i < ARRAY_SIZE(hw_list); i++)
+				if (hw_list[i] && hw_list[i]->pcie_base == res.start) {
+					index = i;
+					goto found;
+				}
+		}
 		if (pdev->bus->self)
 			index = PCI_SLOT(pdev->bus->self->devfn);
+found:
 
 		dev_dbg(device,
 			"wed assign: bus=pcie index=%d wpdma_phys=%08x token_start=%u nbuf=%u\n",
@@ -481,12 +490,14 @@ mtk_wed_tx_buffer_alloc(struct mtk_wed_device *dev)
 
 			desc->buf0 = cpu_to_le32(buf_phys);
 			txd_size = dev->wlan.init_buf(buf, buf_phys, token++);
-			if (WARN_ON_ONCE(txd_size != MTK_WED_TXD_SIZE))
+			if (WARN_ON_ONCE(!txd_size ||
+					 txd_size + MTK_WED_PKT_SIZE >
+					 MTK_WED_BUF_SIZE))
 				return -EINVAL;
 
-			desc->buf1 = cpu_to_le32(buf_phys + MTK_WED_TXD_SIZE);
+			desc->buf1 = cpu_to_le32(buf_phys + txd_size);
 			ctrl = FIELD_PREP(MTK_WDMA_DESC_CTRL_LEN0,
-					  MTK_WED_TXD_SIZE) |
+					  txd_size) |
 			       AIROHA_WDMA_DESC_CTRL_LAST_SEG1 |
 			       FIELD_PREP(MTK_WDMA_DESC_CTRL_LEN1_V2,
 					  MTK_WED_PKT_SIZE);
@@ -685,6 +696,7 @@ __mtk_wed_detach(struct mtk_wed_device *dev)
 	module_put(THIS_MODULE);
 
 	hw->wed_dev = NULL;
+	hw->num_flows = 0;
 }
 
 static void
@@ -703,8 +715,14 @@ static void
 mtk_wed_set_wpdma(struct mtk_wed_device *dev)
 {
 	wed_w32(dev, MTK_WED_WPDMA_CFG_BASE, dev->wlan.wpdma_phys);
-	wed_w32(dev, AIROHA_WED_WPDMA_OFST0, 0x02040200);
-	wed_w32(dev, AIROHA_WED_WPDMA_OFST1, 0x04000300);
+	/* The WiFi driver supplies BAR-relative addresses for each chip. */
+	wed_w32(dev, AIROHA_WED_WPDMA_OFST0,
+		((dev->wlan.wpdma_mask - dev->wlan.wpdma_phys) << 16) |
+		(dev->wlan.wpdma_int - dev->wlan.wpdma_phys));
+	wed_w32(dev, AIROHA_WED_WPDMA_OFST1,
+		((dev->wlan.wpdma_txfree - dev->wlan.wpdma_phys -
+		  0x10) << 16) |
+		(dev->wlan.wpdma_tx - dev->wlan.wpdma_phys));
