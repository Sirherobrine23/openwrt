Subject: [PATCH] phy: xpon: fix an7583 calibration and setup

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/phy/airoha/xpon/Kconfig  |    3 +-
 drivers/phy/airoha/xpon/an7583.c | 1607 +++++++++++++++++---------------------
 drivers/phy/airoha/xpon/core.c   |   25 +-
 3 files changed, 749 insertions(+), 886 deletions(-)

diff --git a/drivers/phy/airoha/xpon/Kconfig b/drivers/phy/airoha/xpon/Kconfig
--- a/drivers/phy/airoha/xpon/Kconfig
+++ b/drivers/phy/airoha/xpon/Kconfig
@@ -45,8 +45,7 @@ config PHY_AIROHA_XPON_AN7581
 	depends on ARCH_AIROHA || COMPILE_TEST
 
 config PHY_AIROHA_XPON_AN7583
-	tristate "xPON PHY for AN7583"
-	depends on BROKEN
+	tristate "GPON PHY for AN7583"
 	default y
 	depends on PHY_AIROHA_XPON
 	depends on ARCH_AIROHA || COMPILE_TEST
diff --git a/drivers/phy/airoha/xpon/an7583.c b/drivers/phy/airoha/xpon/an7583.c
--- a/drivers/phy/airoha/xpon/an7583.c
+++ b/drivers/phy/airoha/xpon/an7583.c
@@ -1,5 +1,9 @@
 // SPDX-License-Identifier: GPL-2.0-only
-/* AN7583 requires a dedicated PHY sequence; now is clone from an7581 */
+/*
+ * AN7583 asymmetric GPON PHY, based on the vendor combo_phy/an7583/pon_pma
+ * implementation. The digital GEPON block uses the shared PHY API, while
+ * the ANA/PMA setup and RX calibration are specific to this SerDes.
+ */
 
 #include <linux/bitfield.h>
 #include <linux/delay.h>
@@ -12,45 +16,29 @@
 
 #include "xpon.h"
 
-#define AN7581_ANA_OFFSET		0xa000
