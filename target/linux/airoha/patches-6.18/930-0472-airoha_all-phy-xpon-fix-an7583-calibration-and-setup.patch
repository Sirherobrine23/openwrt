+struct an7583_xpon_phy {
 	/* Protects calibration, LOS recovery, power transitions and TX gating. */
 	struct mutex lock;
-	u16 revision;
 	bool configured;
 	bool calibrated;
 	bool parked;
@@ -61,687 +49,637 @@ struct an7581_xpon_phy {
 };
 
 /*
- * GPON-only register sequences from en7581_pma.c: pon_CfgPhyType(),
- * pon_LinkControl() and fiber_plug_reset(). Offsets 0xa000/0xb000 select
- * the separately mapped ANA/PMA resources; 0xffff denotes a delay in us.
- * Preserve individual writes: several fields latch on a rising edge.
+ * GPON-only sequences from combo_phy/an7583/pon_pma/src/pon_pma.c.
+ * Offsets 0xe000/0xf000 select the PMA/ANA resources. Keep every write
+ * and delay in order: reset and calibration fields latch on edges.
+ * AIROHA_XPON_PHY_DELAY denotes a delay in microseconds.
  */
