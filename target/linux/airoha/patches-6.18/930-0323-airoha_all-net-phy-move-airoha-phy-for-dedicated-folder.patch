-
-static const struct clk_ops en8811h_clk_ops = {
-	.recalc_rate		= en8811h_clk_recalc_rate,
-	.enable			= en8811h_clk_enable,
-	.disable		= en8811h_clk_disable,
-	.is_enabled		= en8811h_clk_is_enabled,
