-static int en8811h_clk_save_context(struct clk_hw *hw)
-{
-	struct en8811h_priv *priv = clk_hw_to_en8811h_priv(hw);
-
-	priv->cko_is_enabled = en8811h_clk_is_enabled(hw);
-
-	return 0;
