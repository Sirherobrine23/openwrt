From fab817f3c4f0caafd5b7e856c64d590ac29bcbf2 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 27 Oct 2026 21:28:56 -0300
Subject: [PATCH] net: ppe: enable whnat for en751627, en7528 and fix wed for
 old socs

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 .../devicetree/bindings/net/airoha,en7523-wed.yaml |   4 +-
 arch/mips/boot/dts/econet/en7580.dtsi              |   1 +
 drivers/net/ethernet/airoha/Kconfig                |   5 +-
 drivers/net/ethernet/airoha/airoha_eth.c           |  85 +++++++++++++-
 drivers/net/ethernet/airoha/airoha_ppe.c           | 100 ++++++++++++++---
 drivers/net/ethernet/airoha/airoha_wed.c           | 124 +++++++++++++++++++--
 drivers/net/ethernet/airoha/airoha_whnat.c         |  35 +++++-
 drivers/net/ethernet/airoha/airoha_whnat.h         |   9 +-
 8 files changed, 322 insertions(+), 41 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/airoha,en7523-wed.yaml b/Documentation/devicetree/bindings/net/airoha,en7523-wed.yaml
--- a/Documentation/devicetree/bindings/net/airoha,en7523-wed.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7523-wed.yaml
@@ -22,13 +22,15 @@ properties:
           - econet,en751221-wed
           - econet,en751627-wed
           - econet,en7528-wed
+          - econet,en7580-wed
           - airoha,en7523-wed
       - const: syscon
 
   airoha,scu:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
-      System controller used to select LAN arbitration mode on EN7528.
+      System controller used to select LAN arbitration mode on EN751627
+      and EN7528.
 
   reg:
     items:
diff --git a/arch/mips/boot/dts/econet/en7580.dtsi b/arch/mips/boot/dts/econet/en7580.dtsi
--- a/arch/mips/boot/dts/econet/en7580.dtsi
+++ b/arch/mips/boot/dts/econet/en7580.dtsi
@@ -934,6 +934,7 @@ eth: ethernet@1fb50000 {
 				 <&scuclk EN7580_GDMP_RST>;
 			reset-names = "fe", "pdma", "qdma", "gdmp";
 
+			airoha,wed = <&wed0>, <&wed1>;
 			interrupts = <GIC_SHARED 21 IRQ_TYPE_LEVEL_HIGH>, /* QDMA LAN0 */
 			             <GIC_SHARED 22 IRQ_TYPE_LEVEL_HIGH>, /* QDMA WAN0 */
 			             <GIC_SHARED 39 IRQ_TYPE_LEVEL_HIGH>, /* QDMA LAN1 */
diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -51,7 +51,7 @@ config NET_AIROHA_FLOW_STATS
 
 config NET_AIROHA_SOC_WED
 	bool "Airoha WED support"
-	depends on NET_AIROHA && !NET_AIROHA_WHNAT && PCI
+	depends on NET_AIROHA && PCI
 	select NET_MEDIATEK_WED_COMMON
 	help
 	  Enable WiFi Ethernet Datapath (WED) hardware offload.
@@ -63,7 +63,8 @@ config NET_AIROHA_SOC_WED
 
 config NET_AIROHA_WHNAT
 	bool "EcoNet PPE WHNAT"
-	depends on NET_AIROHA && (SOC_ECONET_EN751221 || COMPILE_TEST)
+	depends on NET_AIROHA
+	depends on SOC_ECONET_EN751221 || SOC_ECONET_EN751627 || SOC_ECONET_EN7528 || COMPILE_TEST
 	select CFG80211_HEADERS
 	help
 	  Let PPE forward NAT flows from and to WiFi netdevs
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -372,7 +372,7 @@ void airoha_qdma_skb_get_mtk_meta(struct sk_buff *skb,
 static int econet_rx_headroom(struct airoha_qdma_mips *qdma)
 {
 	if (!IS_ENABLED(CONFIG_NET_AIROHA_WHNAT) || qdma->qdma->id ||
-	    !airoha_is(qdma->qdma->eth, econet_en751221))
+	    !airoha_whnat_supported(qdma->qdma->eth))
 		return 0;
 
 	return AIROHA_WHNAT_RX_HEADROOM;
@@ -481,7 +481,7 @@ static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 	 * duplicate keepalive copy through the network stack a second time.
 	 * Process it first so the PPE can invalidate a changed ingress GEM.
 	 */
-	if (airoha_is(eth, econet_en751221) && reason ==
+	if (eth->soc->foe_format == AIROHA_FOE_FORMAT_V1 && reason ==
 	    AIROHA_PPE_CPU_REASON_KEEPALIVE_DUP_OLD_HDR) {
 		airoha_ppe_dev_check_skb_reason(eth->ppe_dev, skb, hash,
 						reason, ingress_gem);
@@ -2060,6 +2060,58 @@ static int airoha_qdma_mips_xmit(struct airoha_qdma *qdma,
 }
 
 #if IS_ENABLED(CONFIG_NET_AIROHA_WHNAT)
+static int airoha_whnat_modern_xmit(struct airoha_qdma *qdma,
+				    struct sk_buff *skb)
+{
+	struct airoha_queue *q = &qdma->q_tx[0];
+	struct airoha_queue_entry *e, *next;
+	struct airoha_qdma_desc *desc;
+	dma_addr_t addr;
+	u32 msg0, msg1;
+	u16 index;
+
+	if (!airoha_is(qdma->eth, econet_en7580) || !q->ndesc ||
+	    skb_is_nonlinear(skb) || !skb_headlen(skb))
+		return -EOPNOTSUPP;
+
+	guard(spinlock_bh)(&q->lock);
+	if (q->ndesc - q->queued <= AIROHA_WHNAT_TX_RESERVE + 1)
+		return -EAGAIN;
+
+	addr = dma_map_single(qdma->eth->dev, skb->data, skb->len,
+			      DMA_TO_DEVICE);
+	if (dma_mapping_error(qdma->eth->dev, addr))
+		return -ENOMEM;
+
+	e = list_first_entry(&q->tx_list, struct airoha_queue_entry, list);
+	desc = &q->desc[e - q->entry];
+	list_del_init(&e->list);
+	next = list_first_entry(&q->tx_list, struct airoha_queue_entry, list);
+	index = next - q->entry;
+	e->skb = skb;
+	e->dma_addr = addr;
+	e->dma_len = skb->len;
+	e->dma_map_page = false;
+
+	/* LAN QDMA channel 7 feeds the PPE; no netdev/BQL owns this skb. */
+	msg0 = FIELD_PREP(QDMA_ETH_TXMSG_CHAN_MASK, 7);
+	msg1 = FIELD_PREP(EN7580_QDMA_ETH_TXMSG_FPORT_MASK, FE_PSE_PORT_PPE1) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_METER_MASK, 0x7f) | GENMASK(9, 0);
+	WRITE_ONCE(desc->ctrl,
+		   cpu_to_le32(FIELD_PREP(EN7523_QDMA_DESC_LEN_MASK, skb->len)));
+	WRITE_ONCE(desc->addr, cpu_to_le32(addr));
+	WRITE_ONCE(desc->data,
+		   cpu_to_le32(FIELD_PREP(QDMA_DESC_NEXT_ID_MASK, index)));
+	WRITE_ONCE(desc->msg0, cpu_to_le32(msg0));
+	WRITE_ONCE(desc->msg1, cpu_to_le32(msg1));
+	q->queued++;
+	dma_wmb();
+	airoha_qdma_rmw(qdma, REG_TX_CPU_IDX(0), TX_RING_CPU_IDX_MASK,
+			FIELD_PREP(TX_RING_CPU_IDX_MASK, index));
+
+	return 0;
+}
+
 /*
  * Hand a WHNAT frame to the PPE the way the vendor driver does: LAN QDMA,
  * channel 7, queue 0. A return value >= 0 means the frame was queued.
@@ -2069,8 +2121,10 @@ int airoha_whnat_qdma_xmit(struct airoha_qdma *qdma, struct sk_buff *skb)
 	union desc_msg msg = {};
 	int ret;
 
-	if (qdma->id || !qdma->econet || !READ_ONCE(qdma->users))
+	if (qdma->id || !READ_ONCE(qdma->users))
 		return -EOPNOTSUPP;
+	if (!qdma->econet)
+		return airoha_whnat_modern_xmit(qdma, skb);
 
 	set_etx_channel(&msg.etx, 7);
 	set_etx_queue(&msg.etx, 0);
@@ -2807,6 +2861,21 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 			airoha_ppe_check_skb(&eth->ppe->common.dev, q->skb, hash,
 					     false);
 
+		if (airoha_whnat_active()) {
+			bool consumed;
+
+			skb_push(q->skb, ETH_HLEN);
+			consumed = airoha_whnat_rx(q->skb, &q->napi, q->qdma->id,
+						   airoha_qdma_get_rx_sport(eth, desc),
+						   reason, NULL);
+			if (consumed) {
+				q->skb = NULL;
+				done++;
+				continue;
+			}
+			skb_pull(q->skb, ETH_HLEN);
+		}
+
 		done++;
 		napi_gro_receive(&q->napi, q->skb);
 		q->skb = NULL;
@@ -3132,7 +3201,10 @@ static int airoha_qdma_tx_napi_poll(struct napi_struct *napi, int budget)
 		q->queued--;
 
 		if (skb) {
-			airoha_tx_complete(skb);
+			if (skb->dev)
+				airoha_tx_complete(skb);
+			else
+				airoha_whnat_complete();
 			dev_kfree_skb_any(skb);
 		}
 
@@ -3937,7 +4009,7 @@ void airoha_qdma_start(struct airoha_qdma *qdma)
 		econet_wreg(qcfg, &qdma->econet->regs->qdma_cfg);
 
 		/* WHNAT was validated with the vendor's LAN QDMA TX done mode. */
-		if (!qdma->id && airoha_is(qdma->eth, econet_en751221) &&
+		if (!qdma->id && airoha_whnat_supported(qdma->eth) &&
 		    is_qregs_qcfg_tx_immediate_done(&qcfg))
 			airoha_whnat_set_qdma(qdma);
 		return;
@@ -3949,6 +4021,8 @@ void airoha_qdma_start(struct airoha_qdma *qdma)
 	airoha_qdma_set(qdma, REG_QDMA_GLOBAL_CFG,
 			GLOBAL_CFG_TX_DMA_EN_MASK |
 			GLOBAL_CFG_RX_DMA_EN_MASK);
+	if (!qdma->id && airoha_whnat_supported(qdma->eth))
+		airoha_whnat_set_qdma(qdma);
 }
 
 void airoha_qdma_stop(struct airoha_qdma *qdma)
@@ -3982,6 +4056,7 @@ void airoha_qdma_stop(struct airoha_qdma *qdma)
 		return;
 	if (--qdma->users > 0)
 		return;
+	airoha_whnat_clear_qdma(qdma);
 
 	airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG,
 			  GLOBAL_CFG_TX_DMA_EN_MASK |
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -633,6 +633,38 @@ airoha_ppe_xpon_get_tx_info(struct airoha_eth *eth,
 	return eth->ppe_host_ops->xpon_get_tx_info(netdev, false, 0, false, 0, info);
 }
 
+/* EN7580 has a three-bit force port, followed immediately by FQOS. */
+#define EN7580_FOE_IB2_PSE_PORT	GENMASK(7, 5)
+#define EN7580_FOE_IB2_PSE_QOS	BIT(8)
+#define EN7580_FOE_IB2_MULTICAST	BIT(10)
+
+static int airoha_foe_entry_set_wdma(struct airoha_eth *eth,
+				     const struct airoha_wdma_info *info,
+				     u32 *ib2, u32 *qdata)
+{
+	u8 ring = info->idx * 2 + info->queue;
+
+	if (info->idx > 1 || info->queue > 1 ||
+	    info->wcid > 0xff || info->bss > 0x3f)
+		return -EOPNOTSUPP;
+
+	if (airoha_is(eth, airoha_en7523)) {
+		*ib2 |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, ring) |
+			FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT, FE_PSE_PORT_GDM3) |
+			AIROHA_FOE_IB2_PSE_QOS;
+		*qdata |= FIELD_PREP(AIROHA_FOE_CHANNEL, 6 + ring);
+	} else if (airoha_is(eth, econet_en7580)) {
+		/* The SDK routes the four WDMA RX rings through GDM3/NBQ. */
+		*ib2 = FIELD_PREP(AIROHA_FOE_IB2_NBQ, ring) |
+			FIELD_PREP(EN7580_FOE_IB2_PSE_PORT, FE_PSE_PORT_GDM3) |
+			EN7580_FOE_IB2_PSE_QOS;
+	} else {
+		return -EOPNOTSUPP;
+	}
+
+	return (info->wcid << 6) | info->bss;
+}
+
 static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 					struct airoha_foe_entry *hwe,
 					struct net_device *netdev, int type,
@@ -642,6 +674,7 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 	struct airoha_xpon_tx_info xpon = {};
 	u32 qdata = FIELD_PREP(AIROHA_FOE_SHAPER_ID, 0x7f), ports_pad, val;
 	int wlan_etype = -EINVAL, dsa_port = airoha_get_dsa_port(&netdev);
+	int wifi_idx = -1;
 	struct airoha_foe_mac_info_common *l2;
 	bool xpon_flow = false;
 	u8 smac_id = 0xf;
@@ -667,18 +700,11 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 
 		if (!airoha_ppe_get_wdma_info(netdev, data->eth.h_dest,
 					      &info)) {
-			if (airoha_is(eth, airoha_en7523)) {
-				u8 ring = info.idx * 2 + info.queue;
-
-				if (info.idx > 1 || info.queue > 1 ||
-				    info.wcid > 0xff || info.bss > 0x3f)
-					return -EOPNOTSUPP;
-				val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, ring) |
-				       FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT,
-						  FE_PSE_PORT_GDM3) |
-				       AIROHA_FOE_IB2_PSE_QOS;
-				qdata |= FIELD_PREP(AIROHA_FOE_CHANNEL, 6 + ring);
-				wlan_etype = (info.wcid << 6) | info.bss;
+			if (airoha_is(eth, airoha_en7523, econet_en7580)) {
+				wlan_etype = airoha_foe_entry_set_wdma(eth, &info,
+								       &val, &qdata);
+				if (wlan_etype < 0)
+					return wlan_etype;
 				goto wlan_done;
 			}
 			val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, info.idx) |
@@ -698,6 +724,21 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 			struct airoha_gdm_port *port;
 			u8 pse_port, channel, priority;
 
+			if (airoha_whnat_active())
+				wifi_idx = airoha_whnat_vif_index(netdev);
+			if (wifi_idx >= 0) {
+				/* CPU-assisted WiFi egress retains the vif in a VLAN tag. */
+				if (data->vlan.num || data->pppoe.num ||
+				    type != PPE_PKT_TYPE_IPV4_HNAPT)
+					return -EOPNOTSUPP;
+				/* EN7580: disable both six-bit meter/account groups. */
+				val = GENMASK(23, 12);
+				wlan_etype = AIROHA_WHNAT_ETYPE;
+				hwe->ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_VPM, 1) |
+					    FIELD_PREP(AIROHA_FOE_IB1_BIND_VLAN_LAYER, 1);
+				goto wlan_done;
+			}
+
 			if (!eth->ppe_host_ops->is_valid_gdm_dev(eth, dev))
 				return -EINVAL;
 
@@ -778,7 +819,8 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 
 wlan_done:
 	if (is_multicast_ether_addr(data->eth.h_dest))
-		val |= AIROHA_FOE_IB2_MULTICAST;
+		val |= airoha_is(eth, econet_en7580) ?
+			EN7580_FOE_IB2_MULTICAST : AIROHA_FOE_IB2_MULTICAST;
 
 	ports_pad = 0xa5a5a500 | (l4proto & 0xff);
 	if (type == PPE_PKT_TYPE_IPV4_ROUTE)
@@ -820,7 +862,9 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 					    data->pppoe.sid);
 	}
 
-	if (data->vlan.num) {
+	if (wifi_idx >= 0) {
+		l2->vlan1 = wifi_idx;
+	} else if (data->vlan.num) {
 		l2->vlan1 = data->vlan.hdr[0].id;
 		if (data->vlan.num == 2)
 			l2->vlan2 = data->vlan.hdr[1].id;
@@ -2658,6 +2702,7 @@ static int airoha_ppe_datapath_init(struct airoha_eth *eth)
 
 	eth->ppe = ppe;
 	airoha_ppe_common_enable(&ppe->common);
+	airoha_whnat_set_ppe(ppe);
 	dev_info(eth->dev, "PPE Initialization completed successfully\n");
 	return 0;
 
@@ -2673,6 +2718,7 @@ static void airoha_ppe_datapath_deinit(struct airoha_eth *eth)
 {
 	struct airoha_npu *npu;
 
+	airoha_whnat_clear_ppe(eth->ppe);
 	mutex_lock(&flow_offload_mutex);
 
 	npu = rcu_replace_pointer(eth->npu, NULL,
@@ -3134,6 +3180,29 @@ void airoha_whnat_invalidate_vif(struct airoha_ppe *ppe, int idx)
 {
 	struct airoha_flow_table_entry *flow, *tmp;
 
+	if (ppe->common.eth->soc->foe_format != AIROHA_FOE_FORMAT_V1) {
+		u32 i;
+
+		spin_lock_bh(&ppe_lock);
+		for (i = 0; i < airoha_ppe_get_total_num_entries(ppe); i++) {
+			struct hlist_node *n;
+
+			hlist_for_each_entry_safe(flow, n, &ppe->foe_flow[i], list) {
+				struct airoha_foe_mac_info_common *l2;
+
+				if (flow->type != FLOW_TYPE_L4 ||
+				    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE,
+					      flow->data.ib1) != PPE_PKT_TYPE_IPV4_HNAPT)
+					continue;
+				l2 = &flow->data.ipv4.l2.common;
+				if (l2->etype == AIROHA_WHNAT_ETYPE && l2->vlan1 == idx)
+					airoha_ppe_foe_remove_flow(ppe, flow);
+			}
+		}
+		spin_unlock_bh(&ppe_lock);
+		return;
+	}
+
 	spin_lock_bh(&ppe->v1.lock);
 	list_for_each_entry_safe(flow, tmp, &ppe->v1.flows, v1_list) {
 		u32 l2 = airoha_foe_v1_l2(&flow->data)[0];
@@ -4751,8 +4820,7 @@ static int airoha_ppe_v1_init(struct airoha_eth *eth)
 
 	dev_info(dev, "PPE FoE table at %pad, %u entries\n",
 		 &ppe->common.foe_dma, dram_entries);
-	if (airoha_is(eth, econet_en751221))
-		airoha_whnat_set_ppe(ppe);
+	airoha_whnat_set_ppe(ppe);
 	return 0;
 
 error_notifier:
diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
--- a/drivers/net/ethernet/airoha/airoha_wed.c
+++ b/drivers/net/ethernet/airoha/airoha_wed.c
@@ -59,6 +59,88 @@ struct airoha_wed_soc_data {
 
 static struct mtk_wed_hw *hw_list[2];
 static DEFINE_MUTEX(hw_lock);
+static DEFINE_MUTEX(lan_arb_lock);
+
+static u32 lan_sel;
+
+static struct {
+	u32 msi_mask;
+	bool saved;
+} pcie_irq[ARRAY_SIZE(hw_list)];
+
+static struct {
+	struct regmap *scu;
+	bool active;
+} lan_arb[ARRAY_SIZE(hw_list)];
+
+static int airoha_wed_set_lan_arb(struct mtk_wed_hw *hw, bool enable)
+{
+	struct regmap *scu = lan_arb[hw->index].scu;
+	bool shared = false;
+	int i, err;
+
+	if (!scu)
+		return 0;
+
+	guard(mutex)(&lan_arb_lock);
+	if (lan_arb[hw->index].active == enable)
+		return 0;
+
+	/* Both WED instances share the LAN mux. Restore it after the last user. */
+	for (i = 0; i < ARRAY_SIZE(lan_arb); i++)
+		if (i != hw->index && lan_arb[i].active)
+			shared = true;
+
+	if (!shared) {
+		if (enable) {
+			err = regmap_read(scu, ECONET_SCU_LAN_SEL, &lan_sel);
+			if (err)
+				return err;
+		}
+		err = regmap_update_bits(scu, ECONET_SCU_LAN_SEL,
+					 ECONET_SCU_LAN_SEL_MASK,
+					 enable ? ECONET_SCU_LAN_SEL_ARB : lan_sel);
+		if (err)
+			return err;
+	}
+	lan_arb[hw->index].active = enable;
+
+	return 0;
+}
+
+static void airoha_wed_restore_lan(struct mtk_wed_hw *hw)
+{
+	int err = airoha_wed_set_lan_arb(hw, false);
+
+	if (err)
+		dev_err(hw->dev, "failed to restore LAN mux: %d\n", err);
+}
+
+static void airoha_wed_mask_pcie_msi(struct mtk_wed_hw *hw)
+{
+	u32 mask = readl(hw->pcie + AIROHA_PCIE_INT_MASK);
+
+	/* Repeated starts must retain the mask from before WED took ownership. */
+	if (!pcie_irq[hw->index].saved) {
+		pcie_irq[hw->index].msi_mask = mask & AIROHA_PCIE_MSI_MASK;
+		pcie_irq[hw->index].saved = true;
+	}
+	writel(mask | AIROHA_PCIE_MSI_MASK, hw->pcie + AIROHA_PCIE_INT_MASK);
+}
+
+static void airoha_wed_restore_pcie_msi(struct mtk_wed_hw *hw)
+{
+	u32 mask;
+
+	if (!pcie_irq[hw->index].saved)
+		return;
+
+	mask = readl(hw->pcie + AIROHA_PCIE_INT_MASK);
+	mask &= ~AIROHA_PCIE_MSI_MASK;
+	mask |= pcie_irq[hw->index].msi_mask;
+	writel(mask, hw->pcie + AIROHA_PCIE_INT_MASK);
+	pcie_irq[hw->index].saved = false;
