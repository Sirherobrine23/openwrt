diff --git a/drivers/net/ethernet/airoha/airoha_xpon_service.c b/drivers/net/ethernet/airoha/airoha_xpon_service.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_xpon_service.c
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Shared software classifier table for Airoha and EcoNet xPON. */
+
+#include <linux/errno.h>
+#include <linux/string.h>
+
+#include "airoha_eth.h"
+
+/* Same rule from the classifier's point of view?  The cookie is not part of it. */
+static bool airoha_xpon_rule_eq(const struct airoha_xpon_service_cfg *a,
+				const struct airoha_xpon_service_cfg *b)
+{
+	return a->gem_port_id == b->gem_port_id && a->tcont == b->tcont &&
+	       a->queue == b->queue &&
+	       a->vlan_valid == b->vlan_valid &&
+	       (!a->vlan_valid || a->vlan_id == b->vlan_id) &&
+	       a->pcp_valid == b->pcp_valid &&
+	       (!a->pcp_valid || a->pcp == b->pcp) &&
+	       a->default_service == b->default_service;
+}
+
+/* Caller serializes access to the table. */
+int airoha_xpon_find_cookie(const struct airoha_xpon_service_table *table,
+			    u32 cookie)
+{
+	int i, j;
+
+	for (i = 0; i < AIROHA_XPON_MAX_SERVICES; i++) {
+		if (!table->rules[i].valid)
+			continue;
+		for (j = 0; j < table->ncookies[i]; j++)
+			if (table->cookies[i][j] == cookie)
+				return i;
+	}
+	return -1;
+}
+
+void airoha_xpon_forget_cookie(struct airoha_xpon_service_table *table,
+			       u32 cookie)
+{
+	int i, j;
+
+	i = airoha_xpon_find_cookie(table, cookie);
+	if (i < 0)
+		return;
+	for (j = 0; j < table->ncookies[i]; j++) {
+		if (table->cookies[i][j] != cookie)
+			continue;
+		table->ncookies[i]--;
+		table->cookies[i][j] = table->cookies[i][table->ncookies[i]];
+		table->cookies[i][table->ncookies[i]] = 0;
+		break;
+	}
+	if (!table->ncookies[i])
+		memset(&table->rules[i], 0, sizeof(table->rules[i]));
+}
+
+/* Reclaim buckets fragmented by deleting cookies from shared rules. */
+static bool airoha_xpon_compact_services(struct airoha_xpon_service_table *table)
+{
+	bool reclaimed = false;
+	int i, j;
+
+	for (i = 0; i < AIROHA_XPON_MAX_SERVICES; i++) {
+		if (!table->rules[i].valid)
+			continue;
+		for (j = i + 1; j < AIROHA_XPON_MAX_SERVICES; j++) {
+			if (table->ncookies[i] == AIROHA_XPON_SVC_MAX_COOKIES)
+				break;
+			if (!table->rules[j].valid ||
+			    !airoha_xpon_rule_eq(&table->rules[i], &table->rules[j]))
+				continue;
+			while (table->ncookies[j] &&
+			       table->ncookies[i] < AIROHA_XPON_SVC_MAX_COOKIES) {
+				u8 last = --table->ncookies[j];
+
+				table->cookies[i][table->ncookies[i]++] =
+					table->cookies[j][last];
+				table->cookies[j][last] = 0;
+			}
+			if (!table->ncookies[j]) {
+				memset(&table->rules[j], 0, sizeof(table->rules[j]));
+				reclaimed = true;
+			}
+		}
+	}
+	return reclaimed;
+}
+
+/*
+ * Choose the destination before detaching an existing cookie. A failed
+ * replacement must leave both its previous rule and the default intact.
+ * Full cookie buckets spill into another rule slot, as on the EcoNet path.
+ */
+int airoha_xpon_store_service(struct airoha_xpon_service_table *table,
+			      const struct airoha_xpon_service_cfg *cfg)
+{
+	int old, empty, target, i;
+
+retry:
+	old = airoha_xpon_find_cookie(table, cfg->cookie);
+	empty = -1;
+	target = -1;
+	for (i = 0; i < AIROHA_XPON_MAX_SERVICES; i++) {
+		if (empty < 0 &&
+		    (!table->rules[i].valid || (i == old && table->ncookies[i] == 1)))
+			empty = i;
+		if (table->rules[i].valid &&
+		    airoha_xpon_rule_eq(&table->rules[i], cfg) &&
+		    (i == old || table->ncookies[i] < AIROHA_XPON_SVC_MAX_COOKIES)) {
+			target = i;
+			break;
+		}
+	}
+	if (target < 0)
+		target = empty;
+	if (target < 0) {
+		if (airoha_xpon_compact_services(table))
+			goto retry;
+		return -ENOSPC;
+	}
+
+	if (target != old || !airoha_xpon_rule_eq(&table->rules[target], cfg)) {
+		airoha_xpon_forget_cookie(table, cfg->cookie);
+		if (!table->rules[target].valid) {
+			table->rules[target] = *cfg;
+			table->rules[target].valid = true;
+		}
+		table->cookies[target][table->ncookies[target]++] = cfg->cookie;
+	}
+	if (cfg->default_service)
+		for (i = 0; i < AIROHA_XPON_MAX_SERVICES; i++)
+			if (i != target)
+				table->rules[i].default_service = false;
+
+	return 0;
+}
diff --git a/drivers/net/ethernet/airoha/airoha_xpon_service_test.c b/drivers/net/ethernet/airoha/airoha_xpon_service_test.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_xpon_service_test.c
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Cookie sharing and capacity regressions without frame-engine hardware. */
+
+#include <kunit/test.h>
+
+#include "airoha_eth.h"
+
+static struct airoha_xpon_service_cfg airoha_service_cfg(u32 cookie, u16 gem)
+{
+	return (struct airoha_xpon_service_cfg){
+		.cookie = cookie,
+		.gem_port_id = gem,
+		.tcont = 1,
+		.queue = 0,
+		.vlan_id = 100,
+		.vlan_valid = true,
+	};
+}
+
+static unsigned int airoha_service_count(struct airoha_xpon_service_table *table)
+{
+	unsigned int count = 0;
+	int i;
+
+	for (i = 0; i < AIROHA_XPON_MAX_SERVICES; i++)
+		count += table->rules[i].valid;
+	return count;
+}
+
+static int airoha_service_test_init(struct kunit *test)
+{
+	test->priv = kunit_kzalloc(test, sizeof(struct airoha_xpon_service_table),
+				   GFP_KERNEL);
+	return test->priv ? 0 : -ENOMEM;
+}
+
+static void airoha_service_share_test(struct kunit *test)
+{
+	struct airoha_xpon_service_table *table = test->priv;
+	struct airoha_xpon_service_cfg cfg = airoha_service_cfg(1, 257);
+	int slot;
+
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	cfg.cookie = 2;
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	KUNIT_EXPECT_EQ(test, airoha_service_count(table), 1U);
+	airoha_xpon_forget_cookie(table, 1);
+	slot = airoha_xpon_find_cookie(table, 2);
+	KUNIT_ASSERT_GE(test, slot, 0);
+	KUNIT_EXPECT_EQ(test, table->rules[slot].gem_port_id, (u16)257);
+	airoha_xpon_forget_cookie(table, 2);
+	KUNIT_EXPECT_EQ(test, airoha_service_count(table), 0U);
+}
+
+static void airoha_service_bucket_test(struct kunit *test)
+{
+	struct airoha_xpon_service_table *table = test->priv;
+	struct airoha_xpon_service_cfg cfg = airoha_service_cfg(1, 257);
+	unsigned int cookie;
+
+	for (cookie = 1; cookie <= AIROHA_XPON_SVC_MAX_COOKIES; cookie++) {
+		cfg.cookie = cookie;
+		KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	}
+	/* Replaying an existing cookie in a full bucket must not spill. */
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	KUNIT_EXPECT_EQ(test, airoha_service_count(table), 1U);
+	cfg.cookie++;
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	KUNIT_EXPECT_EQ(test, airoha_service_count(table), 2U);
+	for (cookie = 1; cookie <= cfg.cookie; cookie++)
+		airoha_xpon_forget_cookie(table, cookie);
+	KUNIT_EXPECT_EQ(test, airoha_service_count(table), 0U);
+}
+
+static void airoha_service_full_replace_test(struct kunit *test)
+{
+	struct airoha_xpon_service_table *table = test->priv;
+	struct airoha_xpon_service_cfg cfg;
+	unsigned int i;
+	int slot;
+
+	for (i = 1; i <= AIROHA_XPON_MAX_SERVICES; i++) {
+		cfg = airoha_service_cfg(i, i);
+		KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	}
+	cfg = airoha_service_cfg(1, 1000);
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	slot = airoha_xpon_find_cookie(table, 1);
+	KUNIT_ASSERT_GE(test, slot, 0);
+	KUNIT_EXPECT_EQ(test, table->rules[slot].gem_port_id, (u16)1000);
+	KUNIT_EXPECT_EQ(test, airoha_service_count(table),
+			AIROHA_XPON_MAX_SERVICES);
+}
+
+static void airoha_service_failed_replace_test(struct kunit *test)
+{
+	struct airoha_xpon_service_table *table = test->priv;
+	struct airoha_xpon_service_cfg cfg;
+	unsigned int i;
+	int slot;
+
+	for (i = 1; i <= AIROHA_XPON_MAX_SERVICES; i++) {
+		cfg = airoha_service_cfg(i, i);
+		cfg.default_service = i == 1;
+		KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	}
+	cfg = airoha_service_cfg(1000, 1);
+	cfg.default_service = true;
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	/* Cookie 1 cannot reuse its old slot while cookie 1000 references it. */
+	cfg = airoha_service_cfg(1, 1000);
+	KUNIT_EXPECT_EQ(test, airoha_xpon_store_service(table, &cfg), -ENOSPC);
+	slot = airoha_xpon_find_cookie(table, 1);
+	KUNIT_ASSERT_GE(test, slot, 0);
+	KUNIT_EXPECT_EQ(test, table->rules[slot].gem_port_id, (u16)1);
+	KUNIT_EXPECT_TRUE(test, table->rules[slot].default_service);
+	KUNIT_EXPECT_EQ(test, airoha_xpon_find_cookie(table, 1000), slot);
+}
+
+static void airoha_service_compact_test(struct kunit *test)
+{
+	struct airoha_xpon_service_table *table = test->priv;
+	struct airoha_xpon_service_cfg cfg;
+	unsigned int i;
+
+	for (i = 1; i <= AIROHA_XPON_SVC_MAX_COOKIES + 1; i++) {
+		cfg = airoha_service_cfg(i, 1000);
+		KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	}
+	for (i = 1; i <= AIROHA_XPON_MAX_SERVICES - 2; i++) {
+		cfg = airoha_service_cfg(100 + i, i);
+		KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	}
+	airoha_xpon_forget_cookie(table, 1);
+	cfg = airoha_service_cfg(10000, 2000);
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	for (i = 2; i <= AIROHA_XPON_SVC_MAX_COOKIES + 1; i++) {
+		int slot = airoha_xpon_find_cookie(table, i);
+
+		KUNIT_ASSERT_GE(test, slot, 0);
+		KUNIT_EXPECT_EQ(test, table->rules[slot].gem_port_id, (u16)1000);
+	}
+}
+
+static void airoha_service_distinct_queue_test(struct kunit *test)
+{
+	struct airoha_xpon_service_table *table = test->priv;
+	struct airoha_xpon_service_cfg cfg = airoha_service_cfg(1, 257);
+
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	cfg.cookie = 2;
+	cfg.queue = 1;
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	KUNIT_EXPECT_EQ(test, airoha_service_count(table), 2U);
+}
+
+static void airoha_service_wildcard_test(struct kunit *test)
+{
+	struct airoha_xpon_service_table *table = test->priv;
+	struct airoha_xpon_service_cfg cfg = airoha_service_cfg(1, 257);
+
+	cfg.vlan_valid = false;
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	cfg.cookie = 2;
+	cfg.vlan_id = 200;
+	cfg.pcp = 7;
+	KUNIT_ASSERT_EQ(test, airoha_xpon_store_service(table, &cfg), 0);
+	KUNIT_EXPECT_EQ(test, airoha_service_count(table), 1U);
+}
+
+static struct kunit_case airoha_service_test_cases[] = {
+	KUNIT_CASE(airoha_service_share_test),
+	KUNIT_CASE(airoha_service_bucket_test),
+	KUNIT_CASE(airoha_service_full_replace_test),
+	KUNIT_CASE(airoha_service_failed_replace_test),
+	KUNIT_CASE(airoha_service_compact_test),
+	KUNIT_CASE(airoha_service_distinct_queue_test),
+	KUNIT_CASE(airoha_service_wildcard_test),
+	{}
+};
+
+static struct kunit_suite airoha_service_test_suite = {
+	.name = "airoha-xpon-services",
+	.init = airoha_service_test_init,
+	.test_cases = airoha_service_test_cases,
+};
+
+kunit_test_suite(airoha_service_test_suite);

