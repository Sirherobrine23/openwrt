@@ -16,6 +16,26 @@ / {
 	#address-cells = <1>;
 	#size-cells = <1>;
 
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		qdma0_buf: qdma0-buf {
+			size = <0x00200000>;
+			alignment = <0x00010000>;
+			alloc-ranges = <0x00200000 0x0fe00000>;
+			no-map;
+		};
+
+		qdma1_buf: qdma1-buf {
+			size = <0x00800000>;
+			alignment = <0x00010000>;
+			alloc-ranges = <0x00200000 0x0fe00000>;
+			no-map;
+		};
+	};
