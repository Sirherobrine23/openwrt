From 9e7640966e3c9268329ef8a6b4374bd586207291 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Sat, 14 Nov 2026 02:33:25 -0300
Subject: [PATCH] net: xpon: omci: drop the services of an ANI-side bridge port
 when it is deleted

A Delete marks the object pending_delete, works the services out again
and only then removes it. omci_agent_resolve_bridge_locked() skips a
UNI-side MAC bridge port that is marked, and the lookups of the mapper,
the GEM interworking TP, the GEM port CTP and the T-CONT do not return a
marked object, but the walk over the ANI-side ports of the bridge takes
every stored port. Deleting an ANI-side MAC bridge port configuration
data therefore leaves its services installed in hardware until some
later Create, Set or Delete of a datapath class works them out again.

Skip an ANI-side port that is not active, as the UNI side does.

Add a KUnit case for it: a bridge with one UNI-side and one ANI-side
port gets its service installed, and the service has to be gone once
the ANI-side port is marked and the services are worked out again. The
case needs omci_agent_reconcile_services_locked(), so declare it in
internal.h like the other functions the tests call. It fails without
the fix ("Expected ctx->used[i] to be false, but is true") and passes
with it; omci_access_pon_registration fails on UML before and after.

Co-Authored-By: Claude Mythos 5.2 <noreply@anthropic.com>
Signed-off-by: Cristian Papa <pcristian292@gmail.com>
---
 net/xpon/omci/agent.c         |  8 +++--
 net/xpon/omci/internal.h      |  1 +
 net/xpon/omci/services_test.c | 73 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 80 insertions(+), 2 deletions(-)

diff --git a/net/xpon/omci/agent.c b/net/xpon/omci/agent.c
--- a/net/xpon/omci/agent.c
+++ b/net/xpon/omci/agent.c
@@ -759,7 +759,6 @@ omci_agent_profile_state_locked(struct omci_agent *agent,
 static int omci_agent_profile_reconcile_locked(struct omci_device *odev,
 					       u8 old_profile, u8 new_profile);
 static int omci_agent_clear_services_locked(struct omci_device *odev);
-static int omci_agent_reconcile_services_locked(struct omci_device *odev);
 static void omci_agent_reset_duplicate_locked(struct omci_agent *agent);
 
 static void omci_agent_free_object_array(struct xarray *objects)
@@ -3210,9 +3209,14 @@ static int omci_agent_resolve_bridge_locked(
 		u8 wan_type;
 		unsigned int pcp;
 
+		/*
+		 * A port that is being deleted is still stored, marked, while
+		 * the services are worked out without it.
+		 */
 		if (wan_port->class_id !=
 			    OMCI_CLASS_MAC_BRIDGE_PORT_CONFIG_DATA ||
 		    wan_port == lan_port ||
+		    !omci_mib_object_active(agent, wan_port) ||
 		    get_unaligned_be16(wan_port->data) != bridge_id)
 			continue;
 		wan_type = wan_port->data[3];
@@ -3350,7 +3354,7 @@ static int omci_agent_stage_tagging_op_locked(struct omci_device *odev,
 	return 0;
 }
 
-static int omci_agent_reconcile_services_locked(struct omci_device *odev)
+int omci_agent_reconcile_services_locked(struct omci_device *odev)
 {
 	struct omci_agent *agent = &odev->agent;
 	struct omci_mib_object *object;
diff --git a/net/xpon/omci/internal.h b/net/xpon/omci/internal.h
--- a/net/xpon/omci/internal.h
+++ b/net/xpon/omci/internal.h
@@ -53,6 +53,7 @@ struct omci_service_state {
 
 int omci_agent_apply_services_locked(struct omci_device *odev,
 				     struct xarray *desired);
+int omci_agent_reconcile_services_locked(struct omci_device *odev);
 int omci_service_delete(struct omci_device *odev,
 			const struct omci_service_config *config);
 void omci_ext_vlan_parse_rule(struct omci_extended_vlan_rule *rule,
diff --git a/net/xpon/omci/services_test.c b/net/xpon/omci/services_test.c
--- a/net/xpon/omci/services_test.c
+++ b/net/xpon/omci/services_test.c
@@ -838,6 +838,78 @@ static void omci_provider_rollback_test(struct kunit *test)
 		KUNIT_EXPECT_FALSE(test, ctx->vlan_used[i]);
 }
 
+/*
+ * A Delete marks its object, works the services out again and only then
+ * removes it (omci_agent_delete_locked()). Deleting the ANI-side port of a
+ * bridge has to take its service out of the hardware in that step.
+ */
+static void omci_services_deleted_ani_port_test(struct kunit *test)
+{
+	struct omci_services_test_context *ctx = test->priv;
+	struct omci_mib_object *objects, *uni, *lan, *ani, *iwtp, *gem, *tcont;
+	unsigned int i, installed = 0;
+	int ret;
+
+	objects = kunit_kcalloc(test, 6, sizeof(*objects), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, objects);
+	/* Administrative state 0: unlocked */
+	uni = &objects[0];
+	uni->class_id = OMCI_CLASS_PPTP_ETHERNET_UNI;
+	uni->entity_id = 0x101;
+	/* Bridge 1, TP type 1 (PPTP Ethernet UNI) */
+	lan = &objects[1];
+	lan->class_id = OMCI_CLASS_MAC_BRIDGE_PORT_CONFIG_DATA;
+	lan->entity_id = 1;
+	put_unaligned_be16(1, lan->data);
+	lan->data[3] = 1;
+	put_unaligned_be16(uni->entity_id, lan->data + 4);
+	/* Bridge 1, TP type 5 (GEM interworking TP) */
+	ani = &objects[2];
+	ani->class_id = OMCI_CLASS_MAC_BRIDGE_PORT_CONFIG_DATA;
+	ani->entity_id = 2;
+	put_unaligned_be16(1, ani->data);
+	ani->data[3] = 5;
+	put_unaligned_be16(0x201, ani->data + 4);
+	iwtp = &objects[3];
+	iwtp->class_id = OMCI_CLASS_GEM_IWTP;
+	iwtp->entity_id = 0x201;
+	put_unaligned_be16(0x301, iwtp->data);
+	gem = &objects[4];
+	gem->class_id = OMCI_CLASS_GEM_PORT_CTP;
+	gem->entity_id = 0x301;
+	gem->origin = OMCI_MIB_ORIGIN_OLT;
+	put_unaligned_be16(295, gem->data);
+	put_unaligned_be16(0x8000, gem->data + 2);
+	gem->data[4] = OMCI_GEM_PORT_DIRECTION_BIDIRECTIONAL;
+	tcont = &objects[5];
+	tcont->class_id = OMCI_CLASS_TCONT;
+	tcont->entity_id = 0x8000;
+	put_unaligned_be16(295, tcont->data);
+	for (i = 0; i < 6; i++) {
+		unsigned long key = ((unsigned long)objects[i].class_id << 16) |
+				    objects[i].entity_id;
+
+		ret = xa_insert(&ctx->odev.agent.mib, key, &objects[i], GFP_KERNEL);
+		KUNIT_ASSERT_EQ(test, ret, 0);
+	}
+
+	mutex_lock(&ctx->odev.agent.lock);
+	ret = omci_agent_reconcile_services_locked(&ctx->odev);
+	mutex_unlock(&ctx->odev.agent.lock);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	for (i = 0; i < OMCI_TEST_CAPACITY; i++)
+		installed += ctx->used[i] && ctx->hardware[i].gem_port_id == 295;
+	KUNIT_ASSERT_EQ(test, installed, 1U);
+
+	ani->pending_delete = true;
+	mutex_lock(&ctx->odev.agent.lock);
+	ret = omci_agent_reconcile_services_locked(&ctx->odev);
+	mutex_unlock(&ctx->odev.agent.lock);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	for (i = 0; i < OMCI_TEST_CAPACITY; i++)
+		KUNIT_EXPECT_FALSE(test, ctx->used[i]);
+}
+
 static struct kunit_case omci_services_test_cases[] = {
 	KUNIT_CASE(omci_services_full_reprovision_test),
 	KUNIT_CASE(omci_services_changed_cookie_test),
@@ -862,6 +934,7 @@ static struct kunit_case omci_services_test_cases[] = {
 	KUNIT_CASE(omci_services_vlan_delete_failure_test),
 	KUNIT_CASE(omci_services_vlan_restart_test),
 	KUNIT_CASE(omci_services_vlan_no_provider_test),
+	KUNIT_CASE(omci_services_deleted_ani_port_test),
 	{}
 };
 

