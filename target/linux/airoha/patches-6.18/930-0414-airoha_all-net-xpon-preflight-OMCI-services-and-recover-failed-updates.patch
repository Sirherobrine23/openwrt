 drivers/net/ethernet/airoha/airoha_gpon_omci.h |   3 +
 drivers/net/ethernet/airoha/airoha_xpon.c      |  67 +++++-
 include/net/xpon/omci.h                        |   4 +
 net/xpon/Kconfig                               |  10 +
 net/xpon/omci/Makefile                         |   3 +-
 net/xpon/omci/agent.c                          |  83 -------
 net/xpon/omci/internal.h                       |   3 +
 net/xpon/omci/services.c                       | 176 ++++++++++++++
