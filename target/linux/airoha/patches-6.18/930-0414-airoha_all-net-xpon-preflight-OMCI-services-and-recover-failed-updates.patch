+++ b/drivers/net/ethernet/airoha/airoha_gpon_omci.c
@@ -86,6 +86,16 @@ static int airoha_gpon_omci_set_uni(struct omci_device *odev,
 	return airoha_gpon_omci_hw_set_uni(omci->hw_priv, entity_id, enable);
 }
 
+static int
+airoha_gpon_omci_validate_services(struct omci_device *odev,
+				   const struct omci_service_config *services,
+				   size_t count)
+{
+	struct airoha_gpon_omci *omci = omci_device_priv(odev);
+
