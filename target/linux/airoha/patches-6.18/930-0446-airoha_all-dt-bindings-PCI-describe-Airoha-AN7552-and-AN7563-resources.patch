From ebe23363be5a7cccd6ffe2c83101496eb2e84f1d Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sun, 25 Oct 2026 23:41:20 -0300
Subject: [PATCH] dt-bindings: PCI: describe Airoha AN7552 and AN7563 resources

Document the independent Gen2 hosts, their PBUS address decoder and the
shared two-lane PHY. The AN7552 PHY uses a different analog initialization
sequence from EN7523, so give it a separate compatible.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 Documentation/devicetree/bindings/mfd/syscon.yaml  |  2 +
 .../devicetree/bindings/pci/mediatek-pcie.txt      | 26 +++++++++++
 .../bindings/phy/airoha,an7552-pcie-phy.yaml       | 52 ++++++++++++++++++++++
 3 files changed, 80 insertions(+)

diff --git a/Documentation/devicetree/bindings/mfd/syscon.yaml b/Documentation/devicetree/bindings/mfd/syscon.yaml
--- a/Documentation/devicetree/bindings/mfd/syscon.yaml
+++ b/Documentation/devicetree/bindings/mfd/syscon.yaml
@@ -27,6 +27,7 @@ select:
     compatible:
       contains:
         enum:
+          - airoha,an7552-pbus-csr
           - airoha,en7581-pbus-csr
           - airoha,scu-efuse
           - al,alpine-sysfabric-service
@@ -139,6 +140,7 @@ properties:
   compatible:
     items:
       - enum:
+          - airoha,an7552-pbus-csr
           - airoha,en7581-pbus-csr
           - airoha,scu-efuse
           - al,alpine-sysfabric-service
diff --git a/Documentation/devicetree/bindings/pci/mediatek-pcie.txt b/Documentation/devicetree/bindings/pci/mediatek-pcie.txt
--- a/Documentation/devicetree/bindings/pci/mediatek-pcie.txt
+++ b/Documentation/devicetree/bindings/pci/mediatek-pcie.txt
@@ -8,6 +8,8 @@ Required properties:
 	"mediatek,mt7623-pcie"
 	"mediatek,mt7629-pcie"
 	"airoha,en7523-pcie"
+	"airoha,an7552-pcie"
+	"airoha,an7563-pcie"
 - device_type: Must be "pci"
 - reg: Base addresses and lengths of the root ports.
 - reg-names: Names of the above areas to use during resource lookup.
@@ -55,6 +57,30 @@ Required properties for MT2712/MT7622/MT7629:
 	- "pcie_irq": The interrupt that is asserted when an MSI/INTX is received
 - linux,pci-domain: PCI domain ID. Should be unique for each host controller
 
+AN7552/AN7563 use one host node per physical port. Each host exposes its
+root port at device zero; linux,pci-domain selects the physical port, not
+the root port device number. Required properties for these SoCs:
+- linux,pci-domain: Must be 0 for the port at 0x1fa91000, or 1 for the port
+  at 0x1fa92000.
+- reg-names: Must be "port0" or "port1", matching linux,pci-domain.
+- clock-names: Must be "sys_ck0" or "sys_ck1", matching linux,pci-domain.
+- phys: A reference to the shared AN7552/AN7563 PCIe PHY provider.
+- phy-names: Must be "pcie-phy0" or "pcie-phy1", matching linux,pci-domain.
+- interrupts and interrupt-names: One interrupt named "pcie_irq".
+- mediatek,pbus-csr: A phandle to the PBUS syscon with two arguments: the
+  base address register offset and the address mask register offset. Use
+  <&pbus_csr 0x0 0x4> for port 0 and <&pbus_csr 0x8 0xc> for port 1.
+- ranges: Exactly one identity-mapped, 32-bit memory window. Its size must
+  be a power of two from 128 bytes to 2 GiB, with its base aligned to that size.
+- bus-range: Must start at zero.
+- #interrupt-cells, interrupt-map-mask and interrupt-map: Standard PCI IRQ
+  mapping properties, with a child interrupt controller for the four INTx
+  interrupts, as in the MT2712 examples below.
+
+AN7552ST packages do not provide usable PCIe ports; keep both host nodes
+disabled on boards using these packages. Other boards enable only the
+ports that are physically connected and supply their reset pad pinctrl.
+
 In addition, the device tree node must have sub-nodes describing each
 PCIe port interface, having the following mandatory properties:
 
diff --git a/Documentation/devicetree/bindings/phy/airoha,an7552-pcie-phy.yaml b/Documentation/devicetree/bindings/phy/airoha,an7552-pcie-phy.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/airoha,an7552-pcie-phy.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/airoha,an7552-pcie-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha AN7552 and AN7563 PCIe PHY
+
+maintainers:
+  - Matheus Sampaio Queiroga <srherobrine20@gmail.com>
+
+description: |
+  The two PCIe PHY lanes share one provider. Initialization programs both
+  lanes with the AN7552/AN7563 analog settings before the PCIe clock
+  provider releases the endpoints from reset. This PHY does not use the
+  EN7523 crystal-dependent PLL and power-saving sequence.
+
+properties:
+  compatible:
+    enum:
+      - airoha,an7552-pcie-phy
+      - airoha,an7563-pcie-phy
+
+  reg:
+    items:
+      - description: PCIe port 0 analog registers
+      - description: PCIe port 1 analog registers
+
+  reg-names:
+    items:
+      - const: pcie0
+      - const: pcie1
+
+  '#phy-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#phy-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    phy@1fa93700 {
+        compatible = "airoha,an7552-pcie-phy";
+        reg = <0x1fa93700 0x568>, <0x1fa95700 0x568>;
+        reg-names = "pcie0", "pcie1";
+        #phy-cells = <0>;
+    };

