@@ -137,7 +137,7 @@ l2: l2-cache {
 	};
 
 	cpufreq: cpufreq {
-		compatible = "airoha,en7581-cpufreq";
+		compatible = "airoha,en7581-cpufreq", "airoha,an7581-cpufreq";
 
 		operating-points-v2 = <&cpu_smcc_opp_table>;
 
