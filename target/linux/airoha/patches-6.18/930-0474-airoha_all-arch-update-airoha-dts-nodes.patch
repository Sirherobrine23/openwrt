+			                  "wdma-port1", "wdma-woe";
+		};
+
 		eth: ethernet@1fb50000 {
 			compatible = "airoha,an7583-eth";
 			reg = <0 0x1fb50000 0 0x2600>,
@@ -762,6 +790,7 @@ eth: ethernet@1fb50000 {
 			memory-region-names = "qdma0-buf", "qdma1-buf";
 
 			airoha,npu = <&npu>;
+			airoha,wed = <&wed0>, <&wed1>;
 
 			status = "disabled";
 
