+				gsw_phy3: ethernet-phy@11 {
 					compatible = "ethernet-phy-ieee802.3-c22";
 					reg = <11>;
 					phy-mode = "internal";
 					status = "disabled";
 
+					pinctrl-names = "gbe-led";
+					pinctrl-0 = <&swp3_led0 &swp3_led1>;
+					airoha,scu = <&scuclk>;
+
 					leds {
 						#address-cells = <1>;
 						#size-cells = <0>;
 
-						gsw_phy3_led0: led@0 {
+						gsw_phy3_led0: led0@0 {
 							reg = <0>;
+							function = LED_FUNCTION_LAN;
 							status = "disabled";
+							active-low;
 						};
 
-						gsw_phy3_led1: led@1 {
+						gsw_phy3_led1: led1@1 {
 							reg = <1>;
 							status = "disabled";
+							function = LED_FUNCTION_ACTIVITY;
+							active-low;
 						};
 					};
 				};
 
-				gsw_phy4: ethernet-phy@c {
+				gsw_phy4: ethernet-phy@12 {
 					compatible = "ethernet-phy-ieee802.3-c22";
 					reg = <12>;
 					phy-mode = "internal";
 					status = "disabled";
 
+					pinctrl-names = "gbe-led";
+					pinctrl-0 = <&swp4_led0 &swp4_led1>;
+					airoha,scu = <&scuclk>;
+
 					leds {
 						#address-cells = <1>;
 						#size-cells = <0>;
 
-						gsw_phy4_led0: led@0 {
+						gsw_phy4_led0: led0@0 {
 							reg = <0>;
+							function = LED_FUNCTION_LAN;
 							status = "disabled";
+							active-low;
 						};
 
-						gsw_phy4_led1: led@1 {
+						gsw_phy4_led1: led1@1 {
 							reg = <1>;
 							status = "disabled";
+							function = LED_FUNCTION_ACTIVITY;
+							active-low;
 						};
 					};
 				};
