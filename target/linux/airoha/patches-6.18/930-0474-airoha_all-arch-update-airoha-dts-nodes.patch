 				interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
@@ -659,6 +659,62 @@ mux {
 						groups = "pon";
 					};
 				};
+
+				swp1_led0: switch_port-1-led0 {
+					mux {
+						function = "phy1_led0";
+						pins = "gpio22";
+					};
+				};
+	
+				swp1_led1: switch_port-1-led1 {
+					mux {
+						function = "phy1_led1";
+						pins = "gpio7";
+					};
+				};
+	
+				swp2_led0: switch_port-2-led0 {
+					mux {
+						function = "phy2_led0";
+						pins = "gpio23";
+					};
+				};
+	
+				swp2_led1: switch_port-2-led1 {
+					mux {
+						function = "phy2_led1";
+						pins = "gpio6";
+					};
+				};
+	
+				swp3_led0: switch_port-3-led0 {
+					mux {
+						function = "phy3_led0";
+						pins = "gpio24";
+					};
+				};
+	
+				swp3_led1: switch_port-3-led1 {
+					mux {
+						function = "phy3_led1";
+						pins = "gpio5";
+					};
+				};
+	
+				swp4_led0: switch_port-4-led0 {
+					mux {
+						function = "phy4_led0";
+						pins = "gpio25";
+					};
+				};
+	
+				swp4_led1: switch_port-4-led1 {
+					mux {
+						function = "phy4_led1";
+						pins = "gpio4";
+					};
+				};
 			};
 
