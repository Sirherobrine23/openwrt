diff --git a/arch/arm/boot/dts/airoha/an7552.dtsi b/arch/arm/boot/dts/airoha/an7552.dtsi
--- a/arch/arm/boot/dts/airoha/an7552.dtsi
+++ b/arch/arm/boot/dts/airoha/an7552.dtsi
@@ -523,7 +523,13 @@ wed0: wed@1fa02000 {
 		reg = <0x1fa02000 0xb00>,
 		      <0x1fa06000 0x400>;
 		reg-names = "wed", "wdma";
-		interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;
+
+		interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>,
+		             <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
+		             <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>,
+		             <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>;
