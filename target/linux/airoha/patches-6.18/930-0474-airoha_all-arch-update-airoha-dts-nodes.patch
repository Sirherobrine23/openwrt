 						#address-cells = <1>;
 						#size-cells = <0>;
 
-						gsw_phy1_led0: led@0 {
+						gsw_phy1_led0: led0@0 {
 							reg = <0>;
+							function = LED_FUNCTION_LAN;
 							status = "disabled";
+							active-low;
 						};
 
-						gsw_phy1_led1: led@1 {
+						gsw_phy1_led1: led1@1 {
 							reg = <1>;
 							status = "disabled";
+							function = LED_FUNCTION_ACTIVITY;
+							active-low;
 						};
 					};
 				};
 
