From 4ec9cb3b4283b907d497cc0a00fb9545726401d1 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Tue, 27 Oct 2026 00:03:37 -0300
Subject: [PATCH] net: airoha: enable TDMA shared-buffer flow control on EN7581

The vendor FE setup clears bit 23 of PSE_FC_CFG at FE + 0x98 when
SUPPORT_PSE_FC_CFG is enabled, which fe_ic_dis.h restricts to EN7581.
This allows TDMA flow control to use the PSE shared buffer.

Apply the same read-modify-write during FE initialization, after the
PSE core setup and before configuring its queue reservations. Preserve
all unrelated bits and leave other SoCs unchanged. Match the SDK's
unconditional EN7581 setup independently of CONFIG_NET_AIROHA_TSO.

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c  | 5 +++++
 drivers/net/ethernet/airoha/airoha_regs.h | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -6895,6 +6895,11 @@ static int airoha_fe_init(struct airoha_eth *eth)
 	}
 
 	airoha_fe_vip_setup(eth);
+	/* EN7581 TDMA flow control uses the PSE shared buffer. */
+	if (airoha_is(eth, airoha_en7581))
+		airoha_fe_clear(eth, REG_PSE_FC_CFG,
+				EN7581_PSE_TDMA_SHARE_DIS_MASK);
+
 	/* AN7552 retains silicon OQ reservations and the fixed share threshold. */
 	if (!airoha_is(eth, airoha_an7552))
 		airoha_fe_pse_ports_init(eth);
diff --git a/drivers/net/ethernet/airoha/airoha_regs.h b/drivers/net/ethernet/airoha/airoha_regs.h
--- a/drivers/net/ethernet/airoha/airoha_regs.h
+++ b/drivers/net/ethernet/airoha/airoha_regs.h
@@ -163,6 +163,9 @@
 #define PSE_SHARE_USED_MTHD_MASK	GENMASK(31, 16)
 #define PSE_SHARE_USED_HTHD_MASK	GENMASK(15, 0)
 
+#define REG_PSE_FC_CFG			0x0098
+#define EN7581_PSE_TDMA_SHARE_DIS_MASK	BIT(23)
+
 #define REG_GDM_MISC_CFG		0x0148
 #define GDM2_RDM_ACK_WAIT_PREF_MASK	BIT(9)
 #define GDM2_CHN_VLD_MODE_MASK		BIT(5)

