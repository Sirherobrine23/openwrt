From 0e7196ff6de9df224da5d73feabfba7e4a4388e8 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Fri, 30 Oct 2026 17:57:54 -0300
Subject: [PATCH] net: airoha: enable gdmp only en7523 and an7552

and fix xPON MAC start without ToD for an7581/an7583

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c      | 24 +++++++-------
 drivers/net/ethernet/airoha/airoha_eth.h      |  2 +-
 drivers/net/ethernet/airoha/airoha_omci.c     |  1 +
 drivers/net/ethernet/airoha/airoha_omci.h     |  2 --
 drivers/net/ethernet/airoha/airoha_xpon.c     |  4 ++-
 drivers/net/ethernet/airoha/airoha_xpon_tod.c | 45 ++++++++++++++++++++-------
 drivers/net/ethernet/airoha/airoha_xpon_tod.h |  7 ++++-
 7 files changed, 56 insertions(+), 29 deletions(-)

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -6786,9 +6786,11 @@ static void airoha_fe_pse_init(struct airoha_eth *eth)
 {
 	u32 reset = FE_RST_CORE_MASK;
 
-	/* Map the GDMP SRAM to the FE and add its 0x100 pages to the PSE. */
-	airoha_wr(eth->gdmp_regs, 0x74, 3);
-	airoha_fe_wr(eth, eth->soc->pse_fq_cfg, 0x500);
+	/* Only EN7523 and AN7552 extend the PSE pool with GDMP SRAM. */
+	if (airoha_is(eth, airoha_en7523, airoha_an7552)) {
+		airoha_wr(eth->gdmp_regs, 0x74, 3);
+		airoha_fe_wr(eth, eth->soc->pse_fq_cfg, 0x500);
+	}
 
 	if (!airoha_is(eth, airoha_an7552))
 		reset |= FE_RST_GDM3_MBI_ARB_MASK | FE_RST_GDM4_MBI_ARB_MASK;
@@ -10965,10 +10967,6 @@ const struct airoha_eth_soc_data econet_en7580_soc_data = {
 	.ops = {
 		.get_sport = airoha_en7580_get_sport,
 		.get_dev_from_sport = airoha_en7580_get_dev_from_sport,
-
-		// .get_sport = airoha_en7523_get_sport,
-		// .get_vip_port = airoha_en7523_get_vip_port,
-		// .get_dev_from_sport = airoha_en7523_get_dev_from_sport,
 	},
 };
 
@@ -11113,11 +11111,13 @@ static int airoha_eth_probe(struct platform_device *pdev)
 		goto error;
 	}
 
-	eth->gdmp_regs = devm_platform_ioremap_resource_byname(pdev, "gdmp");
-	if (IS_ERR(eth->gdmp_regs)) {
-		err = dev_err_probe(eth->dev, PTR_ERR(eth->gdmp_regs),
-				    "failed to iomap gdmp regs\n");
-		goto error;
+	if (airoha_is(eth, airoha_en7523, airoha_an7552)) {
+		eth->gdmp_regs = devm_platform_ioremap_resource_byname(pdev, "gdmp");
+		if (IS_ERR(eth->gdmp_regs)) {
+			err = dev_err_probe(eth->dev, PTR_ERR(eth->gdmp_regs),
+					    "failed to iomap gdmp regs\n");
+			goto error;
+		}
 	}
 
 	/* These are global FE reset domains on every supported generation.
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -1386,7 +1386,7 @@ struct airoha_eth {
 
 	unsigned long state;
 	void __iomem *fe_regs;
-	void __iomem *gdmp_regs;
+	void __iomem *gdmp_regs; /* use gdmp to expand pse buffer */
 
 	struct airoha_npu __rcu *npu;
 
diff --git a/drivers/net/ethernet/airoha/airoha_omci.c b/drivers/net/ethernet/airoha/airoha_omci.c
--- a/drivers/net/ethernet/airoha/airoha_omci.c
+++ b/drivers/net/ethernet/airoha/airoha_omci.c
@@ -11,6 +11,7 @@
 
 #include "airoha_eth.h"
 #include "airoha_omci.h"
+#include "airoha_xpon_tod.h"
 
 static int airoha_gpon_omci_start_transport(struct omci_device *odev)
 {
diff --git a/drivers/net/ethernet/airoha/airoha_omci.h b/drivers/net/ethernet/airoha/airoha_omci.h
--- a/drivers/net/ethernet/airoha/airoha_omci.h
+++ b/drivers/net/ethernet/airoha/airoha_omci.h
@@ -61,8 +61,6 @@ int airoha_gpon_omci_hw_get_telemetry(void *hw_priv,
 				      struct omci_telemetry *telemetry);
 int airoha_gpon_omci_hw_set_olt_profile(void *hw_priv,
 					const struct omci_olt_profile_state *state);
-int airoha_gpon_omci_hw_set_time_of_day(void *hw_priv,
-				     const struct omci_time_of_day *time);
 void airoha_gpon_omci_hw_set_operational(void *hw_priv, bool operational);
 void airoha_gpon_omci_hw_config_changed(void *hw_priv, u16 key,
 					const struct omci_identity *identity);
diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -5438,8 +5438,10 @@ static int airoha_xpon_probe(struct platform_device *pdev)
 
 	if (airoha_xpon_is_gpon(priv)) {
 		ret = airoha_xpon_tod_init(pdev, priv);
-		if (ret)
+		if (ret == -EPROBE_DEFER)
 			goto err_unregister_xpon;
+		if (ret)
+			dev_warn(dev, "ToD unavailable (%d), continuing without it\n", ret);
 		ret = airoha_xpon_register_gpon_omci(priv);
 		if (ret) {
 			ret = dev_err_probe(dev, ret, "error on register OMCI");
diff --git a/drivers/net/ethernet/airoha/airoha_xpon_tod.c b/drivers/net/ethernet/airoha/airoha_xpon_tod.c
--- a/drivers/net/ethernet/airoha/airoha_xpon_tod.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon_tod.c
@@ -418,6 +418,7 @@ int airoha_xpon_tod_init(struct platform_device *pdev, struct xpon_priv *priv)
 	struct airoha_xpon_tod *tod;
 	struct timespec64 now;
 	struct resource *res;
+	void *group;
 	int ret;
 
 	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "tod");
@@ -429,34 +430,48 @@ int airoha_xpon_tod_init(struct platform_device *pdev, struct xpon_priv *priv)
 		return dev_err_probe(dev, -EOPNOTSUPP, "unsupported ToD integration\n");
 	if (resource_size(res) < TOD_RESOURCE_SIZE)
 		return dev_err_probe(dev, -EINVAL, "ToD register resource is too small\n");
-	tod = devm_kzalloc(dev, sizeof(*tod), GFP_KERNEL);
-	if (!tod)
+	/* A failed optional initialization must not retain MMIO or an IRQ. */
+	group = devres_open_group(dev, NULL, GFP_KERNEL);
+	if (!group)
 		return -ENOMEM;
+	tod = devm_kzalloc(dev, sizeof(*tod), GFP_KERNEL);
+	if (!tod) {
+		ret = -ENOMEM;
+		goto err_release;
+	}
 	tod->priv = priv;
 	mutex_init(&tod->lock);
 	spin_lock_init(&tod->irq_lock);
 	init_completion(&tod->load_done);
 	tod->base = devm_ioremap_resource(dev, res);
-	if (IS_ERR(tod->base))
-		return PTR_ERR(tod->base);
+	if (IS_ERR(tod->base)) {
+		ret = PTR_ERR(tod->base);
+		goto err_release;
+	}
 	tod->irq = platform_get_irq_byname(pdev, "tod");
-	if (tod->irq < 0)
-		return tod->irq;
+	if (tod->irq < 0) {
+		ret = tod->irq;
+		goto err_release;
+	}
 	tod_write(tod, TOD_INT_ENABLE, 0);
 	tod_write(tod, TOD_INT_STATUS, TOD_INT_ALL);
 	ret = devm_request_irq(dev, tod->irq, tod_interrupt, 0, "xpon-tod", tod);
-	if (ret)
-		return dev_err_probe(dev, ret, "failed to request ToD interrupt\n");
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to request ToD interrupt\n");
+		goto err_release;
+	}
 	ret = devm_add_action_or_reset(dev, tod_unregister, tod);
 	if (ret)
-		return ret;
+		goto err_release;
 	tod_write(tod, TOD_INT_ENABLE, TOD_INT_LOAD_DONE);
 	ktime_get_real_ts64(&now);
 	mutex_lock(&tod->lock);
 	ret = tod_load_time(tod, &now, false, 0);
 	mutex_unlock(&tod->lock);
-	if (ret)
-		return dev_err_probe(dev, ret, "failed to initialize ToD clock\n");
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to initialize ToD clock\n");
+		goto err_release;
+	}
 
 	tod->info = (struct ptp_clock_info) {
 		.owner = THIS_MODULE,
@@ -472,10 +487,16 @@ int airoha_xpon_tod_init(struct platform_device *pdev, struct xpon_priv *priv)
 	if (IS_ERR(tod->clock)) {
 		ret = PTR_ERR(tod->clock);
 		tod->clock = NULL;
-		return dev_err_probe(dev, ret, "failed to register ToD PHC\n");
+		dev_err_probe(dev, ret, "failed to register ToD PHC\n");
+		goto err_release;
 	}
 	priv->tod = tod;
+	devres_remove_group(dev, group);
 	dev_info(dev, "ToD initialized, PTP clock index %d\n",
 		 tod->clock ? ptp_clock_index(tod->clock) : -1);
 	return 0;
+
+err_release:
+	devres_release_group(dev, group);
+	return ret;
 }
diff --git a/drivers/net/ethernet/airoha/airoha_xpon_tod.h b/drivers/net/ethernet/airoha/airoha_xpon_tod.h
--- a/drivers/net/ethernet/airoha/airoha_xpon_tod.h
+++ b/drivers/net/ethernet/airoha/airoha_xpon_tod.h
@@ -2,11 +2,16 @@
 #ifndef _AIROHA_XPON_TOD_H
 #define _AIROHA_XPON_TOD_H
 
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+
+struct omci_time_of_day;
 struct platform_device;
 struct xpon_priv;
 
 int airoha_xpon_tod_init(struct platform_device *pdev, struct xpon_priv *priv);
 void airoha_xpon_tod_stop(struct xpon_priv *priv);
 void airoha_xpon_tod_remove(struct xpon_priv *priv);
-
+int airoha_gpon_omci_hw_set_time_of_day(void *hw_priv,
+					const struct omci_time_of_day *time);
 #endif /* _AIROHA_XPON_TOD_H */

