+
 static int gn25l95_vendor_write_byte(struct gn25l95_priv *priv, u8 reg,
 				     u8 val)
 {
@@ -823,6 +916,11 @@ static int gn25l95_read_a0(struct gn25l95_priv *priv, u8 reg, u8 *buf,
 	};
 	int ret;
 
+	if (priv->data->variant == GN28L9X_VARIANT_96) {
