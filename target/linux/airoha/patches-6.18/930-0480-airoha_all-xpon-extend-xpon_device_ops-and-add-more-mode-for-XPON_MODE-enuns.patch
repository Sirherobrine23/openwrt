+static void xpon_opticals_cleanup(struct xpon_device *xpon)
+{
+	u16 i;
+
+	for (i = 0; i < xpon->num_optical; i++) {
+		struct xpon_optical_path *path = xpon->opticals[i];
+
+		put_device(path->dev);
+		kfree(path);
+	}
+	kfree(xpon->opticals);
+	xpon->opticals = NULL;
+	xpon->num_optical = 0;
+}
