 	xa_destroy(&xpon->rx_endpoints);
 	xa_destroy(&xpon->pending_endpoints);
+	xpon_opticals_cleanup(xpon);
 	kfree(xpon->links);
+	kfree(xpon->owned_priv);
 	kfree(xpon);
 }
 
@@ -77,87 +98,330 @@ static void xpon_queue_event(struct xpon_device *xpon, unsigned long changed)
