/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7523.dtsi"

/ {
	model = "Zyxel PX3321-T1";
	compatible = "zyxel,px3321-t1", "airoha,en7523";

	chosen {
		bootargs = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x1fbf0000,115200n8";
		stdout-path = "serial0:115200n8";

		/* Whole-bank FIT images are flashed to tclinux_slave */
		rootdisk = <&tclinux_slave>;

		/* First 2 MiB is boot-firmware territory; Linux DRAM base
		 * starts at 0x80200000 (TEXT_OFFSET applies on top of it).
		 */
		linux,usable-memory-range = <0x80200000 0x1fe00000>;
	};

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-upgrade = &led_power;
		led-running = &led_power;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led@11 {
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_POWER;
		};

		led@1 {
			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_WAN_ONLINE;
		};

		led@10 {
			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
			function = "xpon";
		};

		led@3 {
			gpios = <&pinctrl 3 GPIO_ACTIVE_HIGH>;
			function = "xpon-los";
		};

		led@6 {
			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_WLAN;
		};

		led@8 {
			gpios = <&pinctrl 8 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <5>;
		};

		led@26 {
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_WPS;
		};

		led@9 {
			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_WPS;
			function-enumerator = <5>;
		};

		led@5 {
			gpios = <&pinctrl 5 GPIO_ACTIVE_HIGH>;
			function = "voip";
		};

		led@27 {
			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_USB;
		};
	};
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&switch {
	status = "okay";
};

&gsw_port1 {
	label = "lan4";
	status = "okay";
};

&gsw_port2 {
	label = "lan3";
	status = "okay";
};

&gsw_port3 {
	label = "lan2";
	status = "okay";
};

&gsw_port4 {
	label = "lan1";
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};

&gsw_phy1_led0 {
	status = "okay";
};

&gsw_phy2_led0 {
	status = "okay";
};

&gsw_phy3_led0 {
	status = "okay";
};

&gsw_phy4_led0 {
	status = "okay";
};

&spi0 {
	flash@0 {
		reg = <0>;
		compatible = "spi-nand";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "romfile";
				reg = <0x80000 0x40000>;
				read-only;
			};

			tclinux@c0000 {
				label = "tclinux";
				reg = <0xc0000 0x3000000>;
			};

			tclinux_slave: tclinux_slave@30c0000 {
				label = "tclinux_slave";
				reg = <0x30c0000 0x3100000>;
			};

			partition@61c0000 {
				label = "wwan";
				reg = <0x61c0000 0x100000>;
			};

			partition@62c0000 {
				label = "data";
				reg = <0x62c0000 0x400000>;
			};

			partition@66c0000 {
				label = "rom-d";
				reg = <0x66c0000 0x100000>;
			};

			partition@67c0000 {
				label = "rootfs_data";
				reg = <0x67c0000 0x7600000>;
			};

			reservearea: partition@ddc0000 {
				label = "reservearea";
				reg = <0xddc0000 0x240000>;
			};

		};
	};
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";

	pcie@1,0 {
		device_type = "pci";
		reg = <0x0800 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			mediatek,mtd-eeprom = <&reservearea 0x4c000>;
		};
	};
};

&usb0 {
	status = "okay";
};
