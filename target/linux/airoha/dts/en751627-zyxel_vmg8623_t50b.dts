/dts-v1/;

#include "en751627.dtsi"

/ {
	model = "Zyxel VMG8623-T50B";
	compatible = "zyxel,vmg8623-t50b", "econet,en751627";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		rootdisk = <&firmware>;
		stdout-path = "/serial@1fbf0000:115200";
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
	};

	/* Needs check, extracted from leds.conf */
	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "Reset";
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		key-leds {
			label = "LED switch";
			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_LIGHTS_TOGGLE>;
			debounce-interval = <60>;
		};

		key-wlan {
			label = "WLAN radio";
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
			debounce-interval = <60>;
		};

		key-wps {
			label = "WPS";
			gpios = <&pinctrl 28 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	/* Needs sync with others dts files */
	leds {
		compatible = "gpio-leds";

		led_internet: led-internet {
			label = "internet";
			gpios = <&pinctrl 4 GPIO_ACTIVE_HIGH>;
		};

		led_internet_red: led-internet-red {
			label = "red:internet";
			gpios = <&pinctrl 3 GPIO_ACTIVE_HIGH>;
		};

		led_internet_blue: led-internet-blue {
			label = "blue:internet";
			gpios = <&pinctrl 16 GPIO_ACTIVE_HIGH>;
		};

		led_dsl: led-dsl {
			label = "dsl";
			gpios = <&pinctrl 5 GPIO_ACTIVE_HIGH>;
		};

		led_power_green: led-power-green {
			label = "green:power";
			gpios = <&pinctrl 8 GPIO_ACTIVE_HIGH>;
		};

		led_power_red: led-power-red {
			label = "red:power";
			gpios = <&pinctrl 6 GPIO_ACTIVE_HIGH>;
		};

		led_voip_green: led-voip-green {
			label = "green:voip";
			gpios = <&pinctrl 9 GPIO_ACTIVE_HIGH>;
		};

		led_voip_amber: led-voip-amber {
			label = "amber:voip";
			gpios = <&pinctrl 10 GPIO_ACTIVE_HIGH>;
		};

		led_wlan_2g: led-wlan-2g {
			label = "wlan-2g";
			gpios = <&pinctrl 21 GPIO_ACTIVE_HIGH>;
		};

		led_wlan_5g: led-wlan-5g {
			label = "wlan-5g";
			gpios = <&pinctrl 20 GPIO_ACTIVE_HIGH>;
		};

		led_wps_2g: led-wps-2g {
			label = "wps-2g";
			gpios = <&pinctrl 23 GPIO_ACTIVE_HIGH>;
		};

		led_wps_5g: led-wps-5g {
			label = "wps-5g";
			gpios = <&pinctrl 22 GPIO_ACTIVE_HIGH>;
		};

		led_lan: led-lan {
			label = "lan";
			gpios = <&pinctrl 38 GPIO_ACTIVE_HIGH>;
		};

		led_wan: led-wan {
			label = "wan";
			gpios = <&pinctrl 39 GPIO_ACTIVE_HIGH>;
		};
	};

	// <&pinctrl 24> USB overcurrent flag
	// <&pinctrl 25> USB overcurrent enable
	// usb_vbus_regulator: regulator-usb-vbus {
	// 	compatible = "regulator-fixed";
	// 	regulator-name = "usb_vbus";
	// 	regulator-min-microvolt = <5000000>;
	// 	regulator-max-microvolt = <5000000>;
	// 	gpios = <&pinctrl 24 GPIO_ACTIVE_LOW>, <&pinctrl 25 GPIO_ACTIVE_LOW>;
	// 	regulator-boot-on;
	// };
};

/*
0x00000000-0x00040000 : "bootloader"
0x00040000-0x00080000 : "romfile"
0x00080000-0x02880000 : "tclinux"
0x02880000-0x04f20000 : "tclinux_slave"
0x04f20000-0x05020000 : "wwan"
0x05020000-0x05420000 : "data"
0x05420000-0x05520000 : "rom-d"
0x05520000-0x07520000 : "misc"
0x07520000-0x075e0000 : "reservearea"
*/
&spi0 {
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "loader";
				reg = <0x000000 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "ubi";
				compatible = "linux,ubi";
				reg = <0x100000 0x000000>;

				volumes {
					firmware: ubi-volume-firmware {
						volname = "fit";
						compatible = "denx,uimage";
					};
				};
			};
		};
	};
};

&usb0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&pcie1_slot1 {
	status = "okay";

	mt7615e@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <1>;
		#size-cells = <0>;
		// nvmem-cells = <&eeprom>;
		// nvmem-cell-names = "eeprom";
	};
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";

	// nvmem-cells = <&macaddr 0>;
	// nvmem-cell-names = "mac-address";
};

&xdsl {
	status = "okay";

	// nvmem-cells = <&macaddr 0>;
	// nvmem-cell-names = "mac-address";
};

&switch {
	status = "okay";
};

&gsw_port0 {
	status = "okay";
};

&gsw_port1 {
	status = "okay";
};

&gsw_port2 {
	status = "okay";
};

&gsw_port3 {
	status = "okay";
};

&gsw_port4 {
	status = "okay";

	label = "wan";
};

&gsw_phy0 {
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};

&gsw_phy0_led0 {
	status = "okay";
};

&gsw_phy0_led1 {
	status = "okay";
};

&gsw_phy1_led0 {
	status = "okay";
};

&gsw_phy1_led1 {
	status = "okay";
};

&gsw_phy2_led0 {
	status = "okay";
};

&gsw_phy2_led1 {
	status = "okay";
};

&gsw_phy3_led0 {
	status = "okay";
};

&gsw_phy3_led1 {
	status = "okay";
};

&gsw_phy4_led0 {
	status = "okay";
};

&gsw_phy4_led1 {
	status = "okay";
};
