/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7523.dtsi"

/ {
	model = "Raisecom DR5374";
	compatible = "raisecom,dr5374", "airoha,en7523";

	chosen {
		rootdisk = <&firmware>;
		bootargs = "console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-upgrade = &led_power;
		led-running = &led_power;
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/* Power */
		led_power: led@11 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <11>;
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
		};

		/* Internet Status - Red */
		led@18 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			function-enumerator = <18>;
			gpios = <&pinctrl 18 GPIO_ACTIVE_LOW>;
		};

		/* Internet Status - Green */
		led@19 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <19>;
			gpios = <&pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		/* LAN */
		led@21 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <21>;
			gpios = <&pinctrl 21 GPIO_ACTIVE_LOW>;
		};

		/* WPS */
		led@27 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WPS;
			function-enumerator = <27>;
			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
		};

		/* MESH */
		led@26 {
			/* LED_FUNCTION_MESH isn't implemented yet */
			color = <LED_COLOR_ID_GREEN>;
			function = "mesh";
			function-enumerator = <26>;
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
		};

		/* WIFI */
		led@6 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			function-enumerator = <6>;
			gpios = <&pinctrl 6 GPIO_ACTIVE_LOW>;
		};
	};

	usb_vbus_regulator: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
		regulator-boot-on;
	};
};

/*
Old maping NAND

	0x000000000000-0x000000080000 : "bootloader"
	0x000000080000-0x0000000c0000 : "romfile"
	0x0000000c0000-0x000001ec0000 : "tclinux"
	0x000001ec0000-0x000003cc0000 : "tclinux_slave"
	0x000003cc0000-0x0000040c0000 : "data"
	0x0000040c0000-0x0000042c0000 : "config"
	0x0000042c0000-0x00000ddc0000 : "yaffs"
	0x00000ddc0000-0x00000e000000 : "reservearea"

---------------------------------------------------------------------

New Maping:
	0x00000000-0x00100000 : BL1 + FIP (BL2 + BL31 + BL33)
	0x00100000-           : UBI (uboot env{1,2} + ART (misc part) + fit (firmware))
*/
&spi0 {
	flash@0 {
		reg = <0>;
		compatible = "spi-nand";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x00000000 0x00100000>;
				read-only;
			};

			partition@100000 {
				label = "ubi";
				compatible = "linux,ubi";
				reg = <0x00100000 0x0>;

				volumes {
					ubi-volume-ubootenv {
						volname = "ubootenv";
						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";
						};
					};

					ubi-volume-ubootenv2 {
						volname = "ubootenv2";
						nvmem-layout {
							compatible = "u-boot,env-redundant-bool";

							ubootenv_ethaddr: ethaddr {
								#nvmem-cell-cells = <1>;
							};
						};
					};

					ubi-volume-art {
						volname = "art";
						read-only;

						nvmem-layout {
							compatible = "fixed-layout";
							#address-cells = <1>;
							#size-cells = <1>;

							eeprom0: eeprom@80000 {
								reg = <0x4C000 0x1000>;
							};
						};
					};

					firmware: ubi-volume-firmware {
						volname = "fit";
						compatible = "denx,uimage";
					};
				};
			};
		};
	};
};

&usb0 {
	status = "disabled";
	vbus-supply = <&usb_vbus_regulator>;
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";

	pcie@1,0 {
		reg = <0x00000800 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		mt7916@0,0 {
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			nvmem-cells = <&eeprom0>;
			nvmem-cell-names = "eeprom";
			airoha,eth = <&eth>;

			/* 2.4 GHz - base MAC + 2 (the base MAC is used by eth) */
			band@0 {
				reg = <0>;
				nvmem-cells = <&ubootenv_ethaddr 2>;
				nvmem-cell-names = "mac-address";
			};

			/* 5 GHz - base MAC + 3 */
			band@1 {
				reg = <1>;
				nvmem-cells = <&ubootenv_ethaddr 3>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&i2c0 {
	status = "okay";
};

&npu {
	status = "disabled";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";

	nvmem-cells = <&ubootenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&switch {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
};

&gsw_port6 {
	nvmem-cells = <&ubootenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&gsw_port1 {
	label = "wan";
	status = "okay";
};

&gsw_port2 {
	label = "lan1";
	status = "okay";
};

&gsw_port3 {
	label = "lan2";
	status = "okay";
};

&gsw_port4 {
	label = "lan3";
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};
