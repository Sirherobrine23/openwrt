/dts-v1/;

/memreserve/ 0x80000000 0x200000;

#include "an7552.dtsi"

/ {
	model = "Nokia G-1426G-C (Airtel AOT4221NK)";
	compatible = "nokia,g-1426g-c", "airoha,an7552";

	aliases {
		led-boot = &led_status_red;
		led-failsafe = &led_status_red;
		led-running = &led_status_red;
		led-upgrade = &led_status_blue;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	leds {
		compatible = "gpio-leds";

		led_status_green: led-status-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
		};

		led_status_red: led-status-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pinctrl 21 GPIO_ACTIVE_LOW>;
		};

		led_status_blue: led-status-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
		};

		led_status_white: led-status-white {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 5 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	dxs_fxs: dxs-fxs {
		compatible = "airoha,en75xx-dxs-fxs";
		maxlinear,slic = <&dxs0>;
		airoha,pcm = <&pcm0>;
		airoha,pcm-channels = <0>;
		clock-frequency = <2048000>;
		maxlinear,pcm-tx-edge = <0>;
		maxlinear,pcm-rx-edge = <1>;
		maxlinear,pcm-tx-offset = <7>;
		maxlinear,pcm-rx-offset = <1>;
		airoha,bringup-mode = "identify";
		firmware-name = "airoha-voice/DXS_FW.bin";
		maxlinear,bbd-firmware = "airoha-voice/DXS_BBD.bin";
		maxlinear,dcdc-topology = "IBB12";
	};
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&gdm2_pon {
	status = "okay";
};

&xpon_phy {
	status = "okay";
};

&xpon {
	status = "okay";
};

&switch {
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};

&usb0 {
	status = "okay";
};

&usb0_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&pcm0 {
	status = "okay";
};

&isi0 {
	compatible = "airoha,en7523-csi-spi";
	status = "okay";

	dxs0: slic@0 {
		compatible = "maxlinear,pef32001";
		reg = <0>;
		spi-max-frequency = <2000000>;
		spi-cpol;
		spi-cpha;
		reset-gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
		reset-interval-ms = <10>;
	};
};

/* MediaTek MT7916DBN primary HIF (2.4 GHz + 5 GHz DBDC) */
&pcie0_slot0 {
	mt7916@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <1>;
		#size-cells = <0>;
		nvmem-cells = <&eeprom_factory_0>;
		nvmem-cell-names = "eeprom";
		airoha,npu = <&npu>;
		airoha,eth = <&eth>;

		/* 2.4 GHz */
		band@0 {
			reg = <0>;
			nvmem-cells = <&macaddr_ri_440 2>;
			nvmem-cell-names = "mac-address";
		};

		/* 5 GHz */
		band@1 {
			reg = <1>;
			nvmem-cells = <&macaddr_ri_440 3>;
			nvmem-cell-names = "mac-address";
		};
	};
};

/* MediaTek MT7916DBN secondary HIF */
&pcie1_slot1 {
	mt7916@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <1>;
		#size-cells = <0>;
		nvmem-cells = <&eeprom_factory_0>;
		nvmem-cell-names = "eeprom";
		airoha,npu = <&npu>;
		airoha,eth = <&eth>;
	};
};

&npu {
	status = "okay";
	firmware-names = "rv32", "data";
	firmware-name = "airoha/an7552_mt7916_npu_rv32.bin",
			"airoha/an7552_mt7916_npu_data.bin";
};

&i2c0 {
	status = "okay";

	ux3320: optical-frontend@51 {
		compatible = "ux,ux3320b1";
		reg = <0x51>;
		#optical-frontend-cells = <0>;
		firmware-name = "ux/aot4221nk-ux3320b1-hwconfig.bin";
	};
};

&spi0 {
	flash@0 {
		reg = <0>;
		compatible = "spi-nand";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x0000000 0x0080000>;
				read-only;
			};

			partition@80000 {
				label = "tclinux";
				reg = <0x0080000 0x4600000>;
			};

			partition@4680000 {
				label = "tclinux_slave";
				reg = <0x4680000 0x4600000>;
			};

			partition@8c80000 {
				label = "uboot_env1";
				reg = <0x8c80000 0x0100000>;
			};

			partition@8d80000 {
				label = "uboot_env2";
				reg = <0x8d80000 0x0100000>;
			};

			partition@8e80000 {
				label = "RI";
				reg = <0x8e80000 0x0200000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_ri_440: macaddr@440 {
						compatible = "mac-base";
						reg = <0x440 0x11>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@9080000 {
				label = "Binfo";
				reg = <0x9080000 0x0200000>;
			};

			partition@9280000 {
				label = "cfg";
				reg = <0x9280000 0x1400000>;
			};

			partition@a680000 {
				label = "cfg_bak";
				reg = <0xa680000 0x1400000>;
			};

			partition@ba80000 {
				label = "log";
				reg = <0xba80000 0x0f00000>;
			};

			partition@c980000 {
				label = "extfs";
				reg = <0xc980000 0x0500000>;
			};

			partition@ce80000 {
				label = "mft_data";
				reg = <0xce80000 0x0800000>;
				read-only;
			};

			partition@d680000 {
				label = "art";
				reg = <0xd680000 0x0300000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@2c0000 {
						reg = <0x2c0000 0x1000>;
					};
				};
			};

			/*
			 * Ends at 0x1c000000; 0x1c000000..0x20000000 (64 MiB) is left
			 * unmapped to preserve the vendor U-Boot BMT pool.
			 */
			partition@d980000 {
				label = "data";
				reg = <0xd980000 0xe680000>;
			};
		};
	};
};
