From 532416faeae8a59158e9c214e2dd76cb2a81b1f7 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sun, 15 Nov 2026 20:07:24 -0300
Subject: [PATCH 301/301] mt7915: add support for NPU offload

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 mac80211.c       |   6 +-
 mt7915/Kconfig   |   7 +
 mt7915/Makefile  |   2 +
 mt7915/debugfs.c |   1 +
 mt7915/dma.c     |  69 +++--
 mt7915/mac.c     |   3 +
 mt7915/main.c    |  79 ++++-
 mt7915/mt7915.h  |  72 +++++
 mt7915/npu.c     | 772 +++++++++++++++++++++++++++++++++++++++++++++++
 mt7915/pci.c     |   1 +
 npu.c            |   3 +
 11 files changed, 993 insertions(+), 22 deletions(-)
 create mode 100644 mt7915/npu.c

diff --git a/mac80211.c b/mac80211.c
index eb22604c..af2e47af 100644
--- a/mac80211.c
+++ b/mac80211.c
@@ -1334,6 +1334,8 @@ mt76_check_ccmp_pn(struct sk_buff *skb)
 
 	if (!(status->flag & RX_FLAG_DECRYPTED))
 		return;
+	if (status->flag & RX_FLAG_PN_VALIDATED)
+		return;
 
 	if (status->flag & RX_FLAG_ONLY_MONITOR)
 		return;
@@ -1597,6 +1599,7 @@ void mt76_rx_complete(struct mt76_dev *dev, struct sk_buff_head *frames,
 void mt76_rx_poll_complete(struct mt76_dev *dev, enum mt76_rxq_id q,
 			   struct napi_struct *napi)
 {
+	bool npu_rx_reordered = q == MT_RXQ_NPU0 || q == MT_RXQ_NPU1;
 	struct sk_buff_head frames;
 	struct sk_buff *skb;
 
@@ -1604,7 +1607,8 @@ void mt76_rx_poll_complete(struct mt76_dev *dev, enum mt76_rxq_id q,
 
 	while ((skb = __skb_dequeue(&dev->rx_skb[q])) != NULL) {
 		mt76_check_sta(dev, skb);
-		if (mtk_wed_device_active(&dev->mmio.wed) ||
+		if (npu_rx_reordered ||
+		    mtk_wed_device_active(&dev->mmio.wed) ||
 		    mt76_npu_device_active(dev))
 			__skb_queue_tail(&frames, skb);
 		else
diff --git a/mt7915/Kconfig b/mt7915/Kconfig
index c24be822..14c0e9cc 100644
--- a/mt7915/Kconfig
+++ b/mt7915/Kconfig
@@ -23,3 +23,10 @@ config MT798X_WMAC
 	  This adds support for the built-in WMAC on MT7981 and MT7986 SoC device
 	  which has the same feature set as a MT7915, but enables 6E
 	  support.
+
+config MT7915_NPU
+	bool "MT7915/MT7916 (PCIE) NPU support"
+	depends on MT7915E
+	depends on NET_AIROHA_NPU=y || MT7915E=NET_AIROHA_NPU
+	select MT76_NPU
+	default n
diff --git a/mt7915/Makefile b/mt7915/Makefile
index 7ea5b05c..d56a8937 100644
--- a/mt7915/Makefile
+++ b/mt7915/Makefile
@@ -9,3 +9,5 @@ mt7915e-y := pci.o init.o dma.o eeprom.o main.o mcu.o mac.o \
 mt7915e-$(CONFIG_NL80211_TESTMODE) += testmode.o
 mt7915e-$(CONFIG_MT798X_WMAC) += soc.o
 mt7915e-$(CONFIG_DEV_COREDUMP) += coredump.o
+
+mt7915e-$(CONFIG_MT7915_NPU) += npu.o
diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index 7e561a47..41f46868 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -1308,6 +1308,7 @@ int mt7915_init_debugfs(struct mt7915_phy *phy)
 	struct dentry *dir;
 
 	dir = mt76_register_debugfs_fops(phy->mt76, NULL);
+	mt7915_npu_debugfs(dev, dir);
 
 	debugfs_create_file("muru_debug", 0600, dir, dev, &fops_muru_debug);
 	debugfs_create_file("muru_stats", 0400, dir, phy,
diff --git a/mt7915/dma.c b/mt7915/dma.c
index 60dc1963..4eb7db85 100644
--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -257,6 +257,11 @@ int mt7915_dma_start(struct mt7915_dev *dev, bool reset, bool wed_reset)
 	struct mt76_dev *mdev = &dev->mt76;
 	u32 hif1_ofs = 0;
 	u32 irq_mask;
+	int err;
+
+	err = mt7915_npu_start(dev);
+	if (err)
+		return err;
 
 	if (dev->hif2)
 		hif1_ofs = MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0);
@@ -311,6 +316,13 @@ int mt7915_dma_start(struct mt7915_dev *dev, bool reset, bool wed_reset)
 		int ret;
 
 		wed_irq_mask |= MT_INT_TX_DONE_BAND0 | MT_INT_TX_DONE_BAND1;
+		/* The NPU owns the Wi-Fi data RX rings and their descriptors.
+		 * Do not also route their completion interrupts through WED.
+		 * Keep MCU/WA events and WED TX completions untouched.
+		 */
+		if (mt7915_npu_active(dev))
+			wed_irq_mask &= ~(MT_INT_RX(MT_RXQ_MAIN) |
+					  MT_INT_RX(MT_RXQ_BAND1));
 		if (!is_mt798x(&dev->mt76))
 			mt76_wr(dev, MT_INT_WED_MASK_CSR, wed_irq_mask);
 		else
@@ -324,7 +336,8 @@ int mt7915_dma_start(struct mt7915_dev *dev, bool reset, bool wed_reset)
 		 * and TX flow control when WED is used. Without them the MT7916
 		 * stops taking WED frames after a few and the MCU times out.
 		 */
-		if (is_mt7916(&dev->mt76)) {
+		if (is_mt7916(&dev->mt76))
+		{
 			mt76_rmw(dev, MT_WFDMA0_CTXD_CFG,
 				 MT_WFDMA0_CTXD_CASCADE_NUM |
 				 MT_WFDMA0_CTXD_BAND1_RING |
@@ -340,6 +353,9 @@ int mt7915_dma_start(struct mt7915_dev *dev, bool reset, bool wed_reset)
 		mtk_wed_device_start(&dev->mt76.mmio.wed, wed_irq_mask);
 	}
 
+	if (mt7915_npu_active(dev))
+		irq_mask &= ~(MT_INT_RX(MT_RXQ_MAIN) | MT_INT_RX(MT_RXQ_BAND1));
+
 	irq_mask = reset ? MT_INT_MCU_CMD : irq_mask;
 
 	mt7915_irq_enable(dev, irq_mask);
@@ -438,6 +454,10 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 
 	mt7915_dma_disable(dev, true);
 
+	ret = mt7915_npu_init(dev);
+	if (ret)
+		return ret;
+
 	if (mtk_wed_device_active(&mdev->mmio.wed)) {
 		if (!is_mt798x(mdev)) {
 			u8 wed_control_rx1 = is_mt7915(mdev) ? 1 : 2;
@@ -533,11 +553,17 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 			mdev->q_rx[MT_RXQ_MAIN].wed = &mdev->mmio.wed;
 		}
 
-		ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_MAIN],
-				       MT_RXQ_ID(MT_RXQ_MAIN),
-				       MT7915_RX_RING_SIZE,
-				       MT_RX_BUF_SIZE,
-				       MT_RXQ_RING_BASE(MT_RXQ_MAIN));
+		if (mt7915_npu_active(dev))
+			ret = mt7915_npu_rx_ring(dev, MT_RXQ_MAIN,
+						MT7915_RX_RING_SIZE,
+						MT_RXQ_RING_BASE(MT_RXQ_MAIN) +
+						MT_RXQ_ID(MT_RXQ_MAIN) * 0x10);
+		else
+			ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_MAIN],
+					       MT_RXQ_ID(MT_RXQ_MAIN),
+					       MT7915_RX_RING_SIZE,
+					       MT_RX_BUF_SIZE,
+					       MT_RXQ_RING_BASE(MT_RXQ_MAIN));
 		if (ret)
 			return ret;
 	}
@@ -573,11 +599,17 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 		}
 
 		/* rx data queue for band1 */
-		ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_BAND1],
-				       MT_RXQ_ID(MT_RXQ_BAND1),
-				       MT7915_RX_RING_SIZE,
-				       MT_RX_BUF_SIZE,
-				       MT_RXQ_RING_BASE(MT_RXQ_BAND1) + hif1_ofs);
+		if (mt7915_npu_active(dev))
+			ret = mt7915_npu_rx_ring(dev, MT_RXQ_BAND1,
+						MT7915_RX_RING_SIZE,
+						MT_RXQ_RING_BASE(MT_RXQ_BAND1) +
+						MT_RXQ_ID(MT_RXQ_BAND1) * 0x10);
+		else
+			ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_BAND1],
+					       MT_RXQ_ID(MT_RXQ_BAND1),
+					       MT7915_RX_RING_SIZE,
+					       MT_RX_BUF_SIZE,
+					       MT_RXQ_RING_BASE(MT_RXQ_BAND1) + hif1_ofs);
 		if (ret)
 			return ret;
 
@@ -599,16 +631,19 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 			  mt7915_poll_tx);
 	napi_enable(&dev->mt76.tx_napi);
 
-	mt7915_dma_enable(dev, false);
-
-	return 0;
+	return mt7915_dma_enable(dev, false);
 }
 
 int mt7915_dma_reset(struct mt7915_dev *dev, bool force)
 {
 	struct mt76_phy *mphy_ext = dev->mt76.phys[MT_BAND1];
 	struct mtk_wed_device *wed = &dev->mt76.mmio.wed;
-	int i;
+	int i, err;
+
+	if (mt7915_npu_active(dev)) {
+		err = mt7915_npu_stop(dev);
+		return err ? err : -EOPNOTSUPP;
+	}
 
 	/* clean up hw queues */
 	for (i = 0; i < ARRAY_SIZE(dev->mt76.phy.q_tx); i++) {
@@ -659,14 +694,14 @@ int mt7915_dma_reset(struct mt7915_dev *dev, bool force)
 		mt76_rmw(dev, MT_WFDMA0_EXT0_CFG, MT_WFDMA0_EXT0_RXWB_KEEP,
 			 MT_WFDMA0_EXT0_RXWB_KEEP);
 
-	mt7915_dma_enable(dev, !force);
 
-	return 0;
+	return mt7915_dma_enable(dev, !force);
 }
 
 void mt7915_dma_cleanup(struct mt7915_dev *dev)
 {
 	mt7915_dma_disable(dev, true);
+	mt7915_npu_cleanup(dev);
 
 	mt76_dma_cleanup(&dev->mt76);
 }
diff --git a/mt7915/mac.c b/mt7915/mac.c
index 06cddffa..5c4de49f 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1083,6 +1083,9 @@ void mt7915_queue_rx_skb(struct mt76_dev *mdev, enum mt76_rxq_id q,
 		break;
 	case PKT_TYPE_NORMAL:
 		if (!mt7915_mac_fill_rx(dev, skb, q, info)) {
+			if (mt7915_npu_active(dev) &&
+			    (q == MT_RXQ_NPU0 || q == MT_RXQ_NPU1))
+				mt7915_npu_rx_status(dev, skb, *info);
 			mt76_rx(&dev->mt76, q, skb);
 			return;
 		}
diff --git a/mt7915/main.c b/mt7915/main.c
index e8e4d050..81575518 100644
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -377,7 +377,7 @@ static int mt7915_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 	struct mt76_wcid *wcid = &msta->wcid;
 	u8 *wcid_keyidx = &wcid->hw_key_idx;
 	int idx = key->keyidx;
-	int err = 0;
+	int err = 0, i;
 
 	if (sta && !wcid->sta) {
 		if (cmd != SET_KEY)
@@ -417,6 +417,29 @@ static int mt7915_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 
 	mutex_lock(&dev->mt76.mutex);
 
+	/* Key changes retire NPU BA state before the new replay epoch. */
+	if (cmd == SET_KEY && sta) {
+		err = mt7915_npu_sta_clear(dev, phy->mt76->band_idx, wcid->idx);
+		if (err)
+			goto out;
+	} else if (cmd == SET_KEY && mt7915_npu_active(dev)) {
+		for (i = 1; i < ARRAY_SIZE(dev->mt76.wcid); i++) {
+			struct mt76_wcid *peer;
+			struct mt7915_sta *peer_sta;
+
+			peer = rcu_dereference_protected(dev->mt76.wcid[i],
+					lockdep_is_held(&dev->mt76.mutex));
+			if (!peer || !peer->sta)
+				continue;
+			peer_sta = container_of(peer, struct mt7915_sta, wcid);
+			if (peer_sta->vif != mvif)
+				continue;
+			err = mt7915_npu_sta_clear(dev, phy->mt76->band_idx, i);
+			if (err)
+				goto out;
+		}
+	}
+
 	if (cmd == SET_KEY && !sta && !mvif->mt76.cipher) {
 		mvif->mt76.cipher = mt76_connac_mcu_get_cipher(key->cipher);
 		mt7915_mcu_add_bss_info(phy, vif, true);
@@ -766,7 +789,7 @@ int mt7915_mac_sta_add(struct mt76_dev *mdev, struct ieee80211_vif *vif,
 	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
 	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
 	bool ext_phy = mvif->phy != &dev->phy;
-	int idx;
+	int idx, err;
 
 	if (mtk_wed_device_active(&dev->mt76.mmio.wed) &&
 	    !is_mt7915(&dev->mt76) &&
@@ -779,6 +802,12 @@ int mt7915_mac_sta_add(struct mt76_dev *mdev, struct ieee80211_vif *vif,
 	if (idx < 0)
 		return -ENOSPC;
 
+	err = mt7915_npu_sta_clear(dev, mvif->phy->mt76->band_idx, idx);
+	if (err) {
+		mt76_wcid_mask_clear(mdev->wcid_mask, idx);
+		return err;
+	}
+
 	INIT_LIST_HEAD(&msta->rc_list);
 	INIT_LIST_HEAD(&msta->wcid.poll_list);
 	msta->vif = mvif;
@@ -909,6 +938,12 @@ void mt7915_mac_sta_remove(struct mt76_dev *mdev, struct ieee80211_vif *vif,
 {
 	struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
 	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+	int err;
+
+	err = mt7915_npu_sta_clear(dev, msta->vif->phy->mt76->band_idx,
+				   msta->wcid.idx);
+	if (err)
+		dev_warn(mdev->dev, "NPU station cleanup failed: %d\n", err);
 
 	mt7915_mac_wtbl_update(dev, msta->wcid.idx,
 			       MT_WTBL_UPDATE_ADM_COUNT_CLEAR);
@@ -988,10 +1023,23 @@ mt7915_ampdu_action(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 		mt76_rx_aggr_start(&dev->mt76, &msta->wcid, tid, ssn,
 				   params->buf_size);
 		ret = mt7915_mcu_add_rx_ba(dev, params, true);
+		/* Kite BA also reorders protected frames; PN stays with mac80211. */
+		if (!ret && msta->npu_authorized &&
+		    vif->type == NL80211_IFTYPE_AP)
+			ret = mt7915_npu_ba(dev, msta->vif->phy->mt76->band_idx,
+					    msta->wcid.idx, tid, ssn,
+					    params->buf_size);
+		if (ret) {
+			mt7915_mcu_add_rx_ba(dev, params, false);
+			mt76_rx_aggr_stop(&dev->mt76, &msta->wcid, tid);
+		}
 		break;
 	case IEEE80211_AMPDU_RX_STOP:
 		mt76_rx_aggr_stop(&dev->mt76, &msta->wcid, tid);
-		ret = mt7915_mcu_add_rx_ba(dev, params, false);
+		ret = mt7915_npu_ba(dev, msta->vif->phy->mt76->band_idx,
+				    msta->wcid.idx, tid, 0, 0);
+		if (!ret)
+			ret = mt7915_mcu_add_rx_ba(dev, params, false);
 		break;
 	case IEEE80211_AMPDU_TX_OPERATIONAL:
 		mtxq->aggr = true;
@@ -1853,6 +1901,29 @@ mt7915_reconfig_complete(struct ieee80211_hw *hw,
 				     MT7915_WATCHDOG_TIME);
 }
 
+static int mt7915_sta_state(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			    struct ieee80211_sta *sta,
+			    enum ieee80211_sta_state old_state,
+			    enum ieee80211_sta_state new_state)
+{
+	struct mt7915_dev *dev = mt7915_hw_dev(hw);
+	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+	struct mt7915_vif *mvif = (struct mt7915_vif *)vif->drv_priv;
+	int ret;
+
+	if (old_state == IEEE80211_STA_AUTHORIZED && new_state < old_state) {
+		ret = mt7915_npu_sta_clear(dev, mvif->phy->mt76->band_idx,
+					   msta->wcid.idx);
+		if (ret)
+			return ret;
+		msta->npu_authorized = false;
+	}
+	ret = mt76_sta_state(hw, vif, sta, old_state, new_state);
+	if (!ret && new_state == IEEE80211_STA_AUTHORIZED)
+		msta->npu_authorized = true;
+	return ret;
+}
+
 const struct ieee80211_ops mt7915_ops = {
 	.add_chanctx = ieee80211_emulate_add_chanctx,
 	.remove_chanctx = ieee80211_emulate_remove_chanctx,
@@ -1869,7 +1940,7 @@ const struct ieee80211_ops mt7915_ops = {
 	.bss_info_changed = mt7915_bss_info_changed,
 	.start_ap = mt7915_start_ap,
 	.stop_ap = mt7915_stop_ap,
-	.sta_state = mt76_sta_state,
+	.sta_state = mt7915_sta_state,
 	.sta_pre_rcu_remove = mt76_sta_pre_rcu_remove,
 	.link_sta_rc_update = mt7915_sta_rc_update,
 	.set_key = mt7915_set_key,
diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
index 7ee9bed8..936f1be1 100644
