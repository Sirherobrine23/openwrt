From 495ecd9f9a9dcd7a81800cb326b2aad3e77dd3e5 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 18 Nov 2026 23:43:00 -0300
Subject: [PATCH] spi: airoha: fix dma mapping ram address for MIPS

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 configs/en751627_reference_defconfig |  1 +
 drivers/spi/airoha_snfi_spi.c        | 24 ++++++++++++++++++++++--
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/configs/en751627_reference_defconfig b/configs/en751627_reference_defconfig
index 7bdc8eae..8f767011 100644
--- a/configs/en751627_reference_defconfig
+++ b/configs/en751627_reference_defconfig
@@ -34,6 +34,7 @@ CONFIG_CMD_MEMINFO=y
 CONFIG_CMD_BIND=y
 CONFIG_CMD_GPIO=y
 CONFIG_CMD_MTD=y
+CONFIG_CMD_TFTPPUT=y
 CONFIG_CMD_DHCP=y
 CONFIG_CMD_MII=y
 CONFIG_CMD_PING=y
diff --git a/drivers/spi/airoha_snfi_spi.c b/drivers/spi/airoha_snfi_spi.c
index c9d01b21..977b4dce 100644
--- a/drivers/spi/airoha_snfi_spi.c
+++ b/drivers/spi/airoha_snfi_spi.c
@@ -272,6 +272,24 @@ struct airoha_snand_priv {
 	int dma;
 };
 
+/*
+ * dma_map_single() in this U-Boot keeps the CPU virtual address as its
+ * mapping cookie. On 32-bit MIPS, KSEG0/KSEG1 aliases (0x8.../0xa...)
+ * are not physical addresses that the NFI bus master can DMA to.
+ * Keep the original cookie for dma_unmap_single(), but program the
+ * controller with the physical address of the buffer.
+ */
+static dma_addr_t airoha_snand_dma_hw_addr(void *buf, dma_addr_t mapped)
+{
+#ifdef CONFIG_MIPS
+	(void)mapped;
+	return virt_to_phys(buf);
+#else
+	(void)buf;
+	return mapped;
+#endif
+}
+
 static void airoha_snand_update_bits(void __iomem *base, u32 reg,
 				     u32 mask, u32 value)
 {
@@ -920,7 +938,8 @@ static ssize_t airoha_snand_dirmap_read(struct spi_mem_dirmap_desc *desc,
 				  DMA_FROM_DEVICE);
 
 	/* set dma addr */
-	NFI_WRITE(priv, REG_SPI_NFI_STRADDR, dma_addr);
+	NFI_WRITE(priv, REG_SPI_NFI_STRADDR,
+		  airoha_snand_dma_hw_addr(txrx_buf, dma_addr));
 
 	/*
 	 * Setup transfer length
@@ -1064,7 +1083,8 @@ static ssize_t airoha_snand_dirmap_write(struct spi_mem_dirmap_desc *desc,
 				  DMA_TO_DEVICE);
 
 	/* set dma addr */
-	NFI_WRITE(priv, REG_SPI_NFI_STRADDR, dma_addr);
+	NFI_WRITE(priv, REG_SPI_NFI_STRADDR,
+		  airoha_snand_dma_hw_addr(txrx_buf, dma_addr));
 
 	/*
 	 * Setup transfer length
-- 
2.56.1

