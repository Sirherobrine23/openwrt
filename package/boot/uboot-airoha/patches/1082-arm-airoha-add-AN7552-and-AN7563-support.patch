diff --git a/arch/arm/dts/an7552-evb.dts b/arch/arm/dts/an7552-evb.dts
new file mode 100644
index 00000000..7ae5e6ce
--- /dev/null
+++ b/arch/arm/dts/an7552-evb.dts
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+#include "an7552.dtsi"
+
+/ {
+	model = "Airoha AN7552 Evaluation Board";
+	compatible = "airoha,an7552-evb", "airoha,an7552";
+};
+
+&eth {
+	status = "okay";
+};
+
+&spi0 {
+	status = "okay";
+
+	nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+		spi-tx-bus-width = <1>;
+		spi-rx-bus-width = <2>;
+	};
+};
diff --git a/arch/arm/dts/an7552.dtsi b/arch/arm/dts/an7552.dtsi
new file mode 100644
index 00000000..0701e310
--- /dev/null
+++ b/arch/arm/dts/an7552.dtsi
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/clock/en7523-clk.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/reset/airoha,en7523-reset.h>
+
+/ {
+	compatible = "airoha,an7552";
+	#address-cells = <1>;
+	#size-cells = <1>;
+	interrupt-parent = <&gic>;
+
+	aliases {
+		serial0 = &uart1;
+		spi0 = &snfi;
+		ethernet0 = &gdm1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		atf@80000000 {
+			reg = <0x80000000 0x200000>;
+			no-map;
+		};
+
+		npu@84000000 {
+			reg = <0x84000000 0x400000>;
+			no-map;
+		};
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					cpu = <&cpu0>;
+				};
+				core1 {
+					cpu = <&cpu1>;
+				};
+			};
+		};
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x0>;
+			enable-method = "psci";
+			clock-frequency = <80000000>;
+			next-level-cache = <&L2_0>;
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x1>;
+			enable-method = "psci";
+			clock-frequency = <80000000>;
+			next-level-cache = <&L2_0>;
+		};
+
+		L2_0: l2-cache0 {
+			compatible = "cache";
+			cache-level = <2>;
+			cache-unified;
+		};
+	};
+
+	psci {
+		compatible = "arm,psci-0.2";
+		method = "smc";
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
+	};
+
+	gic: interrupt-controller@9000000 {
+		compatible = "arm,gic-v3";
+		reg = <0x09000000 0x20000>,
+		      <0x09080000 0x80000>,
+		      <0x09400000 0x2000>,
+					      <0x09500000 0x2000>,
+		      <0x09600000 0x20000>;
+
+		interrupt-controller;
+		#interrupt-cells = <3>;
+		#address-cells = <0>;
+
+		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_LOW>;
+	};
+
+	/* Keep the existing U-Boot CHIP SCU / NP SCU resource order. */
+	scu: system-controller@1fa20000 {
+		compatible = "airoha,an7552-scu";
+		reg = <0x1fa20000 0x400>,
+		      <0x1fb00000 0x1000>;
+
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+
+	system-controller@1fbf0200 {
+		compatible = "syscon", "simple-mfd";
+		reg = <0x1fbf0200 0xc0>;
+
+		pinctrl: pinctrl {
+			compatible = "airoha,an7563-pinctrl";
+
+			gpio-controller;
+			#gpio-cells = <2>;
+
+			gpio-ranges = <&pinctrl 0 0 38>;
+		};
+	};
+
+	uart1: serial@1fbf0000 {
+		bootph-all;
+		compatible = "ns16550";
+		reg = <0x1fbf0000 0x30>;
+		reg-io-width = <4>;
+		reg-shift = <2>;
+		clock-frequency = <1843200>;
+		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	spi0: spi@1fa10000 {
+		compatible = "airoha,en7523-spi";
+		reg = <0x1fa10000 0x140>,
+		      <0x1fa11000 0x600>;
+
+		clocks = <&scu EN7523_CLK_SPI>;
+		clock-names = "spi";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		status = "disabled";
+	};
+
+	eth: ethernet@1fb50000 {
+		compatible = "airoha,an7552-eth";
+		reg = <0x1fb50000 0x2600>,
+		      <0x1fb54000 0x2000>,
+		      <0x1fbf9000 0x1000>;
+		reg-names = "fe", "qdma0", "gdmp";
+
+		resets = <&scu EN7523_FE_RST>,
+		         <&scu EN7523_FE_PDMA_RST>,
+		         <&scu EN7523_FE_QDMA_RST>,
+			       <&scu EN7523_GSW_RST>;
+		reset-names = "fe", "pdma", "qdma", "switch";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "disabled";
+
+		gdm1: ethernet@1 {
+			compatible = "airoha,eth-mac";
+			reg = <1>;
+			phy-mode = "internal";
+
+			fixed-link {
+				speed = <10000>;
+				full-duplex;
+				pause;
+			};
+		};
+	};
+
+	switch: switch@1fb58000 {
+		compatible = "airoha,an7552-switch";
+		reg = <0x1fb58000 0x8000>;
+
+		mdio: mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			ethernet-phy@9 {
+				reg = <9>;
+				airoha,mdi-resistor-ohms = <5>;
+			};
+
+			ethernet-phy@a {
+				reg = <10>;
+				airoha,mdi-resistor-ohms = <5>;
+			};
+
+			ethernet-phy@b {
+				reg = <11>;
+				airoha,mdi-resistor-ohms = <5>;
+			};
+
+			ethernet-phy@c {
+				reg = <12>;
+				airoha,mdi-resistor-ohms = <5>;
+			};
+		};
+	};
+};
