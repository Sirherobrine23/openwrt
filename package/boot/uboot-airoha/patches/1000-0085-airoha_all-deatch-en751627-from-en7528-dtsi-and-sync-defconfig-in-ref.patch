From bb774ffb7df2ec0f3194ed3f4d13c129226bee25 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Wed, 18 Nov 2026 22:11:35 -0300
Subject: [PATCH] deatch en751627 from en7528 dtsi and sync defconfig in ref

---
 arch/mips/dts/econet,en751627-reference.dts |  40 +++++---
 arch/mips/dts/econet,en751627.dtsi          | 153 +++++++++++++++++++++++-----
 arch/mips/mach-econet/en7528/init.c         |  21 ++--
 configs/en751627_reference_defconfig        |  26 +++--
 4 files changed, 192 insertions(+), 48 deletions(-)

diff --git a/arch/mips/dts/econet,en751627-reference.dts b/arch/mips/dts/econet,en751627-reference.dts
--- a/arch/mips/dts/econet,en751627-reference.dts
+++ b/arch/mips/dts/econet,en751627-reference.dts
@@ -22,18 +22,6 @@
 	status = "okay";
 };
 
-&spi0 {
-	status = "okay";
-
-	flash@0 {
-		compatible = "spi-nand";
-		reg = <0>;
-		spi-max-frequency = <25000000>;
-		spi-tx-bus-width = <1>;
-		spi-rx-bus-width = <1>;
-	};
-};
-
 &eth {
 	status = "okay";
 };
@@ -45,3 +33,31 @@
 &switch {
 	status = "okay";
 };
+
+&spi0 {
+	status = "okay";
+
+	nand: nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+		spi-tx-bus-width = <1>;
+		spi-rx-bus-width = <2>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+	
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x100000>;
+			};
+	
+			partition@100000 {
+				label = "ubi";
+				reg = <0x100000 0x000000>;
+			};
+		};
+	};
+};
diff --git a/arch/mips/dts/econet,en751627.dtsi b/arch/mips/dts/econet,en751627.dtsi
--- a/arch/mips/dts/econet,en751627.dtsi
+++ b/arch/mips/dts/econet,en751627.dtsi
@@ -1,34 +1,141 @@
 // SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
-/* EN7516/EN7527 is the big-endian member of the EN7528 family. */
-#include "econet,en7528.dtsi"
+
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/clock/econet,en7528-scu.h>
+#include <dt-bindings/reset/econet,en7528-scu.h>
 
 / {
 	compatible = "econet,en751627", "airoha,en751627";
-};
+	#address-cells = <1>;
+	#size-cells = <1>;
 
-&chip_scu {
-	compatible = "airoha,scuclk", "airoha,en751627-chip-scu",
-		     "airoha,en7528-chip-scu", "syscon";
-	native-endian;
-};
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
 
-&scuclk {
-	compatible = "airoha,en751627-scu", "airoha,en7528-scu", "syscon";
-	native-endian;
-};
+		cpu@0 {
+			compatible = "mips,mips1004Kc";
+			device_type = "cpu";
+			reg = <0>;
+		};
+	};
 
-&uart0 {
-	big-endian;
-};
+	aliases {
+		serial0 = &uart0;
+		ethernet0 = &gdm1;
+	};
 
-&spi0 {
-	native-endian;
-};
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
 
-&eth {
-	compatible = "econet,en751627-eth";
-};
+		chip_scu: syscon@1fa20000 {
+			compatible = "airoha,scuclk", "airoha,en751627-chip-scu",
+				     "airoha,en7528-chip-scu", "syscon";
+			reg = <0x1fa20000 0x400>;
+		};
+
+		scuclk: system-controller@1fb00000 {
+			compatible = "airoha,en751627-scu", "airoha,en7528-scu", "syscon";
+			reg = <0x1fb00000 0x1000>;
+
+			airoha,chip-scu = <&chip_scu>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		system-controller@1fbf0200 {
+			compatible = "syscon", "simple-mfd";
+			reg = <0x1fbf0200 0xc0>;
+
+			pinctrl: pinctrl {
+				compatible = "airoha,en7528-pinctrl";
+				airoha,chip-scu = <&chip_scu>;
+
+				gpio-controller;
+				#gpio-cells = <2>;
+				gpio-ranges = <&pinctrl 0 0 42>;
+			};
+		};
+
+		uart0: serial@1fbf0000 {
+			compatible = "ns16550";
+			reg = <0x1fbf0000 0x30>;
+
+			reg-io-width = <4>;
+			reg-shift = <2>;
+
+			clock-frequency = <1843200>;
+			current-speed = <115200>;
+			big-endian;
+
+			status = "disabled";
+		};
+
+		spi0: spi@1fa10000 {
+			compatible = "airoha,en7523-spi";
+			reg = <0x1fa10000 0x140>,
+			      <0x1fa11000 0x600>;
+
+			clocks = <&scuclk EN7528_CLK_SPI>;
+			clock-names = "spi";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			status = "disabled";
+		};
+
+		eth: ethernet@1fb50000 {
+			compatible = "econet,en751627-eth";
+			status = "disabled";
+			reg = <0x1fb50000 0x2600>,
+			      <0x1fb54000 0x1000>,
+			      <0x1fb55000 0x1000>,
+			      <0x1fa40000 0x8000>;
+			reg-names = "fe", "qdma0", "qdma1", "gdmp";
+
+			resets = <&scuclk EN7528_FE_RST>,
+				 <&scuclk EN7528_FE_QDMA1_RST>,
+				 <&scuclk EN7528_FE_QDMA2_RST>,
+				 <&scuclk EN7528_GSW_RST>;
+			reset-names = "fe", "pdma", "qdma", "switch";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gdm1: mac@1 {
+				compatible = "econet,eth-mac";
+				reg = <1>;
+				phy-mode = "internal";
+
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+					pause;
+				};
+			};
+		};
+
+		switch: switch@1fb58000 {
+			compatible = "airoha,en751627-switch", "airoha,en7528-switch";
+			reg = <0x1fb58000 0x8000>;
+
+			status = "disabled";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+			dsa,member = <0 0>;
 
-&switch {
-	compatible = "airoha,en751627-switch", "airoha,en7528-switch";
+			mdio {
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+		};
+	};
 };
diff --git a/arch/mips/mach-econet/en7528/init.c b/arch/mips/mach-econet/en7528/init.c
--- a/arch/mips/mach-econet/en7528/init.c
+++ b/arch/mips/mach-econet/en7528/init.c
@@ -9,10 +9,12 @@
 #include <asm/global_data.h>
 #include <asm/system.h>
 #include <linux/bitops.h>
+#include <linux/bitfield.h>
 #include <linux/errno.h>
 #include <linux/io.h>
 #include <linux/sizes.h>
 #include <soc/airoha/pkgids.h>
+#include <time.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -31,17 +33,13 @@ int dram_init(void)
 	 * the vendor GET_DRAM_SIZE() contract, which returns dram_size << 4.
 	 */
 	value = __raw_readl((void __iomem *)EN7528_SYS_GLOBAL_PARM);
-	if (IS_ENABLED(CONFIG_TARGET_EN751627))
-		size_units = value & GENMASK(11, 0);
-	else
-		size_units = (value >> 20) & GENMASK(11, 0);
-
+	size_units = (value >> 20) & GENMASK(11, 0);
 	size_mb = size_units << 4;
 
 	debug("EN751627/EN7528 DRAM: global-param=%08x units=%u size=%u MiB\n",
 	      value, size_units, size_mb);
 
-	if (size_mb < 32 || size_mb > 512) {
+	if (size_mb < 32 || size_mb > 1024) {
 		printf("Invalid EN751627/EN7528 calibrated DRAM size: %u MiB\n",
 		       size_mb);
 		return -EINVAL;
@@ -77,6 +75,17 @@ int ft_system_setup(void *blob, struct bd_info *bd)
 }
 #endif
 
+#ifdef CONFIG_TARGET_EN751627
+ulong notrace get_tbclk(void)
+{
+	u32 value = __raw_readl((void __iomem *)EN7528_SYS_GLOBAL_PARM);
+	u32 units = FIELD_GET(GENMASK(19, 12), value);
+
+	/* DRAMC stores CPU frequency in units of 4 MHz; Count runs at /2. */
+	return units ? (ulong)units * 2000000 : CONFIG_SYS_MIPS_TIMER_FREQ;
+}
+#endif
+
 void _machine_restart(void)
 {
 	__raw_writel(0x80000000, (void __iomem *)EN7528_RESET_CONTROL);
diff --git a/configs/en751627_reference_defconfig b/configs/en751627_reference_defconfig
--- a/configs/en751627_reference_defconfig
+++ b/configs/en751627_reference_defconfig
@@ -2,22 +2,23 @@ CONFIG_MIPS=y
 CONFIG_SKIP_LOWLEVEL_INIT=y
 CONFIG_NR_DRAM_BANKS=1
 CONFIG_ENV_SIZE=0x1000
+CONFIG_DM_GPIO=y
 CONFIG_DEFAULT_DEVICE_TREE="econet,en751627-reference"
 CONFIG_SYS_BOOTM_LEN=0x08000000
 CONFIG_SYS_LOAD_ADDR=0x82000000
-CONFIG_DEBUG_UART_BASE=0xbfbf0000
-CONFIG_DEBUG_UART_CLOCK=1843200
 CONFIG_ARCH_ECONET=y
 CONFIG_TARGET_EN751627=y
 CONFIG_SYS_MIPS_TIMER_FREQ=200000000
+CONFIG_MIPS_CACHE_SETUP=y
+CONFIG_MIPS_CACHE_DISABLE=y
 CONFIG_MIPS_RELOCATION_TABLE_SIZE=0xc000
 CONFIG_RESTORE_EXCEPTION_VECTOR_BASE=y
 CONFIG_MIPS_BOOT_FDT=y
-CONFIG_DEBUG_UART=y
 CONFIG_FIT=y
 CONFIG_FIT_VERBOSE=y
+CONFIG_BOOTSTD=y
+# CONFIG_BOOTMETH_VBE is not set
 CONFIG_BOOTDELAY=3
-CONFIG_OF_SYSTEM_SETUP=y
 CONFIG_OF_STDOUT_VIA_ALIAS=y
 CONFIG_DEFAULT_FDT_FILE="econet,en751627-reference.dtb"
 CONFIG_SYS_PBSIZE=1049
@@ -25,12 +26,13 @@ CONFIG_SYS_CONSOLE_IS_IN_ENV=y
 CONFIG_DISPLAY_CPUINFO=y
 # CONFIG_DISPLAY_BOARDINFO is not set
 CONFIG_HUSH_PARSER=y
-CONFIG_SYS_PROMPT="EN751627 U-Boot> "
+CONFIG_SYS_PROMPT="U-Boot> "
 CONFIG_SYS_MAXARGS=16
 CONFIG_CMD_BOOTZ=y
 CONFIG_CMD_BOOTMENU=y
 CONFIG_CMD_MEMINFO=y
 CONFIG_CMD_BIND=y
+CONFIG_CMD_GPIO=y
 CONFIG_CMD_MTD=y
 CONFIG_CMD_DHCP=y
 CONFIG_CMD_MII=y
@@ -39,23 +41,33 @@ CONFIG_CMD_MTDPARTS=y
 CONFIG_CMD_LOG=y
 CONFIG_ENV_OVERWRITE=y
 CONFIG_ENV_RELOC_GD_ENV_ADDR=y
+CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
+CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="defenvs/en7528-reference_env"
 CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
 CONFIG_NET_RANDOM_ETHADDR=y
 CONFIG_SYS_RX_ETH_BUFFER=16
+CONFIG_BUTTON=y
+CONFIG_BUTTON_GPIO=y
+CONFIG_DMA=y
+CONFIG_LED=y
+CONFIG_LED_BOOT=y
+CONFIG_LED_BLINK=y
+CONFIG_LED_SW_BLINK=y
+CONFIG_LED_GPIO=y
 CONFIG_MTD=y
 CONFIG_DM_MTD=y
 CONFIG_MTD_SPI_NAND=y
 CONFIG_DM_SPI_FLASH=y
+CONFIG_SPI_FLASH_EON=y
 CONFIG_SPI_FLASH_WINBOND=y
 CONFIG_SPI_FLASH_XMC=y
 CONFIG_SPI_FLASH_MTD=y
 CONFIG_PHY=y
-CONFIG_DEBUG_UART_SHIFT=2
-CONFIG_DEBUG_UART_SKIP_INIT=y
 CONFIG_SYS_NS16550=y
 CONFIG_SYS_NS16550_MEM32=y
 CONFIG_SPI=y
 CONFIG_DM_SPI=y
 CONFIG_AIROHA_SNFI_SPI=y
 CONFIG_LZMA=y
+CONFIG_LZO=y
 CONFIG_HEXDUMP=y

