diff --git a/defenvs/en751221_nokia_g240g-e b/defenvs/en751221_nokia_g240g-e
--- a/defenvs/en751221_nokia_g240g-e
+++ b/defenvs/en751221_nokia_g240g-e
@@ -5,12 +5,12 @@ bootled_pwr=green:status-6
 
 bootconf=config-1
 bootfile=openwrt-airoha-en751221-nokia_g240g-e-initramfs-kernel.bin
-bootloaderfile=openwrt-airoha-en751221-nokia_g240g-e-uboot-bootloader.bin
+bootloaderfile=openwrt-airoha-en751221-nokia_g240g-e-tcboot.bin
 
 boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
-ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr
+ubi_read_openwrt=ubi read $loadaddr fit
 
-boot_openwrt=led $bootled_pwr blink 255; ( run ubi_read_openwrt || echo Install openwrt ; run boot_tftp ) && bootm $loadaddr#$bootconf ; led $bootled_pwr on
