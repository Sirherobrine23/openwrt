From 6146c26075d92547d4be1b93483f54a5d9269eb6 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 19 Nov 2026 17:37:02 -0300
Subject: [PATCH] update loadaddr to safe address and remove unnecessary
 reservations

---
 arch/arm/dts/en7523-u-boot.dtsi              | 20 --------------------
 defenvs/en7523-askey-rtf8225vw_env           | 16 ++++++++--------
 defenvs/en7523-genexis_pixly_r1_env          |  2 +-
 defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env | 14 +++++++-------
 defenvs/en7523-tplink-ex530v_v1_env          | 10 +++++-----
 defenvs/en7523-tplink-xx230v_v1_env          | 10 +++++-----
 6 files changed, 26 insertions(+), 46 deletions(-)

diff --git a/arch/arm/dts/en7523-u-boot.dtsi b/arch/arm/dts/en7523-u-boot.dtsi
--- a/arch/arm/dts/en7523-u-boot.dtsi
+++ b/arch/arm/dts/en7523-u-boot.dtsi
@@ -21,26 +21,6 @@
 			no-map;
 			reg = <0x80000000 0x40000>;
 		};
-
-		npu_binary: npu-binary@84000000 {
-			no-map;
-			reg = <0x84000000 0x00100000>;
-		};
-
-		npu_pkt: npu-pkt@84d00000 {
-			no-map;
-			reg = <0x84d00000 0x01600000>;
-		};
-
-		qdma0_buf: qdma0-buf@86400000 {
-			no-map;
-			reg = <0x86400000 0x02000000>;
-		};
-
-		qdma1_buf: qdma1-buf@88400000 {
-			no-map;
-			reg = <0x88400000 0x01000000>;
-		};
 	};
 
 	psci {
diff --git a/defenvs/en7523-askey-rtf8225vw_env b/defenvs/en7523-askey-rtf8225vw_env
--- a/defenvs/en7523-askey-rtf8225vw_env
+++ b/defenvs/en7523-askey-rtf8225vw_env
@@ -1,4 +1,4 @@
-loadaddr=0x89400000
+loadaddr=0x85000000
 ipaddr=192.168.1.1
 serverip=192.168.1.10
 bootled_pwr=blue:wan-online-8
@@ -14,20 +14,20 @@ boot_openwrt=led $bootled_pwr blink 255; run ubi_read_openwrt && bootm $loadaddr
 boot_ubi=ubi part ubi && run boot_openwrt
 
 upgrade_uboot=\
-  mw.b 0x896C0000 0xff 0x100000 && tftpboot 0x896C0000 ${bootloaderfile} && \
-  mtd erase u-boot && mtd write u-boot 0x896C0000
+  mw.b 0x85000000 0xff 0x100000 && tftpboot 0x85000000 ${bootloaderfile} && \
+  mtd erase u-boot && mtd write u-boot 0x85000000
 
 format_ubi_part=\
   ubi detach; \
-  mtd read spi-nand0 0x89400000 0x50c0000 0x040000 && \
-  mtd read spi-nand0 0x89440000 0x5100000 0x040000 && \
-  mtd read spi-nand0 0x89480000 0x6dc0000 0x240000 && \
+  mtd read spi-nand0 0x85100000 0x50c0000 0x040000 && \
+  mtd read spi-nand0 0x85140000 0x5100000 0x040000 && \
+  mtd read spi-nand0 0x85180000 0x6dc0000 0x240000 && \
   \
   mtd erase ubi && ubi part ubi && \
   ubi create ubootenv 0x40000 && \
   ubi create ubootenv2 0x40000 && \
-  ubi create art 0x400000 && ubi write 0x89480000 art 0x400000 && \
-  env import -b 0x89400000 0x040000 ethaddr asp_gpon_sn asp_gpon_pw || env import -b 0x89440000 0x040000 ethaddr asp_gpon_sn asp_gpon_pw; \
+  ubi create art 0x400000 && ubi write 0x85180000 art 0x400000 && \
+  env import -b 0x85100000 0x040000 ethaddr asp_gpon_sn asp_gpon_pw || env import -b 0x85140000 0x040000 ethaddr asp_gpon_sn asp_gpon_pw; \
   saveenv && saveenv && run upgrade_uboot
 
 bootcmd=run boot_ubi
diff --git a/defenvs/en7523-genexis_pixly_r1_env b/defenvs/en7523-genexis_pixly_r1_env
--- a/defenvs/en7523-genexis_pixly_r1_env
+++ b/defenvs/en7523-genexis_pixly_r1_env
@@ -1,4 +1,4 @@
-loadaddr=0x89400000
+loadaddr=0x85000000
 ipaddr=192.168.1.1
 serverip=192.168.1.10
 bootfile=openwrt-airoha-en7523-genexis_pixly_r1-initramfs-kernel.bin
diff --git a/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env b/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env
--- a/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env
+++ b/defenvs/en7523-mitrastar_gpt_2742gx4x5v6_env
@@ -1,4 +1,4 @@
-loadaddr=0x89400000
+loadaddr=0x85000000
 ipaddr=192.168.1.1
 serverip=192.168.1.10
 bootled_pwr=blue:wan-online-10
@@ -14,19 +14,19 @@ boot_openwrt=led $bootled_pwr blink 255; run ubi_read_openwrt && bootm $loadaddr
 boot_ubi=ubi part ubi && run boot_openwrt
 
 upgrade_uboot=\
-  mw.b 0x8964044e 0xff 0x100000 && tftpboot 0x8964044e ${bootloaderfile} && \
-  mtd erase u-boot && mtd write u-boot 0x8964044e
+  mw.b 0x85000000 0xff 0x100000 && tftpboot 0x85000000 ${bootloaderfile} && \
+  mtd erase u-boot && mtd write u-boot 0x85000000
 
 format_ubi_part=\
   ubi detach; \
-  mtd read spi-nand0 0x89400000 0xeb80000 0x240000 && \
-  mtd read spi-nand0 0x89640000 0x005f800 0x00044e && \
+  mtd read spi-nand0 0x85100000 0xeb80000 0x240000 && \
+  mtd read spi-nand0 0x85340000 0x005f800 0x00044e && \
   \
   mtd erase ubi && ubi part ubi && \
   ubi create ubootenv 0x40000 && \
   ubi create ubootenv2 0x40000 && \
-  ubi create art 0x240000 && ubi write 0x89400000 art 0x240000 && \
-  setenv ethaddr && bin2mac ethaddr 0x89640448 0x6 && \
+  ubi create art 0x240000 && ubi write 0x85100000 art 0x240000 && \
+  setenv ethaddr && bin2mac ethaddr 0x85340448 0x6 && \
   saveenv && saveenv && run upgrade_uboot
 
 bootcmd=run boot_ubi
diff --git a/defenvs/en7523-tplink-ex530v_v1_env b/defenvs/en7523-tplink-ex530v_v1_env
--- a/defenvs/en7523-tplink-ex530v_v1_env
+++ b/defenvs/en7523-tplink-ex530v_v1_env
@@ -1,4 +1,4 @@
-loadaddr=0x89400000
+loadaddr=0x85000000
 ipaddr=192.168.1.1
 serverip=192.168.1.10
 bootled_pwr=green:power
@@ -14,14 +14,14 @@ boot_openwrt=led $bootled_pwr blink 255; run ubi_read_openwrt && bootm $loadaddr
 boot_ubi=ubi part ubi && run boot_openwrt
 
 upgrade_uboot=\
-  mw.b 0x89800000 0xff 0x100000 && tftpboot 0x89800000 ${bootloaderfile} && \
-  mtd erase u-boot && mtd write u-boot 0x89800000
+  mw.b 0x85000000 0xff 0x100000 && tftpboot 0x85000000 ${bootloaderfile} && \
+  mtd erase u-boot && mtd write u-boot 0x85000000
 
 format_ubi_part=\
   ubi detach; \
-  mtd read spi-nand0 0x89400000 0xa0000 0x400000 && \
+  mtd read spi-nand0 0x85100000 0xa0000 0x400000 && \
   mtd erase ubi && ubi part ubi && \
-  ubi create art 0x400000 && ubi write 0x89400000 art 0x400000
+  ubi create art 0x400000 && ubi write 0x85100000 art 0x400000
 
 bootcmd=run boot_ubi
 bootdelay=3
diff --git a/defenvs/en7523-tplink-xx230v_v1_env b/defenvs/en7523-tplink-xx230v_v1_env
--- a/defenvs/en7523-tplink-xx230v_v1_env
+++ b/defenvs/en7523-tplink-xx230v_v1_env
@@ -1,4 +1,4 @@
-loadaddr=0x89400000
+loadaddr=0x85000000
 ipaddr=192.168.1.1
 serverip=192.168.1.10
 bootled_pwr=green:power
@@ -14,14 +14,14 @@ boot_openwrt=led $bootled_pwr blink 255; run ubi_read_openwrt && bootm $loadaddr
 boot_ubi=ubi part ubi && run boot_openwrt
 
 upgrade_uboot=\
-  mw.b 0x89600000 0xff 0x100000 && tftpboot 0x89600000 ${bootloaderfile} && \
-  mtd erase u-boot && mtd write u-boot 0x89600000
+  mw.b 0x85000000 0xff 0x100000 && tftpboot 0x85000000 ${bootloaderfile} && \
+  mtd erase u-boot && mtd write u-boot 0x85000000
 
 format_ubi_part=\
   ubi detach; \
-  mtd read spi-nand0 0x89400000 0xa0000 $art_size && \
+  mtd read spi-nand0 0x85100000 0xa0000 $art_size && \
   mtd erase ubi && ubi part ubi && \
-  ubi create art $art_size && ubi write 0x89400000 art $art_size && \
+  ubi create art $art_size && ubi write 0x85100000 art $art_size && \
   run upgrade_uboot
 
 xx230_ubi_part=setenv art_size 0x100000 && run format_ubi_part

